    def set_wheel_base_nav_pose(self, pose=None, frame='map'):
        rospy.wait_for_service('/ekf_wheel_nav_odometry/set_pose')
        try:
            pose_srv = SetPoseRequest()
            if pose is None:
                # SMOOTH position convergence: after a GPS-denied stretch the
                # odometry has drifted; snapping the EKF straight to the RTK
                # position was the second half of the takeover jump (drive-6
                # forensics: 0.5 m step right when the gate opened). Large
                # deltas converge at ~pos_slew_mps via capped per-call steps
                # (corrections run at ~10 Hz); small ones apply directly.
                tx = self.rtk_odom_msg.pose.pose.position.x
                ty = self.rtk_odom_msg.pose.pose.position.y
                cx = self.ekf_wheel_nav_odom_msg.pose.pose.position.x
                cy = self.ekf_wheel_nav_odom_msg.pose.pose.position.y
                dx, dy = tx - cx, ty - cy
                dist = math.hypot(dx, dy)
                max_step = self._pos_slew_mps * 0.1   # per call at ~10 Hz
                if dist > max(max_step, 0.10):
                    scale = max_step / dist
                    tx, ty = cx + dx * scale, cy + dy * scale
                pose_srv.pose.pose.pose.position.x = tx
                pose_srv.pose.pose.pose.position.y = ty
                pose_srv.pose.pose.pose.position.z = self.rtk_odom_msg.pose.pose.position.z
                pose_srv.pose.pose.pose.orientation.x = self.fused_msg.orientation.x
                pose_srv.pose.pose.pose.orientation.y = self.fused_msg.orientation.y
                pose_srv.pose.pose.pose.orientation.z = self.fused_msg.orientation.z
                pose_srv.pose.pose.pose.orientation.w = self.fused_msg.orientation.w
                pose_srv.pose.header.frame_id = ('odom')
            else:
                pose_srv.pose.pose.pose = pose
                pose_srv.pose.header.frame_id = frame

            pose_srv.pose.header.stamp = rospy.Time.now()

            srv = rospy.ServiceProxy('/ekf_wheel_nav_odometry/set_pose', SetPose)  # Connect to the service
            response = srv(pose_srv)
            # print("Response: ", response)

        except rospy.ServiceException as e:
            rospy.logerr("Service /ekf_wheel_nav_odometry/set_pose call failed: %s" % e)


    def offset_navheading_imu(self, msg):
        """
        Compute offset of the navheading with the imu heading. Do only if the rtk navheading is usable.
        :param msg: rtk navheading msg
        :return:
        """
        delay = abs(int(str((msg.header.stamp - self.imu_msg.header.stamp) / 1000000)))  # in ms
        self.imu_delay = delay
        rtk_error_z = msg.orientation_covariance[8]
        self.rtk_err = rtk_error_z
        if delay <= 6 and self.fix_usable and self.heading_fix_usable:

            # HEALTHY-BAND acceptance (2026-07-06, user field data): a
            # SUSPICIOUSLY TIGHT yaw variance (< ~0.001; UI 'e' readout
            # below ~1.0) comes from degenerate solutions near the roofed
            # area and carries a WRONG heading with confident covariance —
            # the robot drove mis-oriented for minutes while ONLY those
            # samples passed the old 'upper bound only' gate (<= 0.0008),
            # which simultaneously REJECTED the healthy ~0.0011 (UI 1.1).
            # This restores the lower bound that was removed earlier and
            # raises the cap. Both ends are params for field tuning.
            if rtk_error_z < self._heading_var_min:
                rospy.logwarn_throttle(
                    30.0, '[navheading] suspiciously TIGHT yaw var %.5f '
                    '(< %.5f) — degenerate solution, heading REJECTED',
                    rtk_error_z, self._heading_var_min)
            if self._heading_var_min <= rtk_error_z <= self._heading_var_max:
                self.nav_last_fused_time = rospy.Time.now()
                (imu_roll, imu_pitch, imu1_yaw) = euler_from_quaternion([self.imu_msg.orientation.x,
                                                                        self.imu_msg.orientation.y,
                                                                        self.imu_msg.orientation.z,
                                                                        self.imu_msg.orientation.w])
                (rtk_roll, rtk_pitch, rtk_yaw) = euler_from_quaternion([msg.orientation.x,
                                                                        msg.orientation.y,
                                                                        msg.orientation.z,
                                                                        msg.orientation.w])
                if rtk_yaw < 0:
                    rtk_yaw += 2 * math.pi
                if imu1_yaw < 0:
                    imu1_yaw += 2 * math.pi
                target = (rtk_yaw - imu1_yaw) + 1.5708  # 90 degrees
                # SMOOTH re-anchor: forensics (drive 6) showed the anchor snapped
                # the heading by 12 deg within 2 s of RTK acquiring — the visible
                # 'jump when GPS turns green'. Large corrections now SLEW at
                # ~heading_slew_dps toward the GNSS target instead of stepping;
                # small ones (< ~2 deg) apply directly. First-ever anchor (init)
                # still snaps (nothing to jump FROM).
                err = math.atan2(math.sin(target - self.diff_yaw),
                                 math.cos(target - self.diff_yaw))
                max_step = math.radians(self._heading_slew_dps) * 0.1  # called ~10 Hz w/ heading fixes
                if self.init or abs(err) <= math.radians(2.0):
                    self.diff_yaw = target
                else:
                    self.diff_yaw += max(-max_step, min(max_step, err))
                self.init = False
                # GNSS re-anchors heading inside odom->base -> drop any map->odom
                # yaw correction or the angle would be applied twice.
                self.map_odom_yaw = 0.0
                # Acquisition gate flag set HERE — only when the dual-antenna
                # heading anchor has ACTUALLY been applied (drive 5: a single
                # good-covariance heading sample set the old flag while diff_yaw
                # was never re-anchored -> corrections ran with a gyro-drifted
                # orientation -> brief jump / wrong orientation with one GPS).
                self._heading_good_after_acq = True

    def callback_set_heading(self, msg):
        """Anchor the ABSOLUTE heading from an external map-frame yaw (radians). The IMU is
        relative-only (no magnetometer), so the absolute offset is supplied externally. This
        mirrors the GNSS path above (fused = imu_yaw + diff_yaw): set diff_yaw = wanted - imu_yaw
        so the fused heading equals the supplied map yaw NOW and then tracks correctly via the
        relative IMU as the robot turns. NO +90 deg here: the input is already a MAP yaw (the
        dock / rtabmap orientation in the map frame), unlike rtk_yaw which is the RTK heading.
        Used when there is no satellite heading (dock, later rtabmap); GNSS overrides via
        offset_navheading_imu whenever a good RTK heading is present, so it keeps priority."""
        wanted = msg.data
        imu_yaw = self.imu_yaw
        if imu_yaw < 0:
            imu_yaw += 2 * math.pi
        if wanted < 0:
            wanted += 2 * math.pi
        self.diff_yaw = wanted - imu_yaw
        self.init = False
        # heading re-anchored inside odom->base -> reset the map->odom yaw
        # correction (same double-count rule as the GNSS path).
        self.map_odom_yaw = 0.0
        rospy.loginfo("[navi_tf] heading anchored to external map yaw %.3f rad (diff_yaw=%.3f)"
                      % (msg.data, self.diff_yaw))

    def print_info(self):

        # print("fused: {:.3f}s fix_usable: {:1} heading_usable: {:1} rtk_err: {:.5f} imu_delay: {:2} diff_yaw: {:.5f}"
        #       .format(fused_nav_time, self.fix_usable, self.heading_fix_usable, self.rtk_err, self.imu_delay, self.diff_yaw))
        rospy.logdebug("fused fix: {:.3f}s fused nav: {:.3f}s fix_usable: {:1} heading_usable: {:1} rtk_err: {:.5f}"
