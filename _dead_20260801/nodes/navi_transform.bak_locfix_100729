    def loop3sec(self, event=None):
        # NOTE the misleading name: this runs at 10 Hz (registered with
        # Duration(1/10) since the first commit) and that IS the field-validated
        # behavior — the pose stays pinned to RTK whenever position is usable.
        # The "3" gate below means 3 consecutive usable GNSS FIX MESSAGES
        # (history appended per message in callback_gnss_fix), not 3 seconds.
        # Do not "fix" the rate without re-validating GPS-anchored driving.
        # Phase-2 decouple: gate the live RTK position correction on POSITION
        # usability (not the heading-coupled fix_usable). set_wheel_base_nav_pose
        # uses RTK position + IMU-fused heading, so this is safe and keeps the
        # pose anchored to RTK whenever position is good (~86% vs ~31% before),
        # cutting dead-reckoning drift and the map "corrections" it caused.
        # _gps_stable(): additionally require the fix to be continuously usable
        # for the acquisition-hysteresis window — the FIRST corrections after a
        # (re)acquisition used navsat output whose datum/heading was still wrong
        # and threw the pose metres aside (observed 2026-07-04, both drives).
        # wrote_anchor: did this tick write a continuous same-time anchor? The
        # True->False edge (ownership lost) records the loss state and the
        # False->True edge (ownership resumed) triggers the drift report; the
        # single reconciliation call at the end keeps the edge detection clean.
        wrote_anchor = False
        if sum(self.position_fix_usable_history) == 3 and self._gps_stable():
            # Corrections may ONLY use a FRESH navsat output. rtk_odom_msg
            # (/odometry/gps) is ZEROS before navsat ever publishes and STALE
            # right after a (re)launch — set_pose from it teleported the robot
            # to ~map origin at every first GPS acquisition (the 'brief jump to
            # a completely different position', drives 1-3, 2026-07-04).
            rtk_fresh = (rospy.get_time() - self._rtk_odom_rx_t) < self._rtk_fresh_s
            if self.launch_navsat is not None:
                if self._heading_ok() and rtk_fresh:
                    self.fix_last_fused_time = rospy.Time.now()
                    # rewind buffer FIRST: pair the GPS pose with the never-
                    # set_pose'd wheel-EKF pose (+ wheel & nav yaw for delta
                    # rotation) at correction time. Appending before anchoring
                    # is intentional — the continuous anchor selects an entry at
                    # (now - anchor_lag_s), never THIS tick, so this append only
                    # feeds FUTURE ticks; the rewind path also consumes it.
                    self._pose_buffer.append((
                        rospy.get_time(),
                        (self.rtk_odom_msg.pose.pose.position.x,
                         self.rtk_odom_msg.pose.pose.position.y),
                        (self.ekf_wheel_odom_msg.pose.pose.position.x,
                         self.ekf_wheel_odom_msg.pose.pose.position.y),
                        euler_from_quaternion([
                            self.ekf_wheel_odom_msg.pose.pose.orientation.x,
                            self.ekf_wheel_odom_msg.pose.pose.orientation.y,
                            self.ekf_wheel_odom_msg.pose.pose.orientation.z,
                            self.ekf_wheel_odom_msg.pose.pose.orientation.w])[2],
                        euler_from_quaternion([
                            self.ekf_wheel_nav_odom_msg.pose.pose.orientation.x,
                            self.ekf_wheel_nav_odom_msg.pose.pose.orientation.y,
                            self.ekf_wheel_nav_odom_msg.pose.pose.orientation.z,
                            self.ekf_wheel_nav_odom_msg.pose.pose.orientation.w])[2]))
                    # CONTINUOUS SAME-TIME ANCHOR: write GPS_pose(now-lag) o
                    # wheel-delta(now-lag -> now). On the FIRST owning tick after
                    # an outage, emit the accumulated-error drift report. Falls
                    # back to the legacy rtk(NOW) correction while the buffer is
                    # not yet lag-deep (bootstrap / just-acquired GPS).
                    resumed = not self._anchor_owned
                    # FIX1 (telemfix): on the resume tick, snapshot the live
                    # nav-EKF pose AND the time-paired RTK pose BEFORE the first
                    # new correction is applied — the drift report measures the
                    # accumulated blind error against INDEPENDENT RTK truth.
                    if resumed:
                        cpos = self.ekf_wheel_nav_odom_msg.pose.pose.position
                        rpos = self.rtk_odom_msg.pose.pose.position
                        self._resume_live_pose = (cpos.x, cpos.y)
                        self._resume_rtk_pose = (rpos.x, rpos.y)
                        self._resume_rtk_fresh = (
                            (rospy.get_time() - self._rtk_odom_rx_t) < self._rtk_fresh_s)
                    if not self._apply_continuous_anchor():
                        self.set_wheel_base_nav_pose()   # bootstrap fallback
                    # drift report AFTER the anchor call (snapshot already taken
                    # pre-correction above, so the measurement is uncontaminated).
                    if resumed:
                        self._emit_drift_report()
                    wrote_anchor = True
                    # FIX3 (telemfix): anchor observability — warn (throttled)
                    # when the verified anchor has stayed frozen (not advanced)
                    # longer than ~anchor_frozen_warn_s while GPS owns the pose.
                    # A frozen anchor is CORRECT (a lying multipath tail is being
                    # rejected) but means the pose runs open-loop on the wheel
                    # EKF — the operator must be able to see it.
                    if self._anchor_last_advance_t is not None:
                        age = rospy.get_time() - self._anchor_last_advance_t
                        if age > self._anchor_frozen_warn_s:
                            rospy.logwarn_throttle(
                                10.0, "[anchor] verified anchor FROZEN %.1fs "
                                "(motion-verify failing — pose on wheel EKF)", age)
                elif not rtk_fresh:
                    # keep init_navsat's launch condition alive without moving
                    # the robot from a zero/stale gps_odom
                    self.fix_last_fused_time = rospy.Time.now()
            else:
                # navsat not launched yet: only bootstrap its launch condition
                # (init_navsat checks fused_fix_time<1); NEVER set_pose here.
                self.fix_last_fused_time = rospy.Time.now()
        # Phase 1 GO-LIVE: GPS denied -> if live bridging is enabled and a TRUSTED
        # relative source (VO/lidar, already covariance + freshness + hysteresis +
        # wheel-cross-check gated) is carrying the bridge, drive the live pose from
        # the bridge instead of drifting on wheels. On long dropouts where VO/lidar
        # are lost the bridge falls back to 'wheel' -> we skip and let the EKF
        # dead-reckon as before (bounds the risk). Wrapped so a fault here can
        # never disturb the GPS-anchored path above.
        elif self._bridge_live_enable and self._bridge.get('init') \
                and self._bridge_active in ('vo', 'licp'):
            try:
                self.set_bridge_live_pose()
            except Exception as e:
                rospy.logwarn_throttle(10.0, "[bridge_live] %s" % e)
        # Reconcile ownership edge ONCE per tick (records loss state on the
        # True->False transition for the next resume's drift report).
        self._note_ownership(wrote_anchor)
        # FIX4 (telemfix): edge-triggered loc_status on owner change (this loop
        # runs at 10 Hz and is where ownership is decided; baseline 1 Hz stays).
        self.maybe_publish_owner_edge()


    def loop30hz(self, event=None):
        self.publish_relative_wheel_odom()
        self.publish_odom_for_gps()
        self.publish_navheading_wheel_odom()
        self.publish_odom_fused()
        self.transform_odom_to_base_link()
        self.slew_map_pose()
        self.transform_map_to_odom()
        self.fused_nav_time = (int(str(rospy.Time.now())) - int(str(self.nav_last_fused_time))) / 1000000000
        self.fused_fix_time = (int(str(rospy.Time.now())) - int(str(self.fix_last_fused_time))) / 1000000000
        self.init_navsat()
        # vitulus_ui Phase 1 (Step A): shadow bridge preview. Wrapped so a bug
        # here can NEVER disturb the live odometry pipeline above.
        try:
            self.update_bridge_preview()
        except Exception as e:
            rospy.logwarn_throttle(10.0, "[bridge_preview] %s" % e)


