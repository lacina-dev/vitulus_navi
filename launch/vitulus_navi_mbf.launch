<launch>
  <arg name="map_topic" />
  <!-- Local traversability map (vitulus_traversability) as a layer of the local costmap. OFF unless the robot sets
       VITULUS_TRAVERSABILITY_NAV=true (this layer) AND the node publishing /traversability/local_costmap runs: started
       by the stack (VITULUS_TRAVERSABILITY_NODE=true, set by vitulus.startup when the package is in the workspace) OR
       by vitulus_depth_obstacles (VITULUS_TRAVERSABILITY=true). With the node off the layer would keep move_base_flex
       waiting for its first map. Also needs obstacles_engine: depth_obstacles (navi_manager.yaml, not checked here:
       with rtabmap there are no clouds, the node only publishes its neutral grid). On = 1 / true / yes / on (any
       case, spaces ignored); anything else (unset, empty, false, a typo) = off = parameters exactly as before.
       README "Traversability layer". -->
  <arg name="traversability_nav" default="$(optenv VITULUS_TRAVERSABILITY_NAV false)"/>
  <arg name="traversability_node" default="$(optenv VITULUS_TRAVERSABILITY false)"/>
  <arg name="traversability_stack_node" default="$(optenv VITULUS_TRAVERSABILITY_NODE false)"/>

<!-- work around for footprint reload -->
  <rosparam command="delete" ns="move_base_flex" />

<!--  </node>-->

  <node name="move_base_flex" pkg="mbf_costmap_nav" type="mbf_costmap_nav" respawn="false" output="log">-->
      <rosparam file="$(find vitulus_navi)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
      <rosparam file="$(find vitulus_navi)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
      <rosparam file="$(find vitulus_navi)/config/local_costmap_params.yaml" command="load" />
      <!-- traversability switch: after local_costmap_params.yaml (replaces local_costmap/plugins) and inside this
           node, so it survives the "rosparam delete move_base_flex" above (N5) -->
      <rosparam if="$(eval str(arg('traversability_nav')).strip().lower() in ('1', 'true', 'yes', 'on') and (str(arg('traversability_node')).strip().lower() in ('1', 'true', 'yes', 'on') or str(arg('traversability_stack_node')).strip().lower() in ('1', 'true', 'yes', 'on')))"
                file="$(find vitulus_navi)/config/local_costmap_traversability.yaml" command="load" />
      <rosparam file="$(find vitulus_navi)/config/global_costmap_params.yaml" command="load" />
      <rosparam file="$(find vitulus_navi)/config/planners.yaml" command="load"/>
      <rosparam file="$(find vitulus_navi)/config/controllers.yaml" command="load"/>
      <rosparam file="$(find vitulus_navi)/config/base_teb_local_planner_params.yaml" command="load" />
      <rosparam file="$(find vitulus_navi)/config/base_local_planner_params.yaml" command="load" />
      <rosparam file="$(find vitulus_navi)/config/dwa_local_planner_params.yaml" command="load" />
      <rosparam file="$(find vitulus_navi)/config/graceful_controller_params.yaml" command="load" />
      <rosparam file="$(find vitulus_navi)/config/neo_local_planner_params.yaml" command="load" />
      <rosparam file="$(find vitulus_navi)/config/global_planner_params.yaml" command="load" />
      <rosparam file="$(find vitulus_navi)/config/recovery_behavior.yaml" command="load" />

      <param name="base_global_planner" value="global_planner/GlobalPlanner" />
      <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
      <param name="cmd_vel_ignored_tolerance" value="-1" />

      <remap from="cmd_vel" to="/cmd_vel"/>
      <remap from="odom" to="/odometry/odom"/>
      <remap from="map" to="$(arg map_topic)"/>

  </node>
</launch>