#!/usr/bin/env python3
"""gloc_server — 2D-lidar global localization scorer (likelihood field / EDT).

Scores pose hypotheses (free-space positions x yaw angles) of the CURRENT
/rtabmap/grid_map against ONE live /scan: score = mean distance of scan
endpoints to the nearest occupied cell (distance transform). Coarse but fast
(~0.5 s for ~100k hypotheses on the NUC) and unambiguity-aware: it reports the
score margin to the best runner-up outside `ambiguity_radius`. rtabmap's lidar
proximity (LocalRadius=8) does the precise refinement, so coarse is enough.

Passive by default — computing NEVER moves the robot. The result is only
applied to localization via the explicit /gloc/apply trigger (or ~auto_apply),
and only when the margin clears ~apply_min_margin. Apply = publish the pose to
/rtabmap/initialpose (same mechanism as the dock seed; the rtabmap bridge then
carries it to the live pose when GPS is denied).

Interfaces
  in   /rtabmap/grid_map   nav_msgs/OccupancyGrid (latched by rtabmap)
  in   /scan               sensor_msgs/LaserScan  (grabbed on demand)
  trig /gloc/compute       std_msgs/String  ("" or "with_heatmap")
  trig /gloc/localize      std_srvs/Trigger (returns JSON in message)
  trig /gloc/apply         std_msgs/String  ("" = last result; "force" bypasses margin gate)
  out  /gloc/result        std_msgs/String  (latched JSON, see build_result())
  out  /gloc/heatmap       sensor_msgs/CompressedImage (latched PNG)
  out  /gloc/status        std_msgs/String  (latched: idle/computing/error text)
"""
import io
import json
import math
import threading
import time

import numpy as np
from scipy import ndimage

import rospy
import tf2_ros
from nav_msgs.msg import OccupancyGrid, Odometry
from sensor_msgs.msg import LaserScan, CompressedImage
from geometry_msgs.msg import PoseStamped, PoseWithCovarianceStamped
from std_msgs.msg import Bool
from std_msgs.msg import Int8
from std_msgs.msg import String
from std_srvs.srv import Trigger, TriggerResponse
from tf.transformations import quaternion_from_euler, euler_from_quaternion


class GlocServer(object):
    def __init__(self):
        self.pos_stride_m = rospy.get_param('~pos_stride_m', 0.30)
        self.angle_step_deg = rospy.get_param('~angle_step_deg', 5.0)
        self.n_rays = int(rospy.get_param('~n_rays', 120))
        self.dist_cap_m = rospy.get_param('~dist_cap_m', 1.0)
        self.occ_thresh = int(rospy.get_param('~occ_thresh', 65))
        self.ambiguity_radius = rospy.get_param('~ambiguity_radius_m', 1.5)
        # Lawn test 2026-07-04: a mirrored (~180deg-flipped) hypothesis reached
        # margin 95% on open grass -> 50% was not safe there. 100% + the IMU-yaw
        # sanity check below killed every observed false-confident case.
        self.apply_min_margin = rospy.get_param('~apply_min_margin', 1.0)  # 100 %
        # SOFT-MAP RELOCK GUARD (2026-07-12, forensic: garage session shove).
        # Log evidence (gloc_server-34.log, 17:1x): the pose was shoved by an
        # AUTO-RELOCK APPLIED on the soft garage map — 17:18:14 relock to
        # (0.83, -5.67, 260deg) margin 112% delta 1.47m, jumping ~1.5 m into a
        # -6 m aisle alias that the 100% margin gate had (correctly) rejected 8x
        # at margin 45-75% until one sample crept to 112%. A relock that MOVES
        # the pose far (delta_m) is high-consequence: on a soft/aliased map the
        # runner-up margin barely clearing 100% is not enough proof. So a relock
        # whose delta exceeds ~relock_big_delta_m must clear a HIGHER margin
        # (~relock_big_delta_margin) — small-delta relocks (confirming roughly
        # the current pose) keep the normal gate. This does NOT slow legitimate
        # recovery from a genuine large offset (that produces a decisive margin,
        # like the 280% relock at 17:03); it only blocks a MARGINAL far jump.
        self.relock_big_delta_m = float(rospy.get_param('~relock_big_delta_m', 0.6))
        self.relock_big_delta_margin = float(rospy.get_param('~relock_big_delta_margin', 2.0))  # 200 %
        # The gyro tracks rotation even when the robot is carried (kidnap), so the
        # current heading stays roughly valid when position is lost — a candidate
        # whose yaw disagrees wildly is a mirror alias, not the robot.
        self.apply_max_yaw_dev = math.radians(
            rospy.get_param('~apply_max_yaw_dev_deg', 45.0))
        self.scan_topic = rospy.get_param('~scan_topic', '/scan')
        self.auto_apply = bool(rospy.get_param('~auto_apply', False))
        self.map_frame = rospy.get_param('~map_frame', 'map')
        self.base_frame = rospy.get_param('~base_frame', 'base_link')
        # apply covariance: coarse hypothesis -> looser than the dock seed
        pos_std = rospy.get_param('~apply_pos_std', 0.30)
        yaw_std = rospy.get_param('~apply_yaw_std', 0.10)
        self._apply_cov = [0.0] * 36
        self._apply_cov[0] = self._apply_cov[7] = pos_std ** 2
        self._apply_cov[35] = yaw_std ** 2

        # ---- EDT TRACKER (POSE_DATUM_PLAN phase 5 / MAPPING_ARCHITECTURE
        # plan: replaces rtabmap in the pose path): continuous LOCAL
        # scan-to-EDT alignment (Gauss-Newton over x, y, yaw) of the live
        # scan against the map, publishing map-frame pose corrections to
        # /nav_tf/set_map_pose_tracker (WP2 source-tagged; navi_transform's
        # arbiter ranks dock > tracker > rtabmap > legacy) — the same
        # interface the rtabmap dock bridge uses, self-gated to GPS-denied
        # stretches (roofed area) where the
        # lidar has structure and GPS has nothing.
        self.track_enable = bool(rospy.get_param('~track_enable', True))
        # CORRECTNESS-FIRST (2026-07-12, field verdict "radsi at poza cuka a
        # neni to hladke — naimplementuj to tak, aby to fungovalo"): priority
        # flips from SMOOTH to CONTINUOUS AGGRESSIVE correction. Rate 1->5 Hz so
        # the pose is pulled to the map every 0.2 s (GN over ~140 pts is cheap;
        # if a tick exceeds ~100 ms in the log, back this off to 3). EMA is OFF
        # by default (~track_ema_alpha 1.0) and small corrections publish
        # immediately (no 2-tick persistence) — the tracker twitches but never
        # lets an offset build.
        self.track_rate_hz = float(rospy.get_param('~track_rate_hz', 5.0))
        self.track_max_corr_m = float(rospy.get_param('~track_max_corr_m', 0.7))
        self.track_max_corr_yaw_deg = float(rospy.get_param('~track_max_corr_yaw_deg', 6.0))
        # SMOOTH (2026-07-12): field feedback — pose "skips between solutions it
        # considers good" (aliasing between near-equal EDT minima). Bag
        # maploc_test_2026-07-12: per-tick corr median 0.03 m, p90 0.08 m, applied
        # 87% of 1 Hz ticks (only 13% <0.02 m aligned), yaw p90 2.7deg — a
        # non-converging cm jitter, NOT drift. Output stabilisation: (1) raise the
        # publish deadband 0.02->0.04 m (yaw 0.2->0.4 deg) so sub-4 cm ping-pong is
        # dropped; (2) EMA the alignment TARGET (alpha 0.4) so a single aliased
        # tick cannot yank the published pose; (3) only publish once the smoothed
        # correction has PERSISTED in a stable direction for >= N ticks — real
        # drift holds a direction, ping-pong reverses. navi_transform additionally
        # slews the application, so the combined effect is a smooth few-second
        # convergence with no visible snapping.
        # deadband back to 0.02 m / 0.2 deg (2026-07-12): drop only genuine
        # sub-2 cm ping-pong; every real correction publishes.
        self.track_min_corr_m = float(rospy.get_param('~track_min_corr_m', 0.02))
        self.track_min_corr_yaw_deg = float(rospy.get_param('~track_min_corr_yaw_deg', 0.2))
        # EMA smoothing of the alignment target pose (x, y, yaw). alpha = weight of
        # the NEW measurement. DEFAULT 1.0 (2026-07-12) = EMA OFF: the published
        # target IS the live measurement, no lag. Kept as a param for rollback
        # (lower alpha re-enables smoothing).
        self.track_ema_alpha = float(rospy.get_param('~track_ema_alpha', 1.0))
        self._ema_pose = None          # smoothed (x, y, yaw) target, None until 1st
        # persistence gate: publish only after the smoothed correction has pointed
        # the same way (spread < deg) for >= N consecutive above-deadband ticks.
        # DEFAULT 1 (2026-07-12) = gate OFF: a single above-deadband tick
        # publishes. Correctness-first — small corrections apply immediately, the
        # pose may twitch but never dead-reckons. (>=2 re-enables persistence.)
        self.track_persist_n = int(rospy.get_param('~track_persist_n', 1))
        self.track_persist_deg = float(rospy.get_param('~track_persist_deg', 60.0))
        self._persist_dirs = []        # recent smoothed-corr directions (rad)
        self.track_max_rms_m = float(rospy.get_param('~track_max_rms_m', 0.20))
        self.track_min_points = int(rospy.get_param('~track_min_points', 60))
        self.track_max_iter = int(rospy.get_param('~track_max_iter', 8))
        # degeneracy gate: weakest position eigendirection must carry at
        # least this fraction of the point count (a single hedge/wall line
        # constrains only ACROSS itself — sliding along stays free)
        self.track_min_eig_frac = float(rospy.get_param('~track_min_eig_frac', 0.05))
        # 2026-07-11: rtabmap is OUT of the pose path (loc_status.rtabmap_confident
        # is observability-only, stays false). Deferring to it is dead logic, so
        # default OFF. Flag kept for rollback (set True to re-instate the defer).
        self.track_defer_to_rtabmap = bool(rospy.get_param('~track_defer_to_rtabmap', False))
        # BIG-CORR RECOVERY (2026-07-11): with the tracker OWNING the pose while
        # driving blind (gps_good=0), per-tick drift is ~cm and corr cap 0.7 m is
        # fine. But after a LONG blind stretch the accumulated offset can exceed
        # the cap (seen 0.81 m 2026-07-10) — then every tick is corr_too_big and
        # the tracker rejects FOREVER (deadlock), never converging back. Recovery:
        # if corr_too_big persists > track_bigcorr_recover_s AND the match is
        # otherwise healthy (rms good, eig healthy), apply the correction SLEWED
        # in steps (<= track_bigcorr_step_m per tick toward the target) instead of
        # rejecting — walks the pose back in bounded increments, logged.
        self.track_bigcorr_recover_s = float(rospy.get_param('~track_bigcorr_recover_s', 20.0))
        self.track_bigcorr_step_m = float(rospy.get_param('~track_bigcorr_step_m', 0.30))
        self.track_bigcorr_step_yaw_deg = float(rospy.get_param('~track_bigcorr_step_yaw_deg', 3.0))
        # CONSISTENCY GATE (2026-07-12 review finding 1): an aliased row-lock
        # (scan snapping to the wrong parallel structure line) produces an
        # over-cap correction whose DIRECTION jitters between ticks and whose
        # MAGNITUDE fluctuates; a real accumulated blind-drive offset holds both
        # steady. Before allowing any recovery slew, require the correction
        # direction atan2(dy,dx) to be stable (circular spread < consist_deg)
        # across N consecutive corr_too_big ticks AND the magnitude to not swing
        # wildly (max/min < consist_ratio). The buffer is reset whenever the
        # gate fails, on corr_ok, or on gps_owns.
        self.track_bigcorr_consist_n = int(rospy.get_param('~track_bigcorr_consist_n', 3))
        self.track_bigcorr_consist_deg = float(rospy.get_param('~track_bigcorr_consist_deg', 30.0))
        self.track_bigcorr_consist_ratio = float(rospy.get_param('~track_bigcorr_consist_ratio', 2.0))
        self._bigcorr_dirs = []        # recent corr directions (rad) for spread
        self._bigcorr_mags = []        # recent corr magnitudes (m) for ratio
        # streak / count state for the recovery path + status observability (2c)
        self._bigcorr_since = None     # wall time corr_too_big started (None = not)
        self._applied_count = 0        # total corrections published this session
        self._reject_reason = None     # last non-ok state string
        self._reject_streak = 0        # consecutive ticks with the same reject reason

        # AUTO-RELOCALIZATION (2026-07-12, field report: after smoothing the
        # tracker stabilised but eventually LOST SYNC with the map and NEVER
        # re-found — unacceptable). The tracker's reject paths (poor_match when
        # rms>track_max_rms_m, degenerate when eig collapses, or corr_too_big
        # that the big-corr recovery can NOT catch because recovery itself needs
        # rms_ok+eig_ok) all just `return` — once lost far off the map the local
        # GN alignment can no longer pull back and rejects FOREVER. Recovery: when
        # GPS is denied AND the tracker has been rejecting continuously for
        # >track_lost_after_s, run the EXISTING global kidnap scorer (compute())
        # against the current site_map + a fresh scan; if the margin gate passes
        # AND the found yaw is sane vs the current heading (gyro stays valid when
        # only position is lost), publish the found pose to
        # /nav_tf/set_map_pose_tracker — its distance from the drifted-wrong pose
        # is >0.6 m so navi_transform SNAPS (instant re-lock). Rate-limited so a
        # persistently-hard spot does not thrash. The scorer is synchronous
        # (~0.5-1 s); it runs INSIDE the tracker tick thread (skipping the normal
        # tick that cycle) — fine at 1 Hz.
        self.relock_enable = bool(rospy.get_param('~relock_enable', True))
        self.track_lost_after_s = float(rospy.get_param('~track_lost_after_s', 15.0))
        self.relock_min_interval_s = float(rospy.get_param('~relock_min_interval_s', 30.0))
        # reject states that count as "lost" (drift/aliasing far off the map).
        # 'no_scan'/'no_tf'/'few_rays'/'few_points_in_map'/'no_map' are sensor/
        # bootstrap gaps, NOT a localization loss — excluded so a momentary scan
        # dropout can not trigger a global relock.
        self._lost_states = ('poor_match', 'degenerate', 'corr_too_big')
        self._lost_since = None        # wall time the lost-streak started (None = healthy)
        self._last_relock_t = 0.0      # wall time of the last relock attempt

        # ---- RASTER-AWARE RMS BASELINE + RELOCK ABSOLUTE-QUALITY GATE
        # (2026-07-19, FIELD INCIDENT: the served raster switched to the DIRECT
        # mapper's product — sparse 2D log-odds walls, ~3x thinner than the old
        # BAND rasters. On it: (a) standstill track_align rms 0.14-0.24 (vs
        # 0.03-0.05 on band) EXCEEDED the hardcoded track_max_rms_m=0.20 ->
        # false poor_match -> LOST -> AUTO-RELOCK; (b) the relock trusted the
        # RELATIVE margin, which INFLATES on sparse rasters (every wrong
        # hypothesis is equally terrible so the runner-up gap looks huge — 337%);
        # (c) a 4.68 m big-delta apply had no absolute-quality or external
        # corroboration check -> the pose teleported in the field. THREE gates:
        #
        # (1) SELF-CALIBRATING BASELINE: while a TRUSTED anchor holds the pose
        #     (gps_good OR docked) the tracker still runs its align every tick;
        #     capture that rms as the raster's expected good-match scale
        #     (EMA'd). The poor_match/lost threshold becomes
        #     max(track_max_rms_m, baseline * track_lost_rms_factor) — scales up
        #     on a sparse raster, but never DROPS below the old absolute floor
        #     so band rasters (baseline ~0.04 -> 0.10 < 0.20) are byte-identical.
        # (2) RELOCK ABSOLUTE-QUALITY GATE: an auto-relock hypothesis may be
        #     APPLIED only if its OWN align rms is below baseline *
        #     relock_abs_rms_factor (fallback: relock_abs_rms_floor_m when no
        #     baseline yet). Relative margin alone NEVER suffices.
        # (3) BIG-DELTA CORROBORATION: a relock that MOVES the pose >
        #     relock_big_delta_m needs external corroboration (docked OR
        #     gps_good) — the auto path can not teleport far on lidar alone.
        #     Without it the hypothesis is PUBLISHED to track_status
        #     (observability) and logged loudly, but NOT applied. The manual
        #     /gloc/apply path (operator-triggered) is unaffected.
        self.track_lost_rms_factor = float(rospy.get_param('~track_lost_rms_factor', 2.5))
        self.track_baseline_alpha = float(rospy.get_param('~track_baseline_alpha', 0.15))
        self.relock_abs_rms_factor = float(rospy.get_param('~relock_abs_rms_factor', 1.5))
        # absolute-quality fallback when no trusted baseline has been measured on
        # this raster yet (e.g. woke up under-roof, never docked/GPS this session)
        self.relock_abs_rms_floor_m = float(rospy.get_param('~relock_abs_rms_floor_m', 0.30))
        self.relock_bigdelta_require_corrob = bool(
            rospy.get_param('~relock_bigdelta_require_corroboration', True))
        self._rms_baseline = None      # measured good-match rms (None = uncalibrated)
        self._grid_key = None          # (h, w, ox, oy) — new key invalidates baseline
        self._docked = False           # /dock_smach/dock_status == 0 (corroboration)
        # ---- SCAN-OVERLAP GATE ON BASELINE CAPTURE (PROTOCOL 2026-07-19) -------
        # KNOWN FLAW (pre-protocol): the baseline EMA captured whenever a trusted
        # anchor (gps_good OR docked) held, INCLUDING when the live scan did NOT
        # overlap the mapped area (e.g. docked on a fresh map before it covers the
        # dock, or facing unmapped space) — the align rms then reflects
        # nothing-to-match (~cap) and contaminated the baseline toward ~0.9. FIX:
        # only capture the baseline when the scan actually corresponds to mapped
        # structure — overlap_frac (fraction of aligned scan points whose EDT
        # distance is below track_overlap_dist_m) must exceed track_overlap_min.
        # overlap_frac is computed in _track_align and published in track_status.
        self.track_overlap_dist_m = float(rospy.get_param(
            '~track_overlap_dist_m', 1.0))
        self.track_overlap_min = float(rospy.get_param(
            '~track_overlap_min', 0.5))
        # ---- PER-MAP BASELINE PERSISTENCE (PROTOCOL 2026-07-19) ---------------
        # After a fresh baseline stabilises over baseline_publish_after_n DOCKED
        # captures on the served raster, publish it (latched, JSON) on
        # /gloc/baseline so mapping_manager can persist it into the serving
        # site's site_config.json. On serve, mapping_manager republishes it on
        # /mapping_manager/track_baseline and we SEED self._rms_baseline from it
        # at map load — every later boot then starts calibrated instead of
        # re-learning the raster's scale from scratch.
        self.baseline_publish_after_n = int(rospy.get_param(
            '~baseline_publish_after_n', 10))
        self._baseline_dock_captures = 0   # docked captures on the current raster
        self._baseline_published_key = None  # grid_key already published to avoid spam
        self._baseline_seed = None         # seed rms from /mapping_manager/track_baseline
        self._baseline_seed_raster = None  # raster the seed belongs to ('site/raster')
        self._serving_site = None          # from /mapping_manager/status
        self._serving_raster = None
        self._last_overlap_frac = None     # last measured overlap (for baseline pub)
        # URGENT-CORR bypass (2026-07-12, prevention): the smoothing gates (2-tick
        # persistence + EMA + deadband) must not STARVE corrections during motion.
        # When the smoothed correction is large (|corr| > track_urgent_corr_m) that
        # is real drift, not near-minima jitter — bypass persistence/deadband and
        # publish immediately (EMA still applied so one aliased tick can not yank).
        self.track_urgent_corr_m = float(rospy.get_param('~track_urgent_corr_m', 0.12))
        # stale-EMA reset: if no correction was applied for >track_ema_reset_gap_s
        # the EMA target is stale (it can pull the pose toward an old alignment) —
        # drop it so the next applied tick re-seeds from the live measurement.
        self.track_ema_reset_gap_s = float(rospy.get_param('~track_ema_reset_gap_s', 5.0))
        self._last_apply_t = None      # wall time of the last published correction

        # PROBATION-WINDOW JERK FIX (2026-07-12, live field report while driving
        # outdoors WITH usable GPS): 5f589ff made the tracker active whenever
        # fix_usable==0 OR gps_good==0 (gps_good == _gps_stable, i.e. OWNERSHIP
        # proven). That includes the PROBATION window — fix_usable=1 (raw fix
        # is back) but gps_good=0 (ownership not yet re-proven, e.g. right after
        # a reacquire or during the arbiter's confidence build-up). In that
        # window the tracker kept correcting at 5 Hz / up to 0.7 m per tick
        # while GPS was already perfectly usable outdoors -> visible jerk.
        # Field verdict: outdoors with a usable fix, GPS should simply own it,
        # probation or not. ~track_active_mode selects the gate:
        #   'fix_lost' (NEW DEFAULT) — tracker idles whenever fix_usable==1,
        #       regardless of gps_good/ownership probation. Only a genuinely
        #       unusable raw fix (denial: roof/canyon/no-sat) wakes the tracker.
        #   'not_owned' — the 5f589ff behaviour (idle only when BOTH gps_good
        #       and fix_usable are 1); kept for rollback if 'fix_lost' turns out
        #       to reopen the ~8 s dead-reckoning gap the 5f589ff fix targeted.
        self.track_active_mode = rospy.get_param('~track_active_mode', 'fix_lost')

        # ENGAGE DELAY (2026-07-12, live field report: outdoors RTK FLAPS —
        # fix_usable drops to 0 for a few seconds at a time while gps ownership
        # persists through the ~8s grace — and the tracker engaged on those brief
        # denial windows, applying borderline outdoor matches (rms ~0.21, ~0.3 m
        # corrections) and JERKING the pose even at a standstill. A momentary
        # flap is not a real denial: require fix_usable==0 CONTINUOUSLY for
        # track_engage_after_s before the tracker is allowed to engage/apply/
        # count toward auto-relock's lost timer. Disengage (re-idle) IMMEDIATELY
        # the instant the fix returns — no symmetric delay on the way back, GPS
        # should reclaim ownership at once. Under-roof (genuine, sustained
        # denial) still engages at ~engage_after_s; the pose only dead-reckons
        # a few cm in that window (gyro drift ~0.025 deg/min), acceptable.
        self.track_engage_after_s = float(rospy.get_param('~track_engage_after_s', 5.0))
        self._fix_lost_since = None    # wall time fix_usable FIRST went to 0 (None = usable)

        # STANDSTILL GATE (2026-07-12): at rest there is no drift to correct —
        # measured gyro drift is ~0.025 deg/min, so any "correction" the tracker
        # proposes while stationary is pure alignment noise, not real drift. Gate
        # on /mobile_base_controller/odom (50 Hz): once |v_lin| and |v_ang| stay
        # below the thresholds for > track_standstill_hold_s, suppress ALL normal
        # tracker corrections (state "standstill") — EXCEPT the kidnap-scale
        # AUTO-RELOCK path, which must stay available even at rest (a robot can be
        # picked up and set back down without ever registering as "moving").
        # Resumes normal correction the instant motion is seen again.
        self.track_standstill_lin_mps = float(rospy.get_param('~track_standstill_lin_mps', 0.05))
        self.track_standstill_ang_rps = float(rospy.get_param('~track_standstill_ang_rps', 0.05))
        self.track_standstill_hold_s = float(rospy.get_param('~track_standstill_hold_s', 1.0))
        self._standstill_since = None  # wall time speed FIRST dropped below thresh (None = moving)
        self._is_standstill = False    # latched once held >= track_standstill_hold_s

        self._grid = None          # (occ, free, res, ox, oy, h, w)
        self._edt = None
        self._edt_gx = None        # d(EDT)/dx [m/m], same shape as grid
        self._edt_gy = None
        self._grid_stamp = None
        self._last_result = None
        self._last_scan = None
        self._gps_good = False   # gate: TRUE only when GPS OWNS with a live fix
        self._fix_usable = False
        self._gps_stable = False
        self._rtab_conf = False
        self._lock = threading.Lock()

        self._tf_buf = tf2_ros.Buffer()
        tf2_ros.TransformListener(self._tf_buf)

        self.pub_result = rospy.Publisher('/gloc/result', String, queue_size=1, latch=True)
        self.pub_heatmap = rospy.Publisher('/gloc/heatmap', CompressedImage, queue_size=1, latch=True)
        self.pub_status = rospy.Publisher('/gloc/status', String, queue_size=1, latch=True)
        self.pub_initialpose = rospy.Publisher('/rtabmap/initialpose',
                                               PoseWithCovarianceStamped, queue_size=1)

        map_topic = rospy.get_param('~map_topic', '/rtabmap/grid_map')
        rospy.Subscriber(map_topic, OccupancyGrid, self.cb_grid, queue_size=1)
        rospy.Subscriber('/gloc/compute', String, self.cb_compute, queue_size=1)
        rospy.Subscriber('/gloc/apply', String, self.cb_apply, queue_size=1)
        rospy.Service('/gloc/localize', Trigger, self.srv_localize)

        # tracker wiring
        # WP2 (localization v2): publish to the source-tagged TRACKER topic so
        # navi_transform's arbiter ranks it (dock > tracker > rtabmap > legacy).
        # Tracker gating (gps_good / track_defer_to_rtabmap / gates) is unchanged.
        self.pub_track_pose = rospy.Publisher('/nav_tf/set_map_pose_tracker',
                                              PoseStamped, queue_size=1)
        self.pub_track_status = rospy.Publisher('/gloc/track_status', String,
                                                queue_size=1, latch=True)
        # PER-MAP BASELINE PERSISTENCE: publish a stabilised docked baseline for
        # mapping_manager to persist; subscribe to the seed it republishes on
        # serve, and to its status to learn the serving site/raster name.
        self.pub_baseline = rospy.Publisher('/gloc/baseline', String,
                                            queue_size=1, latch=True)
        rospy.Subscriber('/mapping_manager/track_baseline', String,
                         self._cb_track_baseline, queue_size=1)
        rospy.Subscriber('/mapping_manager/status', String,
                         self._cb_mm_status, queue_size=1)
        rospy.Subscriber(self.scan_topic, LaserScan,
                         lambda m: setattr(self, '_last_scan', m), queue_size=1)
        # ENGAGE FAST (2026-07-12, correctness-first): the tracker must take over
        # the moment the RAW fix goes unusable — see _tracker_should_idle().
        # bridge_status carries TWO fields: gps_good=int (_gps_stable — pose
        # OWNERSHIP, stays TRUE through the ~8 s outage grace) and
        # fix_usable=int (RAW position_fix_usable — drops immediately on
        # denial). self._gps_good = gps_stable and fix_usable is kept as a raw
        # telemetry field (reported in track_status) but is NO LONGER the
        # tracker gate directly — see the PROBATION-WINDOW JERK FIX note below
        # and _tracker_should_idle() for the actual gate used by the tick.
        # SAFETY: activating during the grace window can NOT fight GPS — the
        # arbiter in navi_transform ranks dock > tracker > rtabmap, and while
        # _gps_stable() is TRUE the RTK set_pose path owns map->odom; a tracker
        # correction published then still routes through set_map_pose_tracker but
        # the slew loop yields to the GPS anchor (see callback_set_map_pose gate).
        rospy.Subscriber('/nav_tf/bridge_status', String,
                         self._cb_bridge_status, queue_size=1)
        rospy.Subscriber('/nav_tf/rtabmap_confident', Bool,
                         lambda m: setattr(self, '_rtab_conf', bool(m.data)),
                         queue_size=1)
        # docked truth (Int8, latched, 0 == docked) — a trusted anchor for the
        # rms baseline AND external corroboration for a big-delta relock. Same
        # topic/semantics navi_transform's arbiter uses.
        rospy.Subscriber('/dock_smach/dock_status', Int8,
                         lambda m: setattr(self, '_docked', int(m.data) == 0),
                         queue_size=1)
        # STANDSTILL GATE: 50 Hz odom feed, see _cb_odom().
        rospy.Subscriber('/mobile_base_controller/odom', Odometry,
                         self._cb_odom, queue_size=1)
        if self.track_enable and self.track_rate_hz > 0:
            rospy.Timer(rospy.Duration(1.0 / self.track_rate_hz),
                        self._track_tick)

        self._set_status('idle (no map yet)' if self._grid is None else 'idle')
        rospy.loginfo('[gloc] up: stride %.2f m, angles %.0f deg, %d rays, apply gate %.0f%%',
                      self.pos_stride_m, self.angle_step_deg, self.n_rays,
                      self.apply_min_margin * 100)

    def _set_status(self, s):
        self.pub_status.publish(String(s))

    # ---- per-map baseline persistence ----------------------------------------

    def _cb_mm_status(self, msg):
        """Learn the serving site/raster name from mapping_manager so a published
        baseline can be tagged with the raster it belongs to."""
        try:
            d = json.loads(msg.data)
        except (ValueError, TypeError):
            return
        serving = d.get('serving') or {}
        self._serving_site = serving.get('site')
        self._serving_raster = serving.get('raster')

    def _cb_track_baseline(self, msg):
        """SEED the rms baseline from the value mapping_manager persisted for the
        served raster (republished latched on serve). Applied immediately if a
        grid is already loaded and no baseline has been measured yet; otherwise
        cb_grid applies it when the matching grid loads. Empty payload clears the
        seed (raster with no stored baseline -> self-calibrate from scratch)."""
        try:
            d = json.loads(msg.data) if msg.data.strip() else {}
        except (ValueError, TypeError):
            return
        rms = d.get('rms_baseline')
        if rms is None:
            self._baseline_seed = None
            self._baseline_seed_raster = None
            return
        try:
            self._baseline_seed = float(rms)
        except (TypeError, ValueError):
            self._baseline_seed = None
            return
        self._baseline_seed_raster = d.get('raster')
        with self._lock:
            if self._grid is not None and self._rms_baseline is None:
                self._rms_baseline = self._baseline_seed
                seeded = True
            else:
                seeded = False
        if seeded:
            rospy.loginfo('[gloc] rms baseline SEEDED from persisted %.3f '
                          '(raster %s)', self._baseline_seed,
                          self._baseline_seed_raster)

    def _maybe_publish_baseline(self):
        """Publish the stabilised baseline once it has been refined over
        baseline_publish_after_n DOCKED captures on the served raster, so
        mapping_manager persists it. Idempotent per grid_key."""
        if (self._rms_baseline is None or self._serving_raster is None
                or self._grid_key is None
                or self._baseline_dock_captures < self.baseline_publish_after_n
                or self._grid_key == self._baseline_published_key):
            return
        payload = {'rms_baseline': round(float(self._rms_baseline), 4),
                   'overlap_frac': (None if self._last_overlap_frac is None
                                    else round(self._last_overlap_frac, 3)),
                   'site': self._serving_site,
                   'raster': self._serving_raster}
        self.pub_baseline.publish(String(json.dumps(payload)))
        self._baseline_published_key = self._grid_key
        rospy.loginfo('[gloc] baseline PUBLISHED for %s/%s: rms %.3f overlap %s '
                      '(%d docked captures) -> /gloc/baseline',
                      self._serving_site, self._serving_raster,
                      self._rms_baseline,
                      ('%.2f' % self._last_overlap_frac)
                      if self._last_overlap_frac is not None else 'n/a',
                      self._baseline_dock_captures)

    # ---- map ------------------------------------------------------------------

    def cb_grid(self, msg):
        # servesync (2026-07-12): an explicitly EMPTY (0x0, header-only) grid from
        # mapping_manager means "no map is being served" (a FRESH site is being
        # mapped) — CLEAR the in-memory map so the tracker goes no_map instead of
        # silently keeping the previous site's grid/EDT latched (it would keep
        # matching the OLD map under the NEW site's datum). A merely sparse grid
        # (<20 occupied but nonzero cells) keeps the old skip-and-retain semantics.
        if msg.info.width * msg.info.height == 0:
            with self._lock:
                had = self._grid is not None
                self._grid = None
                self._edt = None
                self._edt_gx = None
                self._edt_gy = None
                self._grid_stamp = None
                self._rms_baseline = None   # raster gone -> baseline invalid
                self._grid_key = None
                self._baseline_dock_captures = 0
                self._baseline_published_key = None
            if had:
                rospy.logwarn('[gloc] served map cleared (empty grid — fresh site '
                              'being mapped); tracker -> no_map until a map is '
                              'served again')
            return
        if abs(euler_from_quaternion([msg.info.origin.orientation.x,
                                      msg.info.origin.orientation.y,
                                      msg.info.origin.orientation.z,
                                      msg.info.origin.orientation.w])[2]) > 0.01:
            rospy.logwarn_throttle(60, '[gloc] rotated grid origin unsupported, skipping map')
            return
        h, w = msg.info.height, msg.info.width
        data = np.asarray(msg.data, dtype=np.int8).reshape(h, w)   # row 0 = origin y (bottom)
        occ = data >= self.occ_thresh
        free = (data >= 0) & (data <= 25)
        if occ.sum() < 20:
            rospy.logwarn_throttle(60, '[gloc] grid has almost no occupied cells, skipping')
            return
        edt = ndimage.distance_transform_edt(~occ) * msg.info.resolution
        edt_capped = np.minimum(edt, self.dist_cap_m).astype(np.float32)
        # tracker: EDT gradients (per metre). Points beyond the cap get zero
        # gradient and thus no pull — built-in outlier robustness.
        gy, gx = np.gradient(edt_capped)
        with self._lock:
            self._grid = (occ, free, msg.info.resolution,
                          msg.info.origin.position.x, msg.info.origin.position.y, h, w)
            self._edt = edt_capped
            self._edt_gx = (gx / msg.info.resolution).astype(np.float32)
            self._edt_gy = (gy / msg.info.resolution).astype(np.float32)
            self._grid_stamp = msg.header.stamp
            # RASTER-AWARE BASELINE: a genuinely new raster (different shape or
            # origin = a different site/map) invalidates the measured rms
            # baseline so it re-calibrates against the new raster. Incremental
            # updates of the SAME grid (rtabmap growing it) keep the baseline.
            key = (h, w, round(msg.info.origin.position.x, 3),
                   round(msg.info.origin.position.y, 3))
            if key != self._grid_key:
                self._grid_key = key
                self._rms_baseline = None
                self._baseline_dock_captures = 0
                self._baseline_published_key = None
                # SEED from a persisted baseline (mapping_manager republished it
                # on serve) so a booted-calibrated map starts with the right
                # poor_match/lost scale before self-calibration refines it.
                if self._baseline_seed is not None:
                    self._rms_baseline = self._baseline_seed
                    rospy.loginfo('[gloc] rms baseline seeded %.3f on map load '
                                  '(persisted, raster %s)', self._baseline_seed,
                                  self._baseline_seed_raster)
        if self._last_result is None:
            self._set_status('idle')
        rospy.loginfo('[gloc] map %dx%d @ %.2f m updated (occ %d, free %d)',
                      w, h, msg.info.resolution, occ.sum(), free.sum())

    # ---- scan -> base_link endpoints -------------------------------------------

    def _scan_endpoints(self):
        scan = rospy.wait_for_message(self.scan_topic, LaserScan, timeout=5.0)
        tr = self._tf_buf.lookup_transform(self.base_frame, scan.header.frame_id,
                                           rospy.Time(0), rospy.Duration(2.0))
        q = tr.transform.rotation
        lyaw = euler_from_quaternion([q.x, q.y, q.z, q.w])[2]
        lx, ly = tr.transform.translation.x, tr.transform.translation.y
        rng = np.asarray(scan.ranges, dtype=np.float32)
        ang = scan.angle_min + np.arange(len(rng)) * scan.angle_increment
        good = np.isfinite(rng) & (rng > scan.range_min) & (rng < scan.range_max * 0.99)
        rng, ang = rng[good], ang[good]
        if len(rng) < 30:
            raise RuntimeError('only %d valid rays' % len(rng))
        step = max(1, len(rng) // self.n_rays)
        rng, ang = rng[::step], ang[::step]
        exl, eyl = rng * np.cos(ang), rng * np.sin(ang)
        cb, sb = math.cos(lyaw), math.sin(lyaw)
        return (lx + cb * exl - sb * eyl, ly + sb * exl + cb * eyl,
                int(good.sum()), len(rng))

    # ---- EDT tracker (continuous local scan-to-map alignment) ----------------

    def _scan_points_base(self, scan):
        """Latest-scan variant of _scan_endpoints (non-blocking): scan
        endpoints in the base frame, subsampled to ~n_rays."""
        tr = self._tf_buf.lookup_transform(self.base_frame, scan.header.frame_id,
                                           rospy.Time(0), rospy.Duration(0.2))
        q = tr.transform.rotation
        lyaw = euler_from_quaternion([q.x, q.y, q.z, q.w])[2]
        lx, ly = tr.transform.translation.x, tr.transform.translation.y
        rng = np.asarray(scan.ranges, dtype=np.float32)
        ang = scan.angle_min + np.arange(len(rng)) * scan.angle_increment
        good = np.isfinite(rng) & (rng > scan.range_min) & (rng < scan.range_max * 0.99)
        rng, ang = rng[good], ang[good]
        if len(rng) < self.track_min_points:
            return None
        step = max(1, len(rng) // self.n_rays)
        rng, ang = rng[::step], ang[::step]
        exl, eyl = rng * np.cos(ang), rng * np.sin(ang)
        cb, sb = math.cos(lyaw), math.sin(lyaw)
        return np.stack([lx + cb * exl - sb * eyl,
                         ly + sb * exl + cb * eyl], axis=1)

    def _bilinear(self, arr, cols, rows):
        """Bilinear sample arr[rows, cols] at float indices; also validity."""
        h, w = arr.shape
        ok = (cols >= 0) & (cols < w - 1) & (rows >= 0) & (rows < h - 1)
        c0 = np.clip(np.floor(cols).astype(int), 0, w - 2)
        r0 = np.clip(np.floor(rows).astype(int), 0, h - 2)
        fc = np.clip(cols - c0, 0, 1)
        fr = np.clip(rows - r0, 0, 1)
        v = (arr[r0, c0] * (1 - fc) * (1 - fr) + arr[r0, c0 + 1] * fc * (1 - fr)
             + arr[r0 + 1, c0] * (1 - fc) * fr + arr[r0 + 1, c0 + 1] * fc * fr)
        return v, ok

    def _cb_bridge_status(self, m):
        """ENGAGE FAST (2026-07-12): parse BOTH gps_good (=_gps_stable, pose
        ownership incl. the ~8 s outage grace) and fix_usable (=raw
        position_fix_usable, drops immediately on denial) from the human-readable
        bridge_status string. The tracker gate self._gps_good is TRUE (tracker
        idles, GPS owns) ONLY when BOTH are 1. As soon as fix_usable==0 OR
        gps_good==0 the tracker becomes active — it corrects during the grace
        window instead of dead-reckoning through the first ~8 s of every denial.
        navi_transform's callback_map_coords now also yields the georef the
        moment fix_usable==0, so the two never write map->odom at the same time."""
        d = m.data or ''
        gps_stable = 'gps_good=1' in d
        fix_usable = 'fix_usable=1' in d
        self._gps_stable = gps_stable
        self._fix_usable = fix_usable
        self._gps_good = gps_stable and fix_usable
        # ENGAGE DELAY bookkeeping: track how long fix_usable has been
        # CONTINUOUSLY 0. Disengage is immediate — the instant the fix comes
        # back the streak is cleared, no lingering engagement.
        if fix_usable:
            self._fix_lost_since = None
        elif self._fix_lost_since is None:
            self._fix_lost_since = time.time()

    def _tracker_should_idle(self):
        """PROBATION-WINDOW FIX (2026-07-12): the raw ownership gate, decoupled
        from the self._gps_good telemetry field (kept as-is for status/
        observability). 'fix_lost' (default): idle whenever the raw fix is
        usable, ownership probation or not — outdoors with a usable fix, leave
        it to GPS. 'not_owned': idle only with full ownership (5f589ff,
        pre-2026-07-12 behaviour) — rollback path. This does NOT yet apply the
        engage delay (see _tracker_engaged()) — it is the instantaneous fix
        state, used as-is for telemetry and as the "fix is back" edge."""
        if self.track_active_mode == 'not_owned':
            return self._gps_good
        return self._fix_usable

    def _engage_delay_active(self):
        """RULE 1 — ENGAGE DELAY (2026-07-12, live field report: outdoors RTK
        FLAPS — fix_usable drops for a few seconds at a time while ownership
        persists through the grace window — and the tracker engaged on those
        brief windows, applying borderline outdoor matches and jerking the
        pose). True while the raw fix is currently lost (per
        _tracker_should_idle()) but has NOT yet been continuously lost for
        track_engage_after_s — i.e. we are in the "waiting to see if this is a
        real denial or just a flap" window. False once the fix is back (no
        delay on the way back) or once the denial has proven itself real."""
        if not self._tracker_should_idle():
            return False   # fix is usable right now -> not even in question
        if self._fix_lost_since is None:
            return False   # should not happen (idle implies lost), safe default
        return (time.time() - self._fix_lost_since) < self.track_engage_after_s

    def _tracker_engaged(self):
        """Combines the raw gate with the engage delay: the tracker may
        actually correct/apply/count-as-lost only once the fix has been
        continuously unusable for >= track_engage_after_s."""
        return (not self._tracker_should_idle()) and (not self._engage_delay_active())

    def _cb_odom(self, m):
        """RULE 2 — STANDSTILL GATE (2026-07-12, live field report: measured
        gyro drift is only ~0.025 deg/min, so at rest there is no drift to
        correct — any tracker "correction" proposed while stationary is pure
        alignment noise, not real drift, and it jerked the robot at a
        standstill). 50 Hz /mobile_base_controller/odom feed: latch
        self._is_standstill once |v_lin| and |v_ang| have both stayed below
        threshold for > track_standstill_hold_s; drop it the instant either
        exceeds threshold (immediate resume on motion, no symmetric delay)."""
        vx = m.twist.twist.linear.x
        wz = m.twist.twist.angular.z
        slow = abs(vx) < self.track_standstill_lin_mps and abs(wz) < self.track_standstill_ang_rps
        if not slow:
            self._standstill_since = None
            self._is_standstill = False
            return
        if self._standstill_since is None:
            self._standstill_since = time.time()
        self._is_standstill = (time.time() - self._standstill_since) >= self.track_standstill_hold_s

    def _track_align(self, pts_base, pose0):
        """Gauss-Newton scan-to-EDT: minimize sum EDT(R(yaw) p + t)^2 over
        (x, y, yaw). Returns dict with the refined pose + quality metrics,
        or a dict with 'reject' reason."""
        with self._lock:
            if self._edt is None:
                return {'reject': 'no_map'}
            edt, gx_a, gy_a = self._edt, self._edt_gx, self._edt_gy
            _, _, res, ox, oy, h, w = self._grid
        x, y, th = pose0
        n_used = 0
        best = None            # (rms, pose, overlap) — return the best iterate: near
        first_eigs = None      # convergence the on-ridge EDT gradients
        #                        collapse and a raw GN step OSCILLATES
        for it in range(self.track_max_iter):
            c, s = math.cos(th), math.sin(th)
            wx = x + c * pts_base[:, 0] - s * pts_base[:, 1]
            wy = y + s * pts_base[:, 0] + c * pts_base[:, 1]
            cols = (wx - ox) / res - 0.5
            rows = (wy - oy) / res - 0.5
            r, ok1 = self._bilinear(edt, cols, rows)
            gx, _ = self._bilinear(gx_a, cols, rows)
            gy, _ = self._bilinear(gy_a, cols, rows)
            use = ok1
            n_used = int(use.sum())
            if n_used < self.track_min_points:
                return {'reject': 'few_points_in_map', 'n': n_used}
            r, gx, gy = r[use], gx[use], gy[use]
            px, py = pts_base[use, 0], pts_base[use, 1]
            rms = float(np.sqrt(np.mean(r ** 2)))
            # SCAN OVERLAP: fraction of aligned (in-map) scan points that fall
            # within track_overlap_dist_m of mapped structure. Near 0 = the scan
            # does not correspond to the map (nothing to match); near 1 = the
            # scan sits on mapped geometry. Gates the baseline capture.
            ov = float(np.mean(r < self.track_overlap_dist_m))
            if best is None or rms < best[0]:
                best = (rms, (x, y, th), ov)
            dth = gx * (-s * px - c * py) + gy * (c * px - s * py)
            J = np.stack([gx, gy, dth], axis=1)
            H = J.T @ J
            g = J.T @ r
            if first_eigs is None:
                # degeneracy is judged at the INITIAL pose: once converged the
                # on-ridge gradients vanish and the eigenvalues say nothing
                first_eigs = np.linalg.eigvalsh(H[:2, :2])
            # adaptive Levenberg damping: when the gradients collapse near
            # convergence, H collapses too — damping must scale WITH it or
            # the solve produces a huge bogus step from numerical noise
            lam = max(1e-3, 0.05 * float(np.trace(H)) / 3.0)
            try:
                delta = -np.linalg.solve(H + lam * np.eye(3), g)
            except np.linalg.LinAlgError:
                return {'reject': 'singular'}
            # per-iteration step clamp (robustness belt)
            dnorm = float(np.hypot(delta[0], delta[1]))
            if dnorm > 0.20:
                delta[:2] *= 0.20 / dnorm
            delta[2] = max(-math.radians(2.0), min(math.radians(2.0), delta[2]))
            x += delta[0]
            y += delta[1]
            th += delta[2]
            if dnorm < 0.002 and abs(delta[2]) < 1e-4:
                break
        rms, pose, overlap_frac = best
        return {'pose': pose, 'rms': rms, 'n': n_used,
                'overlap_frac': overlap_frac,
                'eig_min': float(first_eigs[0]), 'eig_max': float(first_eigs[1])}

    def _bigcorr_reset(self):
        """Clear the big-corr freshness timer and consistency buffers."""
        self._bigcorr_since = None
        self._bigcorr_dirs = []
        self._bigcorr_mags = []

    def _bigcorr_consistent(self, dx_v, dy_v, mag):
        """Push this tick's correction (dx, dy vector + magnitude) into the
        consistency buffers and report whether the last N corr_too_big ticks
        agree in direction (circular spread < consist_deg) and magnitude
        (max/min < consist_ratio). Buffers are trimmed to N. Returns
        (consistent_bool, spread_deg, mag_ratio)."""
        self._bigcorr_dirs.append(math.atan2(dy_v, dx_v))
        self._bigcorr_mags.append(mag)
        n = max(1, self.track_bigcorr_consist_n)
        self._bigcorr_dirs = self._bigcorr_dirs[-n:]
        self._bigcorr_mags = self._bigcorr_mags[-n:]
        if len(self._bigcorr_dirs) < n:
            return False, None, None
        # circular spread = 1 - resultant length, mapped to an angular figure
        cs = sum(math.cos(a) for a in self._bigcorr_dirs)
        sn = sum(math.sin(a) for a in self._bigcorr_dirs)
        rlen = math.hypot(cs, sn) / len(self._bigcorr_dirs)
        rlen = min(1.0, rlen)
        spread_deg = math.degrees(math.acos(rlen))  # 0 = perfectly aligned
        mn, mx = min(self._bigcorr_mags), max(self._bigcorr_mags)
        ratio = (mx / mn) if mn > 1e-6 else float('inf')
        ok = (spread_deg <= self.track_bigcorr_consist_deg and
              ratio < self.track_bigcorr_consist_ratio)
        return ok, spread_deg, ratio

    def _effective_max_rms(self):
        """RASTER-AWARE poor_match/lost threshold: scale up on a sparse raster
        via the measured good-pose baseline, but NEVER below the old absolute
        floor (track_max_rms_m) — band rasters (baseline*factor < floor) keep
        the exact legacy 0.20 m gate, no regression."""
        if self._rms_baseline is None:
            return self.track_max_rms_m
        return max(self.track_max_rms_m,
                   self._rms_baseline * self.track_lost_rms_factor)

    def _relock_cand_rms(self, pose):
        """Align rms of the live scan at a candidate map pose (Gauss-Newton,
        the SAME metric as the tracker baseline) — used by the relock
        absolute-quality gate. Returns None if it can not be evaluated."""
        scan = self._last_scan
        if scan is None:
            return None
        try:
            pts = self._scan_points_base(scan)
        except Exception:
            return None
        if pts is None:
            return None
        out = self._track_align(pts, pose)
        return out.get('rms')

    def _try_relock(self, info):
        """Run the global kidnap scorer and, if it passes the margin + yaw-sanity
        gates, publish the found pose to /nav_tf/set_map_pose_tracker (navi_transform
        SNAPS it when >0.6 m from the drifted pose = instant re-lock). Returns True
        if a pose was published. Loud logging either way. Called synchronously from
        the tick thread — the scorer is ~0.5-1 s, acceptable at 1 Hz."""
        self._last_relock_t = time.time()
        rospy.logwarn('[gloc-track] LOST for %.0fs (%s) — running AUTO-RELOCK '
                      '(global scorer)...', info.get('lost_held_s', 0.0),
                      info.get('reject_reason', '?'))
        self._set_status('relocalizing (auto)...')
        try:
            # no_heatmap: cheaper, we do not need the PNG for an auto-relock
            r = self.compute(with_heatmap=False)
        except Exception as e:
            rospy.logwarn('[gloc-track] auto-relock compute failed: %s', e)
            info['state'] = 'relock_failed'
            info['relock_err'] = str(e)
            return False
        info['relock_margin'] = r['margin']
        info['relock_yaw_sane'] = r.get('yaw_sane', True)
        if not r.get('apply_ok', r['margin_ok']):
            why = ('margin %.0f%% < gate %.0f%%' % (r['margin'] * 100,
                   self.apply_min_margin * 100) if not r['margin_ok']
                   else 'yaw deviates from current heading (mirror alias?)')
            rospy.logwarn('[gloc-track] AUTO-RELOCK REJECTED: %s — staying lost, '
                          'will retry in %.0fs', why, self.relock_min_interval_s)
            info['state'] = 'relock_failed'
            self._set_status('relock rejected: %s' % why)
            return False
        b = r['best']
        # (2) RELOCK ABSOLUTE-QUALITY GATE (2026-07-19 incident): the relative
        # margin is meaningless on a sparse DIRECT raster — every wrong
        # hypothesis is equally terrible, so the runner-up gap (margin) inflates
        # even for a garbage lock (337% on the 4.68 m teleport). Require the
        # candidate's OWN align rms to be near the calibrated good-pose baseline.
        # Relative margin NEVER suffices alone. Fallback to an absolute floor
        # when no trusted baseline has been measured on this raster yet.
        cand_rms = self._relock_cand_rms(
            (b['x'], b['y'], math.radians(b['yaw_deg'])))
        abs_gate = (self._rms_baseline * self.relock_abs_rms_factor
                    if self._rms_baseline is not None
                    else self.relock_abs_rms_floor_m)
        info['relock_cand_rms'] = None if cand_rms is None else round(cand_rms, 3)
        info['relock_abs_gate'] = round(abs_gate, 3)
        info['relock_baseline'] = (None if self._rms_baseline is None
                                   else round(self._rms_baseline, 3))
        if cand_rms is None or cand_rms > abs_gate:
            rospy.logwarn('[gloc-track] AUTO-RELOCK REJECTED: candidate rms %s > '
                          'absolute gate %.3f (baseline %s) — margin %.0f%% alone '
                          'is NOT trusted on a sparse raster; staying lost, retry '
                          'in %.0fs',
                          ('%.3f' % cand_rms) if cand_rms is not None else 'n/a',
                          abs_gate,
                          ('%.3f' % self._rms_baseline) if self._rms_baseline
                          is not None else 'none',
                          r['margin'] * 100, self.relock_min_interval_s)
            info['state'] = 'relock_failed'
            info['relock_abs_reject'] = True
            self._set_status('relock rejected: rms %s > gate %.3f'
                             % (('%.3f' % cand_rms) if cand_rms is not None
                                else 'n/a', abs_gate))
            return False
        # (3) BIG-DELTA CORROBORATION (2026-07-19 incident: a 4.68 m auto-relock
        # teleport on lidar alone). A far jump (> relock_big_delta_m) is
        # high-consequence — require EXTERNAL corroboration (docked OR a live GPS
        # fix). Absent it, PUBLISH the hypothesis to track_status for
        # observability and log loudly, but do NOT apply — the operator can still
        # force it via /gloc/apply (manual path is unaffected).
        _dcur = r.get('delta_to_current') or {}
        _delta_m = _dcur.get('dist_m')
        if _delta_m is not None and _delta_m > self.relock_big_delta_m:
            corrob = self._docked or self._gps_good
            if self.relock_bigdelta_require_corrob and not corrob:
                rospy.logwarn('[gloc-track] AUTO-RELOCK HELD (observability only): '
                              'far jump %.2f m (> %.2f m) to (%.2f, %.2f, %.1fdeg) '
                              'rms %.3f margin %.0f%% — NO external corroboration '
                              '(docked=%s gps=%s). NOT applied; use /gloc/apply to '
                              'force.', _delta_m, self.relock_big_delta_m, b['x'],
                              b['y'], b['yaw_deg'], cand_rms, r['margin'] * 100,
                              self._docked, self._gps_good)
                info['state'] = 'relock_hyp'
                info['relock_bigdelta_uncorroborated'] = True
                info['relock_hyp_x'] = b['x']
                info['relock_hyp_y'] = b['y']
                info['relock_hyp_yaw_deg'] = b['yaw_deg']
                info['relock_hyp_delta_m'] = _delta_m
                self._set_status('relock HELD (far %.2fm, no corroboration)'
                                 % _delta_m)
                return False
        # SOFT-MAP RELOCK GUARD (2026-07-12): a FAR relock (moves the pose more
        # than relock_big_delta_m) is high-consequence on a soft/aliased map —
        # require a stronger-than-normal margin. The garage shove (delta 1.47 m,
        # margin 112%) is rejected here; a decisive far relock (e.g. margin 280%)
        # still passes, so genuine recovery from a real large offset is unaffected.
        _dcur = r.get('delta_to_current') or {}
        _delta_m = _dcur.get('dist_m')
        if (_delta_m is not None and _delta_m > self.relock_big_delta_m and
                r['margin'] < self.relock_big_delta_margin):
            rospy.logwarn('[gloc-track] AUTO-RELOCK REJECTED: far jump %.2f m '
                          '(> %.2f m) at margin %.0f%% < soft-map gate %.0f%% — '
                          'staying lost, will retry in %.0fs', _delta_m,
                          self.relock_big_delta_m, r['margin'] * 100,
                          self.relock_big_delta_margin * 100,
                          self.relock_min_interval_s)
            info['state'] = 'relock_failed'
            info['relock_far_reject'] = True
            self._set_status('relock rejected: far %.2fm at margin %.0f%%'
                             % (_delta_m, r['margin'] * 100))
            return False
        b = r['best']
        ps = PoseStamped()
        ps.header.stamp = rospy.Time.now()
        ps.header.frame_id = self.map_frame
        ps.pose.position.x = b['x']
        ps.pose.position.y = b['y']
        q = quaternion_from_euler(0, 0, math.radians(b['yaw_deg']))
        ps.pose.orientation.x = q[0]
        ps.pose.orientation.y = q[1]
        ps.pose.orientation.z = q[2]
        ps.pose.orientation.w = q[3]
        self.pub_track_pose.publish(ps)
        # fresh lock — clear all reject/smoothing state so the tracker resumes
        # clean from the snapped pose next tick.
        self._lost_since = None
        self._bigcorr_reset()
        self._persist_dirs = []
        self._ema_pose = None
        self._reject_reason = None
        self._reject_streak = 0
        dcur = r.get('delta_to_current') or {}
        rospy.logwarn('[gloc-track] AUTO-RELOCK APPLIED -> /nav_tf/set_map_pose_tracker '
                      '(%.2f, %.2f, %.1fdeg) margin %.0f%% delta %.2fm '
                      '(navi_transform snaps if >0.6m)', b['x'], b['y'],
                      b['yaw_deg'], r['margin'] * 100, dcur.get('dist_m', -1))
        self._set_status('RELOCK APPLIED (%.2f, %.2f, %.1fdeg) margin %.0f%%'
                         % (b['x'], b['y'], b['yaw_deg'], r['margin'] * 100))
        info['state'] = 'relock'
        info['relock_x'] = b['x']
        info['relock_y'] = b['y']
        info['relock_yaw_deg'] = b['yaw_deg']
        info['relock_delta_m'] = dcur.get('dist_m')
        return True

    def _track_tick(self, _evt):
        info = {'applied': False}
        _t0 = time.time()
        try:
            # AUTO-RELOCK gate: if we are lost (a real localization-loss reject
            # streak, GPS denied) beyond track_lost_after_s and the rate limit has
            # elapsed, hijack this tick to run the global scorer instead of the
            # normal local alignment (which can no longer pull us back). Gated on
            # _tracker_engaged() (not just the raw fix state) so a brief RTK flap
            # can not itself count toward the lost timer — but once engaged this
            # is the kidnap-scale relock path and stays available EVEN AT A
            # STANDSTILL (Rule 2's exception: a robot can be picked up and set
            # back down without ever registering as "moving").
            if (self.relock_enable and self._lost_since is not None
                    and self._tracker_engaged()):
                held = time.time() - self._lost_since
                info['lost_held_s'] = round(held, 1)
                info['reject_reason'] = self._reject_reason
                if (held >= self.track_lost_after_s and
                        time.time() - self._last_relock_t >= self.relock_min_interval_s):
                    self._try_relock(info)
                    # publish status for this hijacked tick and stop; the normal
                    # alignment resumes next tick (finally-block still runs).
                    return

            scan = self._last_scan
            now = rospy.Time.now()
            if scan is None or (now - scan.header.stamp).to_sec() > 1.5:
                info['state'] = 'no_scan'
                return
            pose0 = self._current_pose()
            if pose0 is None:
                info['state'] = 'no_tf'
                return
            pts = self._scan_points_base(scan)
            if pts is None:
                info['state'] = 'few_rays'
                return
            out = self._track_align(pts, pose0)
            if 'reject' in out:
                info['state'] = out['reject']
                return
            x, y, th = out['pose']
            dx = math.hypot(x - pose0[0], y - pose0[1])
            dyaw = math.degrees(abs(math.atan2(math.sin(th - pose0[2]),
                                               math.cos(th - pose0[2]))))
            info.update({'state': 'ok', 'rms': round(out['rms'], 3),
                         'n': out['n'], 'corr_m': round(dx, 3),
                         'corr_yaw_deg': round(dyaw, 2),
                         'eig_min_frac': round(out['eig_min'] / out['n'], 3),
                         'gps_good': self._gps_good,
                         'gps_stable': self._gps_stable,
                         'fix_usable': self._fix_usable,
                         'track_active_mode': self.track_active_mode,
                         'rtabmap_confident': self._rtab_conf,
                         'engage_delay_active': self._engage_delay_active(),
                         'is_standstill': self._is_standstill,
                         'docked': self._docked})
            eig_ok = out['eig_min'] >= self.track_min_eig_frac * out['n']
            overlap_frac = out.get('overlap_frac')
            self._last_overlap_frac = overlap_frac
            info['overlap_frac'] = (None if overlap_frac is None
                                    else round(overlap_frac, 3))
            # (1) SELF-CALIBRATING RMS BASELINE: while a TRUSTED anchor holds the
            # pose (gps_good OR docked) and the match is healthy (eig ok, the
            # align did NOT run off toward an alias), capture this raster's
            # expected good-match rms into an EMA. This is what recalibrates the
            # poor_match/lost gate for the sparse DIRECT raster without any
            # hardcoding — it is measured live at the actual location.
            # PROTOCOL 2026-07-19: ALSO require SCAN OVERLAP (overlap_frac >
            # track_overlap_min) so a trusted anchor holding over UNMAPPED space
            # (scan does not match the raster) can no longer contaminate the
            # baseline toward the cap (~0.9) — the tonight contamination fix.
            overlap_ok = (overlap_frac is not None
                          and overlap_frac > self.track_overlap_min)
            if ((self._gps_good or self._docked) and eig_ok and overlap_ok
                    and dx <= self.track_max_corr_m):
                if self._rms_baseline is None:
                    self._rms_baseline = out['rms']
                else:
                    a = self.track_baseline_alpha
                    self._rms_baseline = ((1.0 - a) * self._rms_baseline
                                          + a * out['rms'])
                # PER-MAP PERSISTENCE: count DOCKED calibration captures on the
                # served raster; once stabilised, publish for mapping_manager.
                if self._docked:
                    self._baseline_dock_captures += 1
                    self._maybe_publish_baseline()
            info['baseline_dock_captures'] = self._baseline_dock_captures
            eff_max_rms = self._effective_max_rms()
            info['rms_baseline'] = (None if self._rms_baseline is None
                                    else round(self._rms_baseline, 3))
            info['eff_max_rms'] = round(eff_max_rms, 3)
            rms_ok = out['rms'] <= eff_max_rms
            corr_ok = (dx <= self.track_max_corr_m and
                       dyaw <= self.track_max_corr_yaw_deg)
            if not rms_ok:
                info['state'] = 'poor_match'
                self._bigcorr_reset()
                self._persist_dirs = []
                self._ema_pose = None
                return
            if not eig_ok:
                info['state'] = 'degenerate'
                self._bigcorr_reset()
                self._persist_dirs = []
                self._ema_pose = None
                return
            # BIG-CORR RECOVERY: normally reject an over-cap correction, but if it
            # persists (match otherwise healthy: rms + eig already passed) the
            # tracker would deadlock — after track_bigcorr_recover_s, SLEW toward
            # the target in bounded steps instead of rejecting outright.
            slewed = False
            slew_step = 0.0
            if not corr_ok:
                if self._bigcorr_since is None:
                    self._bigcorr_since = time.time()
                held = time.time() - self._bigcorr_since
                # CONSISTENCY GATE (finding 1): direction + magnitude stability
                # over the last N corr_too_big ticks. An aliased row-lock jitters;
                # a real accumulated offset holds. Gate failure resets the whole
                # freshness window so evidence must re-accumulate from scratch.
                consist_ok, spread_deg, mag_ratio = self._bigcorr_consistent(
                    x - pose0[0], y - pose0[1], dx)
                if spread_deg is not None:
                    info['bigcorr_dir_spread_deg'] = round(spread_deg, 1)
                    info['bigcorr_mag_ratio'] = round(mag_ratio, 2)
                if held < self.track_bigcorr_recover_s or not consist_ok:
                    info['state'] = 'corr_too_big'
                    info['bigcorr_held_s'] = round(held, 1)
                    info['bigcorr_consist_ok'] = bool(consist_ok)
                    if not consist_ok and held >= self.track_bigcorr_recover_s:
                        # timer elapsed but direction/magnitude unstable -> alias
                        # suspicion: drop the window, force a fresh N-tick + 20s.
                        self._bigcorr_reset()
                    return
                # recover: clamp the correction to a bounded per-tick step toward
                # (x, y, th), publish the intermediate pose (GPS/rtabmap ownership
                # is enforced by the shared gate below).
                slew_step = dx
                if dx > self.track_bigcorr_step_m and dx > 1e-6:
                    f = self.track_bigcorr_step_m / dx
                    x = pose0[0] + (x - pose0[0]) * f
                    y = pose0[1] + (y - pose0[1]) * f
                    slew_step = self.track_bigcorr_step_m
                dyaw_signed = math.atan2(math.sin(th - pose0[2]),
                                         math.cos(th - pose0[2]))
                step_yaw = math.radians(self.track_bigcorr_step_yaw_deg)
                if abs(dyaw_signed) > step_yaw:
                    th = pose0[2] + math.copysign(step_yaw, dyaw_signed)
                slewed = True
                info['state'] = 'recover_slew'
                info['bigcorr_held_s'] = round(held, 1)
                info['bigcorr_consist_ok'] = True
            else:
                self._bigcorr_reset()
            # correction is healthy (or slewed) — apply only when GPS is denied
            # (the GPS arbiter owns the pose otherwise) and rtabmap does not have
            # priority (defer default OFF 2026-07-11; ~track_defer_to_rtabmap).
            if self._tracker_should_idle():
                # RULE 1 — ENGAGE DELAY: the raw fix is currently unusable, but
                # distinguish "still waiting to see if this is a real denial"
                # from "GPS is simply back and owns the pose" so the status is
                # honest about which gate is holding the tracker off.
                if self._engage_delay_active():
                    info['state'] = 'engage_delay'
                    info['fix_lost_held_s'] = round(
                        time.time() - self._fix_lost_since, 1)
                else:
                    info['state'] = 'gps_owns'
                # freshness (finding 2): GPS owns the pose (or we are still in
                # the engage-delay window and must not act on a possible flap),
                # so any big-corr evidence is stale — after real GPS loss
                # recovery must earn a fresh 20 s + N-tick window from scratch.
                self._bigcorr_reset()
                self._persist_dirs = []
                self._ema_pose = None
                return
            if self.track_defer_to_rtabmap and self._rtab_conf:
                info['state'] = 'rtabmap_owns'
                return
            # RULE 2 — STANDSTILL GATE: at rest there is no drift to correct
            # (gyro drift ~0.025 deg/min) — any correction proposed here is
            # alignment noise, not real drift. Suppress the publish entirely;
            # the kidnap-scale relock path above is NOT gated by this (it
            # already returned earlier in the tick if it fired).
            if self._is_standstill:
                info['state'] = 'standstill'
                # do not let stale big-corr/persist/EMA evidence carry across a
                # standstill stretch into the next real motion — same freshness
                # reasoning as the gps_owns/engage_delay reset above.
                self._bigcorr_reset()
                self._persist_dirs = []
                self._ema_pose = None
                return
            # SMOOTH (2026-07-12): the big-corr RECOVER slew is a deliberate
            # bounded catch-up and must publish undiluted. Only the NORMAL path
            # (where the near-minima ping-pong lives) is EMA-smoothed + gated.
            if slewed:
                self._ema_pose = (x, y, th)   # keep EMA anchored to the live pose
                self._persist_dirs = []
            else:
                # STALE-EMA RESET (2026-07-12 prevention 2b): if no correction was
                # applied for > track_ema_reset_gap_s, the smoothed target is stale
                # — while lost/rejecting the EMA kept decaying toward an old
                # alignment and would now pull the pose the WRONG way. Drop it so
                # this tick re-seeds the EMA from the live measurement.
                if (self._ema_pose is not None and self._last_apply_t is not None
                        and time.time() - self._last_apply_t > self.track_ema_reset_gap_s):
                    self._ema_pose = None
                    self._persist_dirs = []
                    info['ema_reset'] = True
                # 1) EMA the target pose (yaw via angle-wrap on the delta)
                if self._ema_pose is None:
                    self._ema_pose = (x, y, th)
                else:
                    a = self.track_ema_alpha
                    ex, ey, eth = self._ema_pose
                    dth = math.atan2(math.sin(th - eth), math.cos(th - eth))
                    self._ema_pose = (ex + a * (x - ex),
                                      ey + a * (y - ey),
                                      eth + a * dth)
                x, y, th = self._ema_pose
                # recompute the SMOOTHED correction vs the live pose
                dx = math.hypot(x - pose0[0], y - pose0[1])
                dyaw = math.degrees(abs(math.atan2(math.sin(th - pose0[2]),
                                                   math.cos(th - pose0[2]))))
                info['corr_m_sm'] = round(dx, 3)
                info['corr_yaw_deg_sm'] = round(dyaw, 2)
                # URGENT-CORR BYPASS (2026-07-12 prevention 2a): a smoothed
                # correction over track_urgent_corr_m is real drift, not near-minima
                # jitter — the deadband/persistence gates must NOT starve it while
                # driving. Skip both gates and publish now (EMA already applied, so a
                # single aliased tick still can not yank the pose). Below the
                # threshold, keep the ping-pong suppression (deadband + persistence).
                urgent = dx > self.track_urgent_corr_m
                if urgent:
                    info['urgent'] = True
                else:
                    # 2) raised deadband — drop sub-4 cm / sub-0.4 deg ping-pong
                    if dx < self.track_min_corr_m and dyaw < self.track_min_corr_yaw_deg:
                        info['state'] = 'aligned'
                        self._persist_dirs = []
                        return
                    # 3) persistence gate — the smoothed correction must point the
                    # same way for >= N ticks (real drift holds; ping-pong reverses)
                    self._persist_dirs.append(math.atan2(y - pose0[1], x - pose0[0]))
                    n = max(1, self.track_persist_n)
                    self._persist_dirs = self._persist_dirs[-n:]
                    if len(self._persist_dirs) >= n:
                        cs = sum(math.cos(a) for a in self._persist_dirs)
                        sn = sum(math.sin(a) for a in self._persist_dirs)
                        rlen = min(1.0, math.hypot(cs, sn) / len(self._persist_dirs))
                        spread = math.degrees(math.acos(rlen))
                        info['persist_spread_deg'] = round(spread, 1)
                    else:
                        spread = None
                    if spread is None or spread > self.track_persist_deg:
                        info['state'] = 'settling'
                        return
            ps = PoseStamped()
            ps.header.stamp = now
            ps.header.frame_id = self.map_frame
            ps.pose.position.x = x
            ps.pose.position.y = y
            q = quaternion_from_euler(0, 0, th)
            ps.pose.orientation.x = q[0]
            ps.pose.orientation.y = q[1]
            ps.pose.orientation.z = q[2]
            ps.pose.orientation.w = q[3]
            self.pub_track_pose.publish(ps)
            info['applied'] = True
            self._applied_count += 1
            self._last_apply_t = time.time()
            # finding 3: on a slew, dx is the FULL offset to the target but only
            # slew_step m is actually applied this tick — print both (step/total).
            if slewed:
                rospy.loginfo_throttle(
                    10.0, '[gloc-track] RECOVER-slew %.2f m step / %.2f m total '
                    '/ %.1f deg (rms %.2f, n=%d)',
                    slew_step, dx, dyaw, out['rms'], out['n'])
            else:
                rospy.loginfo_throttle(
                    10.0, '[gloc-track] correcting %.2f m / %.1f deg '
                    '(rms %.2f, n=%d)',
                    dx, dyaw, out['rms'], out['n'])
        except Exception as e:
            info['state'] = 'error: %s' % e
        finally:
            # (2c) observability: applied total + reject-reason streak counter
            st = info.get('state', 'ok')
            if info.get('applied'):
                self._reject_reason = None
                self._reject_streak = 0
            else:
                if st == self._reject_reason:
                    self._reject_streak += 1
                else:
                    self._reject_reason = st
                    self._reject_streak = 1
            # AUTO-RELOCK lost-streak tracking: arm _lost_since on the FIRST tick
            # of a genuine localization-loss reject (poor_match/degenerate/
            # corr_too_big), clear it on any applied correction or a healthy/owned
            # state. Sensor gaps (no_scan/no_tf/few_*) and the relock states
            # themselves do NOT arm/clear the timer here — _try_relock manages its
            # own reset, and a relock in progress must not keep re-arming.
            # 'engage_delay' (Rule 1) and 'standstill' (Rule 2) are ALSO excluded
            # from arming/holding the lost timer: a brief RTK flap must not
            # accumulate lost-time during the engage-delay window, and sitting
            # still is not evidence of being lost either.
            if info.get('applied') or st in ('gps_owns', 'rtabmap_owns', 'aligned',
                                             'engage_delay', 'standstill'):
                self._lost_since = None
            elif st in self._lost_states:
                if self._lost_since is None:
                    self._lost_since = time.time()
            # (relock / relock_failed / no_scan / no_tf / etc.: leave _lost_since
            #  as-is — a transient sensor gap must not reset an accumulating loss,
            #  and relock states are handled inside _try_relock)
            info['lost'] = self._lost_since is not None
            if self._lost_since is not None:
                info['lost_held_s'] = round(time.time() - self._lost_since, 1)
            info['applied_count'] = self._applied_count
            info['reject_reason'] = self._reject_reason
            info['reject_streak'] = self._reject_streak
            # tick duration (ms) — verify GN cost at 5 Hz; back ~track_rate_hz to 3
            # if this routinely exceeds ~100 ms (relock ticks are excluded above,
            # they return early). Exposed in status for the live check.
            info['tick_ms'] = round((time.time() - _t0) * 1000.0, 1)
            self.pub_track_status.publish(String(json.dumps(info)))

    def _current_pose(self):
        try:
            g = self._tf_buf.lookup_transform(self.map_frame, self.base_frame,
                                              rospy.Time(0), rospy.Duration(1.0))
            q = g.transform.rotation
            return (g.transform.translation.x, g.transform.translation.y,
                    euler_from_quaternion([q.x, q.y, q.z, q.w])[2])
        except Exception:
            return None

    # ---- core -------------------------------------------------------------------

    def compute(self, with_heatmap=True):
        with self._lock:
            if self._grid is None:
                raise RuntimeError('no /rtabmap/grid_map received yet (is rtabmap up?)')
            occ, free, res, ox, oy, H, W = self._grid
            edt = self._edt
        exb, eyb, valid, used = self._scan_endpoints()

        stride = max(1, int(round(self.pos_stride_m / res)))
        fr, fc = np.where(free)
        keep = (fr % stride == 0) & (fc % stride == 0)
        fr, fc = fr[keep], fc[keep]
        px = ox + (fc + 0.5) * res
        py = oy + (fr + 0.5) * res      # OccupancyGrid: row 0 = origin y
        M = len(px)
        if M == 0:
            raise RuntimeError('no free cells in grid')
        angles = np.deg2rad(np.arange(0.0, 360.0, self.angle_step_deg))

        t0 = time.time()
        best_score = np.full(M, np.inf, dtype=np.float32)
        best_ang = np.zeros(M, dtype=np.float32)
        for a in angles:
            ca, sa = math.cos(a), math.sin(a)
            wx = px[:, None] + ca * exb[None, :] - sa * eyb[None, :]
            wy = py[:, None] + sa * exb[None, :] + ca * eyb[None, :]
            cc = ((wx - ox) / res - 0.5).round().astype(np.int32)
            rr = ((wy - oy) / res - 0.5).round().astype(np.int32)
            inside = (rr >= 0) & (rr < H) & (cc >= 0) & (cc < W)
            d = np.full(wx.shape, self.dist_cap_m, dtype=np.float32)
            d[inside] = edt[rr[inside], cc[inside]]
            s = d.mean(axis=1)
            upd = s < best_score
            best_score[upd] = s[upd]
            best_ang[upd] = a
        dt = time.time() - t0

        order = np.argsort(best_score)
        ib = int(order[0])
        bx, by, byaw = float(px[ib]), float(py[ib]), float(best_ang[ib])
        dist = np.hypot(px[order] - bx, py[order] - by)
        far = order[dist > self.ambiguity_radius]
        if len(far):
            i2 = int(far[0])
            margin = float((best_score[i2] - best_score[ib]) / max(best_score[ib], 1e-6))
        else:
            i2, margin = ib, float('inf')

        top = []
        seen = []
        for i in order:
            if all(math.hypot(px[i] - sx, py[i] - sy) > self.ambiguity_radius
                   for sx, sy in seen):
                top.append({'x': round(float(px[i]), 2), 'y': round(float(py[i]), 2),
                            'yaw_deg': round(math.degrees(float(best_ang[i])), 1),
                            'score': round(float(best_score[i]), 4)})
                seen.append((px[i], py[i]))
            if len(top) >= 5:
                break

        cur = self._current_pose()
        yaw_sane = True
        if cur is not None:
            yaw_dev = abs(math.atan2(math.sin(byaw - cur[2]), math.cos(byaw - cur[2])))
            yaw_sane = bool(yaw_dev <= self.apply_max_yaw_dev)
        result = {
            'stamp': rospy.Time.now().to_sec(),
            'best': {'x': round(bx, 2), 'y': round(by, 2),
                     'yaw_deg': round(math.degrees(byaw), 1),
                     'score_m': round(float(best_score[ib]), 4)},
            'margin': round(margin, 3) if math.isfinite(margin) else 999.0,
            'margin_ok': bool(margin >= self.apply_min_margin),
            'yaw_sane': yaw_sane,
            'apply_ok': bool(margin >= self.apply_min_margin and yaw_sane),
            'apply_min_margin': self.apply_min_margin,
            'top': top,
            'current_pose': None if cur is None else
                {'x': round(cur[0], 2), 'y': round(cur[1], 2),
                 'yaw_deg': round(math.degrees(cur[2]), 1)},
            'delta_to_current': None if cur is None else
                {'dist_m': round(math.hypot(bx - cur[0], by - cur[1]), 2),
                 'dyaw_deg': round(math.degrees(math.atan2(
                     math.sin(byaw - cur[2]), math.cos(byaw - cur[2]))), 1)},
            'hypotheses': int(M * len(angles)),
            'positions': int(M),
            'rays_used': used,
            'rays_valid': valid,
            'compute_s': round(dt, 2),
            'grid_stamp': None if self._grid_stamp is None else self._grid_stamp.to_sec(),
        }
        self._last_result = result
        self.pub_result.publish(String(json.dumps(result)))
        if with_heatmap:
            try:
                self._publish_heatmap(occ, free, res, ox, oy, H, W,
                                      fr, fc, best_score, (bx, by, byaw), cur)
            except Exception as e:
                rospy.logwarn('[gloc] heatmap failed: %s', e)
        rospy.loginfo('[gloc] best (%.2f, %.2f, %.1fdeg) score %.3f margin %.0f%% in %.2fs',
                      bx, by, math.degrees(byaw), best_score[ib],
                      min(margin, 9.99) * 100, dt)
        return result

    def _publish_heatmap(self, occ, free, res, ox, oy, H, W, fr, fc,
                         best_score, best_xyyaw, cur):
        import matplotlib
        matplotlib.use('Agg')
        import matplotlib.pyplot as plt
        heat = np.full((H, W), np.nan, dtype=np.float32)
        # paint a stride-sized block per sampled position — single pixels vanish
        # at render resolution and the heatmap looked empty
        s = max(1, int(round(self.pos_stride_m / res)))
        for dr in range(-(s // 2), s // 2 + 1):
            for dc in range(-(s // 2), s // 2 + 1):
                rr2 = np.clip(fr + dr, 0, H - 1)
                cc2 = np.clip(fc + dc, 0, W - 1)
                heat[rr2, cc2] = best_score
        fig, ax = plt.subplots(figsize=(7, 7 * H / max(W, 1)))
        bg = np.where(occ, 0.0, np.where(free, 1.0, 0.6))
        ax.imshow(bg, cmap='gray', vmin=0, vmax=1, origin='lower')
        hm = ax.imshow(heat, cmap='viridis_r', alpha=0.85, origin='lower')
        fig.colorbar(hm, ax=ax, label='score [m] (lower = better)')

        def draw_pose(x, y, yaw, color, label, crosshair=False):
            # cross pinpoints the position; short arrow shows the heading;
            # optional full-image dashed crosshair makes it findable at a glance
            c = (x - ox) / res - 0.5
            r = (y - oy) / res - 0.5
            if crosshair:
                ax.axhline(r, color=color, lw=0.7, ls='--', alpha=0.35)
                ax.axvline(c, color=color, lw=0.7, ls='--', alpha=0.35)
            arrow_px = 0.8 / res
            ax.annotate('', xy=(c + arrow_px * math.cos(yaw),
                                r + arrow_px * math.sin(yaw)),
                        xytext=(c, r),
                        arrowprops=dict(arrowstyle='-|>', color=color,
                                        lw=1.8, shrinkA=0, shrinkB=0))
            ax.plot(c, r, marker='+', color=color, ms=15, mew=2.5,
                    label=label, zorder=5)

        bx, by, byaw = best_xyyaw
        draw_pose(bx, by, byaw, '#1e6fff', 'best hypothesis', crosshair=True)
        if cur is not None:
            draw_pose(cur[0], cur[1], cur[2], 'red', 'current pose')
        ax.legend(loc='upper right')
        ax.set_axis_off()
        buf = io.BytesIO()
        fig.savefig(buf, format='png', dpi=90, bbox_inches='tight')
        plt.close(fig)
        msg = CompressedImage()
        msg.header.stamp = rospy.Time.now()
        msg.format = 'png'
        msg.data = buf.getvalue()
        self.pub_heatmap.publish(msg)

    # ---- triggers ---------------------------------------------------------------

    def _run_compute(self, with_heatmap):
        self._set_status('computing...')
        try:
            r = self.compute(with_heatmap=with_heatmap)
            self._set_status('ok %.2fs margin %.0f%%' % (r['compute_s'], r['margin'] * 100))
            if self.auto_apply and r['margin_ok']:
                self._do_apply(r, why='auto')
            return r, None
        except Exception as e:
            rospy.logwarn('[gloc] compute failed: %s', e)
            self._set_status('error: %s' % e)
            return None, str(e)

    def cb_compute(self, msg):
        threading.Thread(target=self._run_compute,
                         args=(msg.data != 'no_heatmap',), daemon=True).start()

    def srv_localize(self, _req):
        r, err = self._run_compute(with_heatmap=True)
        if r is None:
            return TriggerResponse(success=False, message=err)
        return TriggerResponse(success=True, message=json.dumps(r))

    def cb_apply(self, msg):
        r = self._last_result
        if r is None:
            rospy.logwarn('[gloc] apply requested but no result yet')
            return
        force = (msg.data == 'force')
        if not r.get('apply_ok', r['margin_ok']) and not force:
            why = ('margin %.0f%% < gate %.0f%%' % (r['margin'] * 100,
                                                    self.apply_min_margin * 100)
                   if not r['margin_ok'] else
                   'candidate yaw deviates > %.0f deg from current heading '
                   '(mirror alias?)' % math.degrees(self.apply_max_yaw_dev))
            rospy.logwarn("[gloc] apply REFUSED: %s (publish 'force' to override)", why)
            self._set_status('apply refused: %s' % why)
            return
        self._do_apply(r, why='force' if force else 'manual')

    def _do_apply(self, r, why):
        out = PoseWithCovarianceStamped()
        out.header.stamp = rospy.Time.now()
        out.header.frame_id = self.map_frame
        out.pose.pose.position.x = r['best']['x']
        out.pose.pose.position.y = r['best']['y']
        qx, qy, qz, qw = quaternion_from_euler(0, 0, math.radians(r['best']['yaw_deg']))
        out.pose.pose.orientation.x = qx
        out.pose.pose.orientation.y = qy
        out.pose.pose.orientation.z = qz
        out.pose.pose.orientation.w = qw
        out.pose.covariance = self._apply_cov
        self.pub_initialpose.publish(out)
        self._set_status('APPLIED (%s) -> rtabmap initialpose (%.2f, %.2f, %.1fdeg)'
                         % (why, r['best']['x'], r['best']['y'], r['best']['yaw_deg']))
        rospy.loginfo('[gloc] APPLIED (%s) -> /rtabmap/initialpose (%.2f, %.2f, %.1fdeg)',
                      why, r['best']['x'], r['best']['y'], r['best']['yaw_deg'])


