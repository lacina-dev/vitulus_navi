#!/usr/bin/env python3
"""dock_idle — CPU relief while docked (AUDIT 2026-08-01, phase 2).

Runtime measurement with the robot parked in the dock showed load avg 15.9:
vo_rgbd_odometry at ~107 % CPU (full RGBD VO in the dark, output unused) and
lidar_icp_odometry burning cycles the same way, while move_base_flex missed
its own 10 Hz map-update loop. Neither odometry contributes anything while the
robot is physically latched in the dock.

This node watches /dock_smach/dock_status (0=docked, 1=undocking, 2=docking,
3=undocked, 5=unknown; latched) and:
  - after the robot has been DOCKED continuously for ~dock_hold_s, calls the
    pause services of both visual and lidar odometry (remapped per-node:
    /vo/pause_odom, /licp/pause_odom — the raw rtabmap names collide);
  - the INSTANT the status leaves 0 (undocking starts before any wheel moves),
    calls the resume services, so the odometries are live again well before
    the robot leaves the dock.

Safety posture: resume is also attempted on node shutdown and re-attempted
with a throttled warn if a service is unavailable. ~enable=false turns the
whole node into a no-op. State is latched on /dock_idle/status as JSON.

T39 (2026-11-18) — LOST VISUAL ODOMETRY, ~vo_lost_pause (default FALSE):
at night the RGBD VO is lost on every frame (2 400-3 700 automatic resets per
10 min drive), every message it publishes carries the 9999 "lost" covariance
that the navigation EKF weights to nothing, and it still burns ~0.8 core.
With the switch on, this node (the one owner of /vo/pause_odom) also watches
/vo/odom outside the dock: when at most ~vo_lost_max_good_frac of the messages
of the last ~vo_lost_window_s had a usable twist covariance, the VO is paused;
every ~vo_lost_retry_s it is resumed for ~vo_lost_probe_s and stays running if
it tracks again. Only the VO is touched (the camera, depth_obstacles and the
lidar odometry are not). The dock pause wins: while it holds, the lost watch
is idle, and leaving the dock resumes everything and starts the watch afresh.
~vo_lost_dry_run:=true evaluates and reports but never calls a service.
A742 — ~resume_on_start (default TRUE): a new instance cannot know whether the
previous one died while it held the dock pause. It owes ONE resume of both
odometries: paid the moment the dock status is anything but docked (at the
start or on undocking before this instance paused them itself), or after
~resume_on_start_timeout_s without any dock status; dropped once this instance
has made its own dock pause. In the dock nothing is called at the start.
Before, a robot that undocked within ~dock_hold_s of a dock_idle restart drove
with VO and lidar odometry still paused.
A739: no lock is held across a service call (the wake-up on undocking never
waits for the watch); at its start, and when the VO has been silent for a whole
window, the node resumes the VO once (a previous instance may have died holding
the pause); while the watch holds the pause the VO node's logger is at ERROR
(~vo_lost_quiet_log, the paused node otherwise warns "Did not receive data
since 5 seconds!" 720 times an hour) and back at ~vo_logger_level_run after.
With the switch off nothing is subscribed and the node behaves as before.
"""

import json
import threading
import time
from collections import deque

import rospy
from nav_msgs.msg import Odometry
from roscpp.srv import SetLoggerLevel
from std_msgs.msg import Int8, String
from std_srvs.srv import Empty

DOCKED = 0


def vo_twist_usable(cov, bad_cov):
    """A /vo/odom message the EKF can use: the variances of the two fused twist
    axes (vx = [0], vyaw = [35]) are finite, positive and below ~bad_cov.
    rtabmap publishes 9999 on a lost frame and on the first frame after a
    reset (no velocity guess)."""
    try:
        vx, vyaw = float(cov[0]), float(cov[35])
    except (IndexError, TypeError, ValueError):
        return False
    return 0.0 < vx < bad_cov and 0.0 < vyaw < bad_cov   # NaN fails both


class VoLostWatch(object):
    """Decides when a permanently lost VO is paused and when it is tried again.
    No ROS in here: the caller feeds message arrivals and a clock and carries
    out the returned action ('pause' / 'resume' / None)."""

    RUN, PAUSED, PROBE = 'run', 'paused', 'probe'
    EXTERNAL_GRACE_S = 1.5     # messages still in flight right after a pause
    EXTERNAL_MSGS = 5          # this many later ones = somebody resumed the VO

    def __init__(self, window_s=30.0, max_good_frac=0.2, min_msgs=30,
                 retry_s=90.0, probe_s=8.0, settle_s=2.0):
        self.window_s = max(1.0, float(window_s))
        self.max_good_frac = min(1.0, max(0.0, float(max_good_frac)))
        self.min_msgs = max(1, int(min_msgs))
        self.retry_s = max(5.0, float(retry_s))
        self.probe_s = max(1.0, float(probe_s))
        self.settle_s = min(max(0.0, float(settle_s)), self.probe_s * 0.5)
        self.pauses = 0
        self.probes_ok = 0
        self.last_frac = None
        self.reset(0.0)

    def reset(self, t):
        """Back to plain watching (start, dock pause, leaving the dock)."""
        self.state = self.RUN
        self.since = float(t)          # when the current state began
        self.samples = deque()         # (t, usable)
        self.stray = 0                 # messages seen while PAUSED
        self.last_msg = None           # arrival of the last message (any state)
        self.silence_done = False      # the one resume of a silent VO was asked

    def on_msg(self, t, usable):
        self.last_msg = float(t)
        self.silence_done = False
        if self.state == self.PAUSED:
            if t - self.since > self.EXTERNAL_GRACE_S:
                self.stray += 1
            return
        if self.state == self.PROBE and t - self.since < self.settle_s:
            return                     # first frames after a resume: init only
        self.samples.append((float(t), bool(usable)))

    def _frac(self):
        n = len(self.samples)
        if not n:
            return None, 0
        return sum(1 for _t, ok in self.samples if ok) / float(n), n

    def step(self, t):
        if self.state == self.RUN:
            while self.samples and self.samples[0][0] < t - self.window_s:
                self.samples.popleft()
            frac, n = self._frac()
            self.last_frac = frac
            if (t - self.since >= self.window_s and n >= self.min_msgs
                    and frac <= self.max_good_frac):
                self._to(self.PAUSED, t)
                self.pauses += 1
                return 'pause'
            # A VO that should run and has been silent for a whole window may
            # be paused by someone this watch does not know about (a previous
            # dock_idle that died holding the pause): ask for one resume, the
            # safe direction. Once per silence; a dead VO just stays silent.
            quiet_from = self.since if self.last_msg is None else max(self.since, self.last_msg)
            if not self.silence_done and t - quiet_from >= self.window_s:
                self.silence_done = True
                return 'resume'
            return None
        if self.state == self.PAUSED:
            if self.stray >= self.EXTERNAL_MSGS:
                self.reset(t)          # resumed by someone else / VO respawned
                return None
            if t - self.since >= self.retry_s:
                self._to(self.PROBE, t)
                return 'resume'
            return None
        # PROBE
        if t - self.since < self.probe_s:
            return None
        frac, n = self._frac()
        self.last_frac = frac
        if n and frac > self.max_good_frac:
            self.probes_ok += 1
            self.state, self.since = self.RUN, float(t)   # keeps the samples
            return None
        self._to(self.PAUSED, t)
        self.pauses += 1
        return 'pause'

    def _to(self, state, t):
        self.state, self.since = state, float(t)
        self.samples.clear()
        self.stray = 0

    def status(self):
        return {'state': self.state, 'pauses': self.pauses,
                'probes_ok': self.probes_ok,
                'good_frac': None if self.last_frac is None else round(self.last_frac, 3)}


class DockIdle(object):
    def __init__(self):
        self.enable = bool(rospy.get_param('~enable', True))
        self.hold_s = float(rospy.get_param('~dock_hold_s', 20.0))
        # service pairs to pause/resume, in call order
        self.pause_srvs = rospy.get_param(
            '~pause_services', ['/vo/pause_odom', '/licp/pause_odom'])
        self.resume_srvs = rospy.get_param(
            '~resume_services', ['/vo/resume_odom', '/licp/resume_odom'])
        self.paused = False
        self.docked_since = None
        # A742: one resume owed after a (re)start, see the module docstring
        self.resume_owed = self.enable and bool(rospy.get_param('~resume_on_start', True))
        self.resume_timeout_s = float(rospy.get_param('~resume_on_start_timeout_s', 10.0))
        self.status_seen = False
        self.started = time.time()
        # T39 lost-VO watch (default off = nothing subscribed, nothing changes)
        self.vo_lost_enable = bool(rospy.get_param('~vo_lost_pause', False))
        self.vo_dry_run = bool(rospy.get_param('~vo_lost_dry_run', False))
        self.vo_bad_cov = float(rospy.get_param('~vo_lost_bad_cov', 1000.0))
        self.vo_pause_srv = rospy.get_param('~vo_pause_service', '/vo/pause_odom')
        self.vo_resume_srv = rospy.get_param('~vo_resume_service', '/vo/resume_odom')
        # T39 A739: a paused rgbd_odometry warns "Did not receive data since 5
        # seconds!" every 5 s (rtabmap_sync SyncDiagnostic, logger of the
        # package, no parameter for it). While the WATCH holds the pause the
        # node's logger is raised to ERROR and put back on resume.
        self.vo_quiet_log = bool(rospy.get_param('~vo_lost_quiet_log', True))
        self.vo_logger_srv = rospy.get_param('~vo_logger_service',
                                             '/vo_rgbd_odometry/set_logger_level')
        self.vo_logger = rospy.get_param('~vo_logger_name', 'ros.rtabmap_odom')
        self.vo_logger_run = rospy.get_param('~vo_logger_level_run', 'warn')
        self.vo_watch = None
        self.vo_paused = False            # paused by the lost watch (not the dock)
        self.vo_resume_pending = False    # a resume call failed, try again
        self.vo_quieted = False           # the VO logger is (or may be) at ERROR
        self.vo_startup = False           # one resume owed at the start (see below)
        self.vo_epoch = 0                 # bumped whenever the dock takes/releases the VO
        # state only - NEVER held across a service call (A739: a 3 s wait for a
        # service in the lost watch must not delay the wake-up on undocking)
        self.vo_lock = threading.Lock()
        self.status_pub = rospy.Publisher('/dock_idle/status', String,
                                          queue_size=1, latch=True)
        rospy.Subscriber('/dock_smach/dock_status', Int8, self.cb_dock,
                         queue_size=2)
        rospy.Timer(rospy.Duration(2.0), self.tick)
        if self.vo_lost_enable:
            self.vo_watch = VoLostWatch(
                window_s=rospy.get_param('~vo_lost_window_s', 30.0),
                max_good_frac=rospy.get_param('~vo_lost_max_good_frac', 0.2),
                min_msgs=rospy.get_param('~vo_lost_min_msgs', 30),
                retry_s=rospy.get_param('~vo_lost_retry_s', 90.0),
                probe_s=rospy.get_param('~vo_lost_probe_s', 8.0))
            self.vo_watch.reset(time.time())
            # A739: a previous instance may have died (kill -9, crash) holding
            # the watch's pause and the quiet logger; this one cannot know.
            # Safe direction: the first tick outside the dock pause resumes the
            # VO and puts its logger back, then the watch judges afresh.
            self.vo_startup = not self.vo_dry_run
            self.vo_quieted = self.vo_quiet_log and not self.vo_dry_run
            rospy.Subscriber(rospy.get_param('~vo_odom_topic', '/vo/odom'), Odometry,
                             self.cb_vo_odom, queue_size=5)
            rospy.Timer(rospy.Duration(1.0), self.vo_tick)
        rospy.on_shutdown(self.on_shutdown)
        self._publish()
        rospy.loginfo('[dock_idle] up (enable=%s, hold=%.0fs, pause=%s, resume_on_start=%s, '
                      'vo_lost_pause=%s%s)', self.enable, self.hold_s, self.pause_srvs,
                      self.resume_owed, self.vo_lost_enable,
                      ' DRY RUN' if self.vo_lost_enable and self.vo_dry_run else '')

    # ---- dock state ---------------------------------------------------------
    def cb_dock(self, msg):
        self.status_seen = True
        if msg.data == DOCKED:
            if self.docked_since is None:
                self.docked_since = time.time()
        else:
            self.docked_since = None
            with self.vo_lock:
                was = self.paused
                owed, self.resume_owed = self.resume_owed, False
                if was:
                    self.paused = False
                if was or owed:
                    self._vo_watch_restart()
            if was or owed:
                # leaving the dock (undocking has begun) — wake the odometries
                # BEFORE any motion happens. `owed`: not docked and this
                # instance never paused them - a previous one may have.
                self._call_all(self.resume_srvs, 'resume' if was else 'resume(start)')
                self._publish()

    def tick(self, _evt):
        if (self.resume_owed and not self.status_seen
                and time.time() - self.started >= self.resume_timeout_s):
            with self.vo_lock:
                owed, self.resume_owed = self.resume_owed, False
            if owed:                   # dock state unknown: the safe direction
                rospy.logwarn('[dock_idle] no dock status %.0f s after the start - '
                              'resuming the odometries once', self.resume_timeout_s)
                self._call_all(self.resume_srvs, 'resume(start, no dock status)')
        if not self.enable or self.paused or self.docked_since is None:
            return
        if (time.time() - self.docked_since) >= self.hold_s:
            with self.vo_lock:
                self.paused = True
                self.resume_owed = False   # from here on the pause is our own
                self._vo_watch_restart()
            self._call_all(self.pause_srvs, 'pause')
            with self.vo_lock:
                left = not self.paused
            if left:
                # undocking began while the pause calls were on their way: the
                # resume of cb_dock may have landed first - wake them again
                self._call_all(self.resume_srvs, 'resume(after pause)')
            self._publish()

    # ---- lost VO (T39, ~vo_lost_pause) ---------------------------------------
    def _vo_watch_restart(self):
        """The dock pause took over or ended: the lost watch starts afresh and
        no longer holds a pause of its own. Call with vo_lock held."""
        if self.vo_watch is not None:
            self.vo_watch.reset(time.time())
        self.vo_paused = False
        self.vo_resume_pending = False
        self.vo_startup = False
        self.vo_epoch += 1

    def cb_vo_odom(self, msg):
        ok = vo_twist_usable(msg.twist.covariance, self.vo_bad_cov)
        with self.vo_lock:
            self.vo_watch.on_msg(time.time(), ok)

    def vo_tick(self, _evt):
        todo = None
        with self.vo_lock:
            epoch = self.vo_epoch
            dock = self.paused
            before = self.vo_watch.state
            action = None
            if not dock:               # under the dock pause the watch is idle
                if self.vo_startup:
                    self.vo_startup = False
                    todo = 'resume'
                elif self.vo_resume_pending:
                    todo = 'resume'
                action = self.vo_watch.step(time.time())
                if action == 'pause':
                    self.vo_paused = not self.vo_dry_run
                    self.vo_resume_pending = False
                    todo = 'pause'
                elif action == 'resume':
                    self.vo_paused = False
                    todo = 'resume'
                elif before != self.vo_watch.state:
                    self.vo_paused = False
            after, frac = self.vo_watch.state, self.vo_watch.last_frac
            unquiet = self.vo_quieted and not self.vo_paused and todo != 'pause'
        # ---- service calls: no lock held from here on -------------------------
        if action == 'pause':
            rospy.loginfo('[dock_idle] VO lost (usable %s of the window) -> pause, '
                          'next try in %.0f s', frac, self.vo_watch.retry_s)
        elif before != after:
            rospy.loginfo('[dock_idle] VO %s -> %s (usable %s)', before, after, frac)
        ok = None
        if todo == 'pause':
            ok = self._vo_call(self.vo_pause_srv, 'pause')
            if ok and self._vo_log_level('error'):
                with self.vo_lock:
                    self.vo_quieted = True
        elif todo == 'resume':
            ok = self._vo_call(self.vo_resume_srv, 'resume')
        if unquiet and self._vo_log_level(self.vo_logger_run):
            with self.vo_lock:
                self.vo_quieted = self.vo_paused     # a new pause may have come
        if todo is not None:
            with self.vo_lock:
                moved = epoch != self.vo_epoch       # the dock took or released the VO
                dock_now = self.paused
                if not moved and todo == 'resume':
                    self.vo_resume_pending = not ok
            if moved and todo == 'pause' and not dock_now:
                # undocking resumed everything while this pause was on its way
                self._vo_call(self.vo_resume_srv, 'resume(after dock)')
                if self._vo_log_level(self.vo_logger_run):
                    with self.vo_lock:
                        self.vo_quieted = self.vo_paused
            elif moved and todo == 'resume' and dock_now:
                # the dock pause came while this resume was on its way
                self._vo_call(self.vo_pause_srv, 'pause(dock)')
        if todo is not None or before != after:
            self._publish()

    def _vo_call(self, name, what):
        if self.vo_dry_run:
            rospy.loginfo('[dock_idle] DRY RUN: would %s the VO via %s', what, name)
            return True
        try:
            rospy.wait_for_service(name, timeout=3.0)
            rospy.ServiceProxy(name, Empty)()
            rospy.loginfo('[dock_idle] vo_lost %s -> %s', what, name)
            return True
        except Exception as e:
            rospy.logwarn_throttle(
                30.0, '[dock_idle] vo_lost %s via %s failed: %s', what, name, e)
            return False

    def _vo_log_level(self, level):
        """Level of the VO node's package logger; True when set (or not wanted)."""
        if not self.vo_quiet_log or self.vo_dry_run:
            return True
        try:
            rospy.wait_for_service(self.vo_logger_srv, timeout=1.0)
            rospy.ServiceProxy(self.vo_logger_srv, SetLoggerLevel)(self.vo_logger, level)
            return True
        except Exception as e:
            rospy.logwarn_throttle(
                60.0, '[dock_idle] VO logger %s -> %s failed: %s', self.vo_logger, level, e)
            return False

    # ---- plumbing -----------------------------------------------------------
    def _call_all(self, names, what):
        for name in names:
            try:
                rospy.wait_for_service(name, timeout=3.0)
                rospy.ServiceProxy(name, Empty)()
                rospy.loginfo('[dock_idle] %s -> %s', what, name)
            except Exception as e:
                rospy.logwarn_throttle(
                    30.0, '[dock_idle] %s via %s failed: %s', what, name, e)

    def _publish(self):
        st = {'enabled': self.enable, 'paused': self.paused}
        if self.vo_watch is not None:     # keys appear only with the switch on
            st['vo_lost'] = dict(self.vo_watch.status(), paused=self.vo_paused,
                                 dry_run=self.vo_dry_run)
        self.status_pub.publish(String(json.dumps(st)))

    def on_shutdown(self):
        if self.paused:
            self._call_all(self.resume_srvs, 'resume(shutdown)')
        elif self.vo_paused or self.vo_resume_pending:
            self._vo_call(self.vo_resume_srv, 'resume(shutdown)')
        if self.vo_watch is not None and self.vo_quieted:
            self._vo_log_level(self.vo_logger_run)


if __name__ == '__main__':
    rospy.init_node('dock_idle')
    DockIdle()
    rospy.spin()
