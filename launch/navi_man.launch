<launch>

<!-- Vitulus costmap launch file -->
<include file="$(find vitulus_local_costmap)/launch/local_costmap.launch" />

    <arg name="arg_ns" default="/"/>
    <group ns="$(arg arg_ns)">
        <node name="navi_man" pkg="vitulus_navi" type="navi_man" respawn="true" respawn_delay="1" output="screen" />
<!--            <param name="prm_name" value="prm_value"/>-->
<!--            <remap from="/topic" to="/another_topic" />-->
        <!-- </node> -->
        <node name="navi_transform" pkg="vitulus_navi" type="navi_transform" respawn="true" respawn_delay="1" output="log">
            <!-- 2026-08-02 field fix: spread cap musi pojmout realny sum vzorku
                 (sigma 1.2-1.6 deg) — 1.5 deg okno NIKDY neproslo (vecny freeze).
                 6 deg = ~2.5 sigma; multipath rampu (>1 deg/s) chyti i tak. -->
            <param name="heading_anchor_spread_max_deg" value="6.0"/>
            <!-- DOCKFIX-2026-08-29 — dock localization hardening.
                 A2 continuous dock hold: while docked (debounced) map->odom is
                 recomputed every 30 Hz tick from the "docked" waypoint composed
                 with the live odom->base, so the docked pose IS the waypoint and
                 cannot drift between the old 5 s re-anchor pulses.
                 ROLLBACK: dock_anchor_enable:=false (back to pulse re-anchor). -->
            <param name="dock_anchor_enable" value="true"/>
            <param name="dock_anchor_debounce_s" value="2.0"/>
            <param name="dock_anchor_max_hold_m" value="3.0"/>
            <!-- A3: no non-dock source may write map->odom around dock ops
                 (was tracker-only); micro refinements still pass.
                 ROLLBACK: dock_gate_non_dock:=false -->
            <param name="dock_gate_non_dock" value="true"/>
            <param name="dock_micro_m" value="0.05"/>
            <param name="dock_micro_deg" value="1.0"/>
            <!-- Fail-closed dock feed: absent/stale 10 Hz dock_status keeps the
                 suppression ON instead of opening the gates.
                 ROLLBACK: dock_status_fail_closed:=false -->
            <param name="dock_status_fail_closed" value="true"/>
            <param name="dock_status_stale_s" value="5.0"/>
            <!-- Drift-budget ratchet: only dock/GPS anchors reset the budget; a
                 tracker correction consumes it (it used to refill it).
                 ROLLBACK: tracker_budget_ratchet:=false -->
            <param name="tracker_budget_ratchet" value="true"/>
        </node>
        <!-- lidar global localization scorer (passive; apply is margin-gated) -->
        <node name="gloc_server" pkg="vitulus_navi" type="gloc_server" respawn="true" respawn_delay="2" output="log">
            <!-- EDT tracker localizes against the served mapping-v3 site raster -->
            <param name="map_topic" value="/mapping_manager/site_map"/>
            <!-- 2026-07-19 INCIDENT: auto-relock teleported the pose 4.68 m on
                 the new DIRECT raster — its sparse obstacle landscape inflates
                 relative margins (337% on a false lock) and the baseline rms is
                 ~3x higher than on band rasters, so the lost->relock chain is
                 unsafe. DISABLED until the scorer is recalibrated for direct
                 rasters with an ABSOLUTE quality gate + external corroboration
                 (RTK/dock) for big-delta applies.
                 RELOCK V2 (2026-08-02) is now implemented: plausibility-radius
                 search gate + rms+overlap absolute quality + motion-verified
                 PROBATION before any apply (big jumps = extended probation).
                 Flip to true for the courtyard kidnap field test; keep false
                 until that test passes. -->
            <param name="relock_enable" value="false"/>
            <!-- DOCKFIX-2026-08-29 — MAP-STALENESS GATES ON THE APPLY PATH.
                 (A) the minimum must sit on mapped structure; (B) a correction
                 above prior_margin_above_m must beat the BEST-KNOWN pose by
                 prior_margin_frac in rms without losing overlap. A changed
                 garden then degrades to "reject correction" instead of
                 "confidently wrong".
                 ROLLBACK: track_overlap_apply_gate:=false and/or
                           track_prior_margin_enable:=false -->
            <param name="track_overlap_apply_gate" value="true"/>
            <param name="track_overlap_min_apply" value="0.5"/>
            <param name="track_prior_margin_enable" value="true"/>
            <param name="track_prior_margin_frac" value="0.8"/>
            <param name="track_prior_margin_above_m" value="0.15"/>
            <!-- R5: relock + manual /gloc/apply get their own, budget-exempt
                 source tag instead of masquerading as the tracker. -->
            <param name="relock_pose_topic" value="/nav_tf/set_map_pose_relock"/>
        </node>
        <!-- AUDIT dock-idle (2026-08-01): pauses VO+ICP odometry while docked
             (load avg 15.9 in the dock, VO alone >1 core in the dark); resumes
             the instant undocking begins. ~enable:=false = no-op rollback. -->
        <node name="dock_idle" pkg="vitulus_navi" type="dock_idle" respawn="true" respawn_delay="2" output="log">
        </node>
    </group>

    <node name="node_mower_smach" pkg="vitulus_navi" type="mower_unit_smach" respawn="true" respawn_delay="1" output="log">
        <!-- Rain gating + other config: see config/mower_smach.yaml and helpers.get_weather_config -->
        <rosparam command="load" file="$(find vitulus_navi)/config/mower_smach.yaml"/>
    </node>
    <node name="node_smach_exe_path" pkg="vitulus_navi" type="smach_exe_path" respawn="true" respawn_delay="1" output="log" />
    <node name="node_exe_goal" pkg="vitulus_navi" type="smach_exe_goal" respawn="true" respawn_delay="1" output="log" />

    <include file="$(find vitulus_navi)/launch/topic_tools.launch"/>

</launch>
