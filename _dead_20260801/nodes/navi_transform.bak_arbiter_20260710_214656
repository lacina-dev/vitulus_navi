    def callback_set_pose(self, msg):
        rospy.logdebug("Set pose: %s" % msg.pose.pose)
        self.set_nav_pose(msg.pose.pose)
        self.set_wheel_base_nav_pose(msg.pose.pose)

    def callback_set_dock_pose(self, msg):
        if msg.data:
            rospy.wait_for_service('/navi_manager/get_point_pose')
            try:
                srv = rospy.ServiceProxy('/navi_manager/get_point_pose', Point_pose)  # Connect to the service
                response = srv("dock")
                if response.result:
                    rospy.logdebug("Dock point pose: %s" % response.point_pose)
                    self.set_nav_pose(response.point_pose.pose)
                    self.set_wheel_base_nav_pose(response.point_pose.pose)
                else:
                    rospy.logwarn("Dock point pose not found.")
            except rospy.ServiceException as e:
                rospy.logerr("Service /navi_manager/get_point_pose call failed: %s" % e)

    def _gps_stable(self):
        """GPS corrections allowed: position continuously usable for the
        acquisition-hysteresis window AND at least one good RTK heading seen
        since acquisition (the fused heading / navsat datum is heading-dependent
        — position-only stability still produced a brief jump, drive 3).
        NEVER while DOCKED: the dock bay is a known multipath trap — RTK there
        occasionally passes the covariance gates with confident garbage and
        yanked the pose 2.4 m (2026-07-05 night); the dock anchor + rtabmap own
        the pose at the dock.
        GPS-FIRST ARBITER (2026-07-06, user directive — REVERSES the
        2026-07-05 ownership pivot): GPS with quality is the MAIN pose
        authority; rtabmap/odometry substitute only while GPS lacks quality
        (typical cycle here: open lawn <-> roofed area with no GPS). A
        confident rtabmap may hold the pose ONLY until GPS has PROVEN
        itself in motion (_update_gps_probation: >= ~1 m wheel-odom travel
        with agreeing GPS distance) — parked multipath garbage near the
        roofed dock never proves itself, which keeps the 2026-07-05 trap
        covered without demoting GPS everywhere."""
        if self._docked:
            return False
        # UNIVERSAL probation (2026-07-06 evening, bag 21-36-30): GPS may
        # take pose ownership ONLY after proving itself in motion — a
        # PARKED robot near the roofed area got its pose grabbed by a
        # partially-fixed GPS (the rtabmap-only probation gate did not
        # cover it). Standing still never proves; ownership engages within
        # the first metre of driving on usable fix.
        if not self._gps_proven:
            return False
        return self._gps_good_since is not None and \
            (rospy.get_time() - self._gps_good_since) >= self._map_coords_hysteresis_s and \
            self._heading_good_after_acq

    def callback_set_map_pose(self, msg):
        """Drive the live map->odom from an external map-frame robot pose (rtabmap lidar
        localization when GPS is denied), FULL 2D pose incl. yaw:

            map->base = R(map_odom_yaw) . odom->base + t
            map_odom_yaw = wanted.yaw - odom->base.yaw
            t = wanted.xy - R(map_odom_yaw) . odom->base.xy

        We do NOT touch the odom-frame EKF (unlike the old set_pose bridge), so odom->base —
        rtabmap's own odometry input — is left alone and there is no feedback loop; the yaw
        correction lives purely in map->odom (drive-away heading fix without GPS). No-GPS
        gating lives in the caller (the dock seed bridge publishes only when gps_good==0),
        so this never fights callback_map_coords / the GNSS heading anchor (both reset
        map_odom_yaw to 0 when they take over)."""
        odom_base = self.get_base_link_transform()   # odom->base_link
        if odom_base is None:
            rospy.logwarn_throttle(5.0, "[set_map_pose] no odom->base_link TF yet — skipping")
            return
        # Rotation guard: the external pose (rtabmap localization) is measured
        # slightly in the past; applying it while spinning smears the pose.
        # Skip and let the next (post-rotation) correction land instead.
        wz = abs(self.ekf_wheel_nav_odom_msg.twist.twist.angular.z)
        if wz > self._set_map_pose_max_wz:
            rospy.loginfo_throttle(5.0, "[set_map_pose] rotating (%.2f rad/s) — deferring "
                                        "external correction", wz)
            return
        # Full 2D correction: map->base = R(map_odom_yaw) * odom->base + t.
        # Yaw first (t depends on it): map yaw = map_odom_yaw + odom->base yaw.
        wanted_yaw = euler_from_quaternion([msg.pose.orientation.x, msg.pose.orientation.y,
                                            msg.pose.orientation.z, msg.pose.orientation.w])[2]
        ob_q = odom_base.transform.rotation
        odom_yaw = euler_from_quaternion([ob_q.x, ob_q.y, ob_q.z, ob_q.w])[2]
        m = math.atan2(math.sin(wanted_yaw - odom_yaw), math.cos(wanted_yaw - odom_yaw))
        self.map_odom_yaw = m
        ob_x = odom_base.transform.translation.x
        ob_y = odom_base.transform.translation.y
        self.map_odom_transform.transform.translation.x = msg.pose.position.x - (math.cos(m) * ob_x - math.sin(m) * ob_y)
        self.map_odom_transform.transform.translation.y = msg.pose.position.y - (math.sin(m) * ob_x + math.cos(m) * ob_y)
        rospy.loginfo_throttle(5.0,
            "[set_map_pose] map->odom set from external map pose (%.2f, %.2f, %.1fdeg) -> "
            "t=(%.2f, %.2f) yaw=%.2fdeg",
            msg.pose.position.x, msg.pose.position.y, math.degrees(wanted_yaw),
            self.map_odom_transform.transform.translation.x,
            self.map_odom_transform.transform.translation.y, math.degrees(m))

    def callback_navi_indoor(self, msg):
        was_indoor = self.is_indoor
        self.is_indoor = msg.data
        rospy.loginfo_throttle(10, f"[navi_transform] is_indoor={self.is_indoor}")
        if was_indoor and not self.is_indoor:
            # Transitioning indoor→outdoor: restart navsat_transform_node so it
            # re-initialises with the current (accurate, post-stabilisation) GPS.
            # Without this, navsat could have been initialised near the dock where
            # GPS multipath causes a systematic ~1 m bias in the utm→odom TF.
            rospy.logwarn("[navi_transform] Indoor→outdoor transition detected: "
                          "restarting navsat_transform for fresh GPS datum away from dock.")
            if self.launch_navsat is not None:
                try:
                    self.launch_navsat.shutdown()
                    rospy.loginfo("[navi_transform] navsat_transform stopped — will relaunch on next init_navsat() call")
                except Exception as e:
                    rospy.logwarn(f"[navi_transform] Error stopping navsat: {e}")
                self.launch_navsat = None
            else:
                rospy.loginfo("[navi_transform] navsat_transform was not running — will launch fresh on GPS ready")

    # ---- persistent site georeference (POSE_DATUM_PLAN phase 1b) ------------
    def _load_site_datum(self):
        """(Re)load the site datum captured by mapping v3 into a synthetic
        map_coords PoseStamped. Returns silently when absent/unchanged."""
        try:
            path = os.path.realpath(self._site_datum_file)
            mtime = os.path.getmtime(path)
        except OSError:
            return
        if mtime == self._site_datum_mtime:
            return
        try:
            with open(path) as f:
                d = yaml.safe_load(f)
            ps = PoseStamped()
            ps.header.frame_id = 'utm'
            ps.pose.position.x = float(d['utm_e'])
            ps.pose.position.y = float(d['utm_n'])
            ps.pose.position.z = float(d.get('alt', 0.0))
            q = quaternion_from_euler(0, 0, float(d.get('yaw_rad', 0.0)))
            ps.pose.orientation.x = q[0]
            ps.pose.orientation.y = q[1]
            ps.pose.orientation.z = q[2]
            ps.pose.orientation.w = q[3]
            self._site_datum = ps
            self._site_datum_mtime = mtime
            rospy.logwarn('[navi_transform] site datum loaded from %s: '
                          'utm=(%.2f, %.2f) alt=%.2f yaw=%.2fdeg',
                          path, ps.pose.position.x, ps.pose.position.y,
                          ps.pose.position.z,
                          math.degrees(float(d.get('yaw_rad', 0.0))))
        except Exception as e:
            rospy.logwarn('[navi_transform] site datum load failed: %s', e)

    def maybe_apply_site_datum(self):
        """Called at 1 Hz (loop1hz): when no LIVE nonzero map_coords georef
        exists but a site datum does, feed the datum through the normal
        georef path so GPS can own map->odom without a loaded navi map."""
        self._load_site_datum()
        if self._site_datum is None:
            return
        if rospy.get_time() - self._map_coords_rx_t < 10.0:
            return                    # live navi-map georef owns it
        self.callback_map_coords(self._site_datum, from_datum=True)

    def callback_map_coords(self, msg, from_datum=False):
        # GPS georef may own map->odom ONLY while the GPS position is USABLE and
        # has been stable for a few seconds. Without this gate, once navsat has
        # ever established utm->odom, every map_coords message re-pinned map->odom
        # from a possibly bad/multipath datum even with gps_good=0 — overwriting
        # the GPS-denied external corrections (rtabmap bridge /nav_tf/set_map_pose)
        # — and RTK flapping (observed 38 flips/2 min in rain) toggled ownership
        # and yanked the pose around ("caught one GPS -> thrown elsewhere").
        zero = (msg.pose.position.x + msg.pose.position.y
                + msg.pose.position.z) == 0
        if not from_datum and not zero:
            self._map_coords_rx_t = rospy.get_time()
        if zero:
            # Never derive a georef from a zero/null message (its yaw comes
            # from a null quaternion). Pose stays with dock/odometry until a
            # real georef or the site datum takes over.
            self.map_coords_msg = msg
            return
        if not self._gps_stable():
            self.map_coords_msg = msg
            return
        trans = None
        try:
            trans = self.tf2_Buffer.lookup_transform('utm', 'odom', rospy.Time(0))
        except:
            trans = None

        if trans is not None:
            map_roll, map_pitch, map_yaw = euler_from_quaternion(
                [msg.pose.orientation.x, msg.pose.orientation.y, msg.pose.orientation.z, msg.pose.orientation.w])
            odom_roll, odom_pitch, odom_yaw = euler_from_quaternion([trans.transform.rotation.x,
                                                                     trans.transform.rotation.y,
                                                                     trans.transform.rotation.z,
                                                                     trans.transform.rotation.w])
            yaw_offset = odom_yaw - map_yaw
            quaternion = quaternion_from_euler(map_roll, map_pitch, yaw_offset)

            p_x = 0
            p_y = 0
            p_z = 0

            if (msg.pose.position.x + msg.pose.position.y + msg.pose.position.z) != 0:
                p_x = trans.transform.translation.x - msg.pose.position.x
                p_y = trans.transform.translation.y - msg.pose.position.y
                p_z = trans.transform.translation.z - msg.pose.position.z

            rospy.loginfo_throttle(5,
                f"[map->odom] utm_odom=({trans.transform.translation.x:.3f}, {trans.transform.translation.y:.3f}) "
                f"utm_map=({msg.pose.position.x:.3f}, {msg.pose.position.y:.3f}) "
                f"map_odom=({p_x:.3f}, {p_y:.3f}) "
                f"yaw_diff={math.degrees(yaw_offset):.2f}deg "
                f"navsat_running={self.launch_navsat is not None}")

            # SLEW toward the georef target instead of snapping (POSE_DATUM_PLAN
            # phase 3): with the site-datum path this callback runs at ~1 Hz,
            # so a snap here re-pinned map->odom visibly. Rate-limit the
            # translation approach; only a kidnap-size mismatch snaps.
            now_g = rospy.get_time()
            cur = self.map_odom_transform.transform.translation
            d_x, d_y, d_z = p_x - cur.x, p_y - cur.y, p_z - cur.z
            dist_g = math.hypot(d_x, d_y)
            first = self._georef_last_t is None
            if not first and dist_g <= self._georef_kidnap_m:
                dt_g = min(now_g - self._georef_last_t, 3.0)
                max_step = self._georef_slew_mps * max(dt_g, 0.1)
                if dist_g > max_step:
                    s = max_step / dist_g
                    p_x, p_y, p_z = cur.x + d_x * s, cur.y + d_y * s, cur.z + d_z * s
            elif not first:
                rospy.logwarn('[map->odom] georef mismatch %.2f m > kidnap '
                              '%.2f m — snapping', dist_g, self._georef_kidnap_m)
            self._georef_last_t = now_g

            map_odom_transform = TransformStamped()
            map_odom_transform.header.stamp = rospy.Time.now()
            map_odom_transform.header.frame_id = "map"
            map_odom_transform.child_frame_id = "odom"
            map_odom_transform.transform.translation.x = p_x
            map_odom_transform.transform.translation.y = p_y
            map_odom_transform.transform.translation.z = p_z
            map_odom_transform.transform.rotation.x = quaternion[0]
            map_odom_transform.transform.rotation.y = quaternion[1]
            map_odom_transform.transform.rotation.z = quaternion[2]
            map_odom_transform.transform.rotation.w = quaternion[3]

            self.map_odom_transform = map_odom_transform
            # GPS georef owns map->odom again -> drop the GPS-denied yaw correction
            # (its translation math above assumes the identity-rotation broadcast).
            self.map_odom_yaw = 0.0
        self.map_coords_msg = msg

