    def callback_rtabmap_settings_set(self, msg):
        rospy.set_param('/rtabmap/rtabmap/Grid/Sensor', msg.grid_sensor)
        rospy.set_param('/rtabmap/rtabmap/Grid/RangeMax', msg.grid_sensor_distance)
        # rtabmap may be out of map-making (RTABMAP_MAPPING not running) — the
        # update_parameters service then never appears. Bound the wait so this
        # UI-triggered callback cannot hang the callback thread forever.
        try:
            rospy.wait_for_service('/rtabmap/update_parameters', timeout=3.0)
            srv = rospy.ServiceProxy('/rtabmap/update_parameters', Empty)  # Connect to the service
            response = srv()
        except rospy.ROSException:
            rospy.logwarn("rtabmap /update_parameters unavailable (RTABMAP_MAPPING not "
                          "running?) — Grid settings stored as params only.")
        except rospy.ServiceException as e:
            rospy.logerr("Service /rtabmap/update_parameters call failed: %s" % e)

        self.rtabmap_settings_publish()

    def rtabmap_settings_publish(self):
        # With rtabmap out of map-making (localization v2), RTABMAP_MAPPING may not be
        # running, so /rtabmap/rtabmap/Grid/* params are absent. That is expected, not
        # an error — skip quietly (throttled debug) instead of spamming logerr every
        # tick. When rtabmap IS running (mapping / edit / new-map / rtabmap_on_start),
        # the params exist and settings publish as before.
        if not rospy.has_param('/rtabmap/rtabmap/Grid/Sensor'):
            rospy.logdebug_throttle(60.0, "rtabmap settings: /rtabmap params absent "
                                    "(RTABMAP_MAPPING not running) — skipping publish")
            return
        try:
            msg = Rtabmap_settings()
            msg.header.stamp = rospy.Time.now()
            msg.header.frame_id = "map"
            msg.grid_sensor = int(rospy.get_param('/rtabmap/rtabmap/Grid/Sensor'))
            msg.grid_sensor_distance = float(rospy.get_param('/rtabmap/rtabmap/Grid/RangeMax'))
            self.rtabmap_settings_pub.publish(msg)
        except Exception as e:
            rospy.logerr("Error publishing rtabmap settings: %s" % e)

