    def publish_map_point(self, name):
        point = self.running_map_data.get_map_point(name)
        if point:
            point.marker_message.header.stamp = rospy.Time.now()
            self.map_point_pub.publish(point.marker_message)

    def srv_cb_map_point_pose(self, srv):
        point = self.running_map_data.get_map_point(srv.name)
        if point:
            msg = PoseStamped()
            msg.header.stamp = rospy.Time.now()
            msg.header.frame_id = "map"
            msg.pose = point.pose
            self.map_point_pose_pub.publish(msg)
            resp = Point_poseResponse()
            resp.point_pose = msg
            resp.result = True
            return resp
        # Safe guard (dock-anchor): a map point with this name is NOT guaranteed to
        # exist. A map can be created/saved WITHOUT a "dock" point — the "dock" point
        # is only created when the dock workflow publishes name "dock" to
        # /navi_manager/save_waypoint at the dock; nothing forces it on map save.
        # Return a well-formed response with result=False (instead of None, which
        # would raise a ServiceException) so callers like the dock_localization_seed
        # node can branch cleanly on resp.result.
        rospy.logwarn("get_point_pose: point '%s' not found in current map "
                      "(running_map_data); returning result=False.", srv.name)
        resp = Point_poseResponse()
        resp.point_pose = PoseStamped()
        resp.point_pose.header.frame_id = "map"
        resp.result = False
        return resp


    def publish_map_point_list(self):
        # Order the point list
        point_list = self.running_map_data.get_map_point_list().split('|||')
        point_list.sort()
        point_list_str = '|||'.join(point_list)
        self.map_point_list_pub.publish(point_list_str)
        # self.map_point_list_pub.publish(self.running_map_data.get_map_point_list())


    def publish_map_point_str_list(self):
        msg = StringList()
        msg.header.stamp = rospy.Time.now()
        msg.header.frame_id = "map"
        sorted_points = sorted(self.running_map_data.points, key=lambda point: point.name)
        for point in sorted_points:
            msg.string_list.append(point.name)
        self.map_point_str_list_pub.publish(msg)

