        # WP2 (localization v2): magic constants -> ~params, defaults UNCHANGED.
        self._probation_tol_abs_m = float(rospy.get_param('~probation_tol_abs_m', 0.1))
        self._probation_tol_frac = float(rospy.get_param('~probation_tol_frac', 0.2))
        self._datum_live_window_s = float(rospy.get_param('~datum_live_window_s', 10.0))
        self._rtk_fresh_s = float(rospy.get_param('~rtk_fresh_s', 2.0))
        # WP2 (localization v2): source-tagged /nav_tf/set_map_pose arbitration.
        # Corrections arrive on per-source topics (dock/tracker/rtabmap) + the
        # legacy topic; a lower-priority source is REJECTED while a strictly
        # higher-priority one was accepted within ~map_pose_hold_s. Priority:
        # dock > tracker > rtabmap > legacy (index = priority rank, 0=highest).
        self._map_pose_hold_s = float(rospy.get_param('~map_pose_hold_s', 5.0))
        self._map_pose_priority = ('dock', 'tracker', 'rtabmap', 'legacy')
        # last accept time per source (for arbitration + loc_status observability)
        self._map_pose_last_accept = {s: 0.0 for s in self._map_pose_priority}
        # --- SMOOTH map-pose corrections (2026-07-12) ---------------------------
        # Field feedback: map localization works but the pose JUMPS — it "skips
        # between solutions it considers good" (tracker aliasing between near-equal
        # EDT minima). Bag maploc_test_2026-07-12: per-tick tracker corrections
        # median 0.03 m, p90 0.08 m, occasional 0.16-0.32 m, yaw p90 2.7deg, at
        # 1 Hz, applied EVERY tick (87% >=0.02 m, only 13% <0.02 m 'aligned') —
        # a non-converging cm-scale jitter, not monotone drift. Instead of
        # snapping map->odom to each tracker correction (visible cm-jumps every
        # second), SLEW the live transform toward the LAST tracker target,
        # bounded per-dt (mirrors the georef slew, POSE_DATUM_PLAN phase 3). Big
        # kidnap-size mismatches still snap so recovery is not blocked.
        # CORRECTNESS-FIRST (2026-07-12, field verdict): apply corrections FAST.
        # Slew 0.15->0.5 m/s and 5->15 deg/s so the tracker's 5 Hz corrections
        # land within a few ticks instead of crawling — the pose visibly "cuka"
        # but tracks the map instead of dead-reckoning. Still bounded (no teleport
        # through geometry); the >0.6 m / >15 deg kidnap snap is unchanged.
        self._map_pose_slew_mps = float(rospy.get_param('~map_pose_slew_mps', 0.5))
        self._map_pose_slew_dps = float(rospy.get_param('~map_pose_slew_dps', 15.0))
        # TWO-SPEED SLEW (2026-07-12b, live-under-roof feedback): at 0.5 m/s a
        # 8-15 cm tracker nudge lands in 1-3 ticks -> visible jerk ("mele to").
        # Quantitative margin: blind (no-correction) drift is <=2-3 cm/s
        # (0.06-0.18 m per 3s tick at <=0.4 m/s driving speed). The gentle rate
        # below (0.15 m/s = 15 cm/s) still applies corrections 5-7x FASTER than
        # they can be lost to drift, so smoothing small, routine corrections
        # cannot desync the pose from the map -- it only removes the visible
        # snap. Genuinely large deltas (relock/kidnap/recovery) still use the
        # fast 0.5 m/s / 15 deg/s rate above (and the >0.6 m / >15 deg path
        # snaps outright), so recovery speed after a real mismatch is unchanged.
        self._map_pose_gentle_below_m = float(rospy.get_param('~map_pose_gentle_below_m', 0.30))
        self._map_pose_slew_gentle_mps = float(rospy.get_param('~map_pose_slew_gentle_mps', 0.15))
        self._map_pose_slew_gentle_dps = float(rospy.get_param('~map_pose_slew_gentle_dps', 5.0))
        # rate actually applied by slew_map_pose() for the current target; chosen
        # once (per accepted correction) in callback_set_map_pose from the delta
        # size, so a small correction doesn't speed up mid-slew when a later
        # (still-small) update extends the target.
        self._map_pose_slew_active_mps = self._map_pose_slew_mps
        self._map_pose_slew_active_dps = self._map_pose_slew_dps
        # sources whose corrections are slewed (others apply instantly). 'dock' is
        # a one-shot precise anchor and MUST land instantly, so it is excluded.
        self._map_pose_slew_sources = set(
            rospy.get_param('~map_pose_slew_sources', ['tracker']))
        # a correction farther than this from the live transform snaps instead of
        # slewing (genuine relocalisation / kidnap; do not crawl 1 m at 0.15 m/s)
        self._map_pose_slew_snap_m = float(rospy.get_param('~map_pose_slew_snap_m', 0.6))
        self._map_pose_slew_snap_deg = float(rospy.get_param('~map_pose_slew_snap_deg', 15.0))
        # active slew target (tx, ty, target_yaw) or None; set by callback,
        # consumed by slew_map_pose() in the 30 Hz loop
        self._map_pose_target = None
        self._map_pose_slew_last_t = None
        self.fused_nav_time = int(str(rospy.Time.now())) / 1000000000
        self.fused_fix_time = int(str(rospy.Time.now())) / 1000000000
        self.init = True

        self.odometry_odom_pub = rospy.Publisher("/odometry/odom", Odometry, queue_size=100)
        self.odometry_for_gps_pub = rospy.Publisher("/odometry/for_gps", Odometry, queue_size=100)
        self.fused_nav_pub = rospy.Publisher("/gnss_heading/nav_fused", Imu, queue_size=100)
        self.base_link_imu_pub = rospy.Publisher("/bno085/imu_base_link", Imu, queue_size=100)
        self.marker_pub = rospy.Publisher("/gnss_heading/markers", MarkerArray, queue_size=1)
        self.yaws_pub = rospy.Publisher("/gnss_heading/yaws", Float32MultiArray, queue_size=1)
        self.wheel_odom_pub = rospy.Publisher("/nav_tf/odom_wheel", Odometry, queue_size=100)
        self.fused_odom_pub = rospy.Publisher("/nav_tf/odom_fused", Odometry, queue_size=100)
        self.nav_wheel_odom_pub = rospy.Publisher("/nav_tf/odom_wheel_nav", Odometry, queue_size=100)
        self.nav_odom_status_pub = rospy.Publisher("/nav_tf/odom_status", Navi_transform, queue_size=1)

        self.navheading_gnss_fix_sub = rospy.Subscriber("/gnss/fix", NavSatFix, self.callback_gnss_fix, queue_size=10)
        self.navheading_gnss_heading_fix_sub = rospy.Subscriber("/gnss_heading/fix", NavSatFix, self.callback_gnss_heading_fix, queue_size=10)
        self.navheading_rtk_sub = rospy.Subscriber("/gnss_heading/navheading", Imu, self.callback_navheading, queue_size=10)
        self.imu_sub = rospy.Subscriber("/bno085/imu", Imu, self.callback_imu, queue_size=200)
        self.wheel_odom_sub = rospy.Subscriber("/mobile_base_controller/odom", Odometry, self.callback_wheel_odom, queue_size=200)
        self.rtk_odom_sub = rospy.Subscriber("/odometry/gps", Odometry, self.callback_rtk_odom, queue_size=200)
        self.base_odom_sub = rospy.Subscriber("/odometry/odom", Odometry, self.callback_base_odom, queue_size=200)
        self.ekf_wheel_odom_sub = rospy.Subscriber("/odometry/ekf_wheel_odom", Odometry, self.callback_ekf_wheel_odom, queue_size=200)
        self.ekf_wheel_nav_odom_sub = rospy.Subscriber("/odometry/ekf_wheel_nav_odom", Odometry, self.callback_ekf_wheel_nav_odom, queue_size=200)
        self.map_coords_sub = rospy.Subscriber("/navi_manager/map_coords", PoseStamped, self.callback_map_coords)
        self.navi_indoor_sub = rospy.Subscriber("/navi_manager/is_indoor", Bool, self.callback_navi_indoor)
        self.set_pose_sub = rospy.Subscriber("/nav_tf/set_pose", PoseWithCovarianceStamped, self.callback_set_pose)
        self.set_dock_pose_sub = rospy.Subscriber("/nav_tf/set_dock_pose", Bool, self.callback_set_dock_pose)
        # Anchor the ABSOLUTE heading from an EXTERNAL map-frame yaw (Float64, radians). The
        # bno085 IMU is relative-only (no usable magnetometer), so the absolute reference is
        # supplied externally. Priority is handled by the CALLERS (each only sets when its
        # higher-priority source is unavailable): GNSS dual-antenna (offset_navheading_imu,
        # highest) > DOCK when docked + no satellite > later other sources (rtabmap, ...).
        self.set_heading_sub = rospy.Subscriber("/nav_tf/set_heading", Float64, self.callback_set_heading, queue_size=1)
        # External map-frame localization (e.g. rtabmap lidar) -> live map->odom DIRECTLY,
        # WITHOUT going through the odom-frame EKF set_pose. rtabmap reads its odom guess from
        # odom->base_link; the old dock bridge wrote that same EKF, so its correction moved
        # rtabmap's own input -> feedback loop (pose jumped 5+ m, never locked). Correcting
        # map->odom instead leaves odom->base untouched -> no feedback. Carries the FULL 2D
        # pose: xy translation + a map->odom yaw correction (map_odom_yaw; GPS-denied
        # drive-away heading fix). /nav_tf/set_heading remains for one-shot absolute
        # anchoring inside odom->base (dock).
        # Same priority rule as set_heading: callers publish ONLY when their higher-priority
        # source (GNSS) is unavailable, so this never fights the GPS map->odom path.
        self.set_map_pose_sub = rospy.Subscriber("/nav_tf/set_map_pose", PoseStamped, self.callback_set_map_pose, queue_size=1)
        # WP2 (localization v2): source-tagged map-pose corrections. Each source
        # routes into the SAME callback logic with its priority label; the arbiter
        # (see callback_set_map_pose) drops a lower-priority source while a
        # higher-priority one is fresh. Legacy /nav_tf/set_map_pose above stays as
        # source "legacy" (lowest priority) so existing publishers keep working.
        self.set_map_pose_dock_sub = rospy.Subscriber(
            "/nav_tf/set_map_pose_dock", PoseStamped,
            lambda m: self.callback_set_map_pose(m, source='dock'), queue_size=1)
        self.set_map_pose_tracker_sub = rospy.Subscriber(
            "/nav_tf/set_map_pose_tracker", PoseStamped,
            lambda m: self.callback_set_map_pose(m, source='tracker'), queue_size=1)
        self.set_map_pose_rtabmap_sub = rospy.Subscriber(
            "/nav_tf/set_map_pose_rtabmap", PoseStamped,
            lambda m: self.callback_set_map_pose(m, source='rtabmap'), queue_size=1)
        # docked truth (Int8, latched, 0 == docked) -> suppress GPS ownership at the dock
        from std_msgs.msg import Int8 as _Int8
        self.dock_status_sub = rospy.Subscriber("/dock_smach/dock_status", _Int8,
                                                lambda m: setattr(self, '_docked', int(m.data) == 0),
                                                queue_size=2)
        # ownership pivot: map owns the pose while rtabmap is confident
        self.rtabmap_conf_sub = rospy.Subscriber("/nav_tf/rtabmap_confident", Bool,
                                                 lambda m: setattr(self, '_rtabmap_confident', bool(m.data)),
                                                 queue_size=2)

        # --- vitulus_ui Phase 1: shadow bridge preview (Step A) ----------------
        # ADDITIVE / SHADOW ONLY: evaluates the VO (/vo/odom) and lidar
        # (/licp/odom) odometry as gated relative-motion sources for bridging
        # GPS-denied stretches, and publishes a *preview* pose + status. It does
        # NOT modify the live /odometry/odom or any TF. See update_bridge_preview.
        self.bridge_init_state()
        self.vo_odom_sub = rospy.Subscriber("/vo/odom", Odometry, self.callback_vo_odom, queue_size=50)
        self.licp_odom_sub = rospy.Subscriber("/licp/odom", Odometry, self.callback_licp_odom, queue_size=50)
        self.bridge_preview_pub = rospy.Publisher("/nav_tf/odom_bridge_preview", Odometry, queue_size=20)
        self.bridge_status_pub = rospy.Publisher("/nav_tf/bridge_status", String, queue_size=5)
        # WP2 (localization v2): typed status topic (JSON, latched) — owner +
        # health, so downstream stops string-parsing bridge_status. Published at
        # 1 Hz from loop1hz (see publish_loc_status).
        self.loc_status_pub = rospy.Publisher("/nav_tf/loc_status", String, queue_size=1, latch=True)
        # FIX4 (telemfix): edge-triggered loc_status. Baseline stays 1 Hz; on an
        # owner-change edge publish_loc_status is called immediately so an
