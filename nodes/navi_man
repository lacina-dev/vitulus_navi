    def shutdown_navi_launch(self):
        # Guard: called from ROS subscriber callbacks which may fire before __init__
        # finishes (latched topics delivered immediately on subscribe).
        if not hasattr(self, 'rtabmap_mapping'):
            rospy.logwarn("shutdown_navi_launch called before init complete — ignoring")
            return
        self.status_msg_pub.publish("Stopping navi module.")
        self.rtabmap_mapping.stop()
        if self.navi_launch is not None:
            self.navi_launch.shutdown()
        rospy.loginfo("Vitulus navi stopped.")
        self.status_msg_pub.publish("Vitulus navi stopped.")

    def container_watchdog(self):
        """Restart docker containers that SHOULD be running (cont_command set,
        not deliberately stopped) but died. rtabmap 0.21.4 segfaults starting
        under boot load (observed 2026-07-04, deterministic-ish race); a quiet
        retry succeeds. Rate-limited to one restart attempt per minute per
        container."""
        now = time.time()
        for conn in (self.rtabmap_mapping, self.rtabmap_obstacles, self.rtabmap_odom_sync):
            cmd = conn.cont_command
            if not cmd:
                continue
            try:
                status = conn.client.containers.get(conn.cont_name).status
            except Exception:
                status = 'absent'
            if status == 'running':
                continue
            last = self._wd_last_restart.get(conn.cont_name, 0)
            if now - last < 60.0:
                continue
            self._wd_last_restart[conn.cont_name] = now
            rospy.logwarn('[watchdog] container %s is %s -> restarting (%s)',
                          conn.cont_name, status, ' '.join(cmd[:3]))
            try:
                conn.run(list(cmd))
            except Exception as e:
                rospy.logerr('[watchdog] restart of %s failed: %s', conn.cont_name, e)

    def switch_rtabmap_to_mapping(self):
        """ Failure B fix helper. Switch an already-running, relocalized rtabmap
        container from LOCALIZATION mode to incremental MAPPING using the rtabmap
        runtime service (std_srvs/Empty; default /rtabmap/set_mode_mapping, the
        inverse of set_mode_localization). This preserves the loaded map id so new
        mapping connects to the existing graph, instead of relaunching the docker in
        mapping mode (which starts a NEW, disconnected map).

        Defensive / non-breaking: service name + timeouts are ROS params, the call
        is wrapped in try/except and NEVER raises. Returns True on success, False if
        the service is unavailable so the caller can fall back to the legacy relaunch.
        """
        srv_name = rospy.get_param('~set_mode_mapping_service', '/rtabmap/set_mode_mapping')
        wait_timeout = float(rospy.get_param('~set_mode_mapping_wait', 30.0))
        # Give rtabmap a chance to relocalize (loop closure / dock initialpose seed)
        # before flipping to mapping. We prefer a CONFIRMED relocalization (a message on
        # /rtabmap/localization_pose) over a blind sleep; on timeout we fall back to the
        # fixed settle so behaviour degrades gracefully and never blocks indefinitely.
        settle = float(rospy.get_param('~set_mode_mapping_settle', 5.0))
        reloc_topic = rospy.get_param('~reloc_pose_topic', '/rtabmap/localization_pose')
        try:
            rospy.wait_for_service(srv_name, timeout=wait_timeout)
            if settle > 0.0:
                rospy.loginfo("Waiting up to %.1fs for rtabmap to relocalize "
                              "(%s) before mapping...", settle, reloc_topic)
                try:
                    rospy.wait_for_message(reloc_topic, PoseWithCovarianceStamped,
                                           timeout=settle)
                    rospy.loginfo("rtabmap relocalization confirmed; switching to mapping.")
                except rospy.ROSException:
                    rospy.logwarn("No relocalization confirmed within %.1fs (no %s); "
                                  "switching to mapping anyway (visual loop closure may "
                                  "still merge later).", settle, reloc_topic)
            switch = rospy.ServiceProxy(srv_name, Empty)
            switch()
            rospy.loginfo("rtabmap switched to incremental mapping via %s "
                          "(map stays connected).", srv_name)
            self.status_msg_pub.publish("Mapping continues on the loaded map.")
            return True
        except Exception as e:
            rospy.logwarn("Could not switch rtabmap to mapping via %s: %s", srv_name, e)
            return False

