        self._georef_last_t = None
        # ---- persistent site georeference (POSE_DATUM_PLAN phase 1b) --------
        # When no navi map georef is live (/navi_manager/map_coords silent or
        # zero), the site datum captured by mapping v3 (insertion_gate phase
        # 1a, symlinked by mapping_manager) supplies utm_map instead, so GPS
