        self._map_coords_rx_t = 0.0      # last LIVE nonzero map_coords receive
        # 3.0 -> 8.0 (2026-07-06): roof-edge RTK flaps run longer than 3 s and
        # each expiry re-triggered acquisition+rewind churn; a genuine outage
        # loses nothing by later confirmation (the rewind anchor is
        # bad_since-based, not confirmation-based).
        self._gps_dropout_grace_s = float(rospy.get_param('~gps_dropout_grace_s', 8.0))
        # skip external map-pose corrections while rotating fast: the source pose
