    def callback_load_map(self, msg, init=False):
        if msg.data != "":
            # self.map_status = "Loading"
            self.active_map = msg.data
            self.status_msg_pub.publish("Map {} will be loaded...".format(msg.data))
            # self.indoor = False
            if msg.data.split("***env*")[1] == "INDOOR":
                self.indoor = True
            else: 
                self.indoor = False
            if not init:
                self.shutdown_navi_launch()
            # Stop the rtabmap container BEFORE overwriting rtabmap.db: a running
            # rtabmap holds the sqlite file open and SAVES into it on shutdown, so
            # copying first let the dying container write ~20 kB of its session over
            # the freshly loaded map -> corrupt db -> rtabmap segfault on next start.
            self.rtabmap_mapping.stop()
            self.status_msg_pub.publish("Loading the map...")
            # site_native (1c): rtabmap is out of the runtime, so skip the (large)
            # rtabmap .db copy into ~/.ros — nothing consumes it. The mapdata pickle
            # copy, planner_data swap and launch restart below are UNCHANGED.
            if self._site_native:
                if not self._sitenative_dbskip_logged:
                    rospy.loginfo("navi_man site_native: skipping rtabmap .db copy "
                                  "on map load (rtabmap out of runtime).")
                    self._sitenative_dbskip_logged = True
            else:
                shutil.copyfile("/home/vitulus/.vitulus/saves/maps/" + msg.data + ".db",
                                "/home/vitulus/.ros/rtabmap.db")
            shutil.copyfile("/home/vitulus/.vitulus/saves/maps_data/" + msg.data + ".pkl",
                            "/home/vitulus/.ros/mapdata.pkl")
            self.status_msg_pub.publish("Map " + msg.data + " saved.")
            rospy.loginfo("Map " + msg.data + " loaded.")
            if self.params.get('rtabmap_on_start', False):
                # Unified localization: bring rtabmap up in LOCALIZATION mode on the
                # loaded map (instead of stopping the container) so the robot can
                # localize in it without GPS — the dock seed publishes the docked pose
                # to /rtabmap/initialpose and lidar proximity locks. Applies to boot
                # (load_map_on_start) and UI map loads alike; config-gated for rollback.
                self.start_navi_launch(["localization:=true_rtabmap"])
            else:
                self.start_navi_launch(["localization:=true"])
            self.load_running_map_data()
            self.set_map_utm_transform()
            # self.map_status = "Ready"
        else:
            self.status_msg_pub.publish("Map not loaded. Empty name.")
            rospy.logerr("Map not loaded. Empty name.")

