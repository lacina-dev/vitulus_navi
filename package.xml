<?xml version="1.0"?>
<package format="2">
  <name>vitulus_navi</name>
  <version>0.0.0</version>
  <description>The vitulus_navi package</description>
  <maintainer email="robert@lacina.dev">Robert Lacina</maintainer>
  <license>MIT</license>
  <author email="robert@lacina.dev">Robert Lacina</author>


  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>costmap_2d</build_depend>


  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>rospy</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
    <exec_depend>move_base_flex</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>costmap_2d</exec_depend>
  <!-- global costmap uses the memoryless obstacle layer; the plugin name
       costmap_2d::NonPersistentVoxelLayer is REGISTERED by this package
       (SteveMacenski/nonpersistent_voxel_layer, released to Noetic):
       sudo apt install ros-noetic-nonpersistent-voxel-layer -->
  <exec_depend>nonpersistent_voxel_layer</exec_depend>
  <exec_depend>weather_alert</exec_depend>
  <exec_depend>vitulus_msgs</exec_depend>

<!--  <export>-->
<!--        <costmap_2d plugin="${vitulus_navi}/costmap_plugins.xml"/>-->
<!--  </export>-->

</package>
