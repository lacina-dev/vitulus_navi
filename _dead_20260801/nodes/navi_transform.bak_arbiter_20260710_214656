    def callback_rtk_odom(self, msg):
        self.rtk_odom_msg = msg
        self._rtk_odom_rx_t = rospy.get_time()
        self.rtk_odom_heading_msg = copy.deepcopy(msg)
        self.rtk_odom_heading_msg.pose.pose.orientation = self.fused_msg.orientation


    # ===== vitulus_ui Phase 1: shadow bridge preview (Step A) =================
    # Purpose: validate, WITHOUT touching the live pose, whether visual odometry
    # (/vo/odom) and/or lidar ICP odometry (/licp/odom) can bridge GPS-denied
    # stretches better than wheel/IMU alone. Each source is confidence-gated
    # (covariance + freshness + hysteresis, mirroring the GPS fix_usable logic).
    # While GPS is usable the preview pose is anchored to the live fused pose;
    # while GPS is denied it dead-reckons using the best available gated source.
    # Output: /nav_tf/odom_bridge_preview (Odometry) and /nav_tf/bridge_status.
    def bridge_init_state(self):
        self._src = {
            'vo':    {'x': 0.0, 'y': 0.0, 'yaw': 0.0, 'cov': 1e9, 't': 0.0, 'have': False, 'ref': None, 'good': 0},
            'licp':  {'x': 0.0, 'y': 0.0, 'yaw': 0.0, 'cov': 1e9, 't': 0.0, 'have': False, 'ref': None, 'good': 0},
            'wheel': {'x': 0.0, 'y': 0.0, 'yaw': 0.0, 'cov': 0.0, 't': 0.0, 'have': False, 'ref': None, 'good': 0},
        }
        self._bridge = {'x': 0.0, 'y': 0.0, 'yaw': 0.0, 'init': False}
        self._bridge_active = 'none'
        self._bridge_cov_thresh = 1.0      # m^2; rtabmap inflates pose cov when tracking is lost
        self._bridge_fresh_s = 0.5         # a source older than this is considered stale
        self._bridge_hyst = 3              # consecutive good samples before a source is trusted
        # Per-cycle deltas above these are reset/glitch jumps -> rejected. The
        # bridge integrates at 30 Hz and the robot tops out ~0.5 m/s (~0.017
        # m/cycle), so 0.08 m leaves a generous margin yet caps a stuck-glitch
        # accumulation at ~0.08*30*3s ≈ 7 m instead of the 0.3 m clamp's ~27 m
        # (the observed 26.7 m spike). 0.3 m allowed an absurd 9 m/s.
        self._bridge_max_step = 0.08       # m; reject larger single-cycle deltas (reset/glitch jumps)
        self._bridge_max_yaw = 0.3         # rad; same, for rotation
        # Wheel cross-check (Step B layer 1): a VO/lidar source is only trusted
        # if its per-cycle motion is not WILDLY more than the wheels'. Asymmetric
        # and generous (mult=3 + 5cm) so normal wheel slip is tolerated but gross
        # runaway glitches (e.g. the observed 7 m jump) are rejected.
        self._bridge_xcheck_mult = 3.0
        self._bridge_xcheck_abs = 0.05     # m
        # Phase 1 go-live: when True and GPS is denied, drive the LIVE pose from
        # the bridge (VO/lidar dead-reckon) instead of letting the EKF drift on
        # wheels. Default OFF for safety (dock/undock + startup run on known-good
        # wheel odom); enable per-drive via param or /nav_tf/bridge_live_enable.
        self._bridge_live_enable = rospy.get_param('~bridge/live_enable', False)

    @staticmethod
    def _odom_xyyaw(msg):
        q = msg.pose.pose.orientation
        (_, _, yaw) = euler_from_quaternion([q.x, q.y, q.z, q.w])
        return msg.pose.pose.position.x, msg.pose.pose.position.y, yaw

    @staticmethod
    def _wrap(a):
        while a > math.pi:
            a -= 2 * math.pi
        while a < -math.pi:
            a += 2 * math.pi
        return a

    def _store_src(self, key, msg):
        try:
            x, y, yaw = self._odom_xyyaw(msg)
            if not (math.isfinite(x) and math.isfinite(y) and math.isfinite(yaw)):
                return
            s = self._src[key]
            s['x'], s['y'], s['yaw'] = x, y, yaw
            s['cov'] = msg.pose.covariance[0]
            s['t'] = rospy.Time.now().to_sec()
            s['have'] = True
        except Exception:
            pass

    def callback_vo_odom(self, msg):
        self._store_src('vo', msg)

    def callback_licp_odom(self, msg):
        self._store_src('licp', msg)

    def _src_usable(self, key, now):
        s = self._src[key]
        fresh = s['have'] and (now - s['t']) < self._bridge_fresh_s
        quality = True if key == 'wheel' else (s['cov'] < self._bridge_cov_thresh)
        if fresh and quality:
            s['good'] = min(s['good'] + 1, self._bridge_hyst)
        else:
            s['good'] = 0
        return s['good'] >= self._bridge_hyst

    def _step_dist(self, key):
        """Per-cycle translation distance of a source (since last reference)."""
        s = self._src[key]
        if s['ref'] is None:
            return None
        return math.hypot(s['x'] - s['ref'][0], s['y'] - s['ref'][1])

    def _wheel_consistent(self, key):
        """Reject a source whose per-cycle motion runs away far beyond the wheels'
        (glitch protection). Asymmetric: a source moving LESS than wheels is fine."""
        wd = self._step_dist('wheel')
        sd = self._step_dist(key)
        if sd is None:
            return True            # source just (re)initialised; nothing to check yet
        if wd is None:
            # No wheel reference to compare against (e.g. right after an anchor
            # reset) — exactly when odometry-frame teleports/glitches strike. Fail
            # SAFE: trust only tiny motion instead of bypassing the check (the old
            # `return True` here let the 26.7 m glitch through).
            return sd <= self._bridge_xcheck_abs
        return sd <= self._bridge_xcheck_mult * wd + self._bridge_xcheck_abs

    def update_bridge_preview(self):
        now = rospy.Time.now().to_sec()
        # keep the wheel source fresh from the live wheel odom message
        if self.wheel_odom_msg is not None and self.wheel_odom_msg.header.stamp.to_sec() > 0:
            self._store_src('wheel', self.wheel_odom_msg)

        usable = {k: self._src_usable(k, now) for k in self._src}
        cur = {k: (s['x'], s['y'], s['yaw']) for k, s in self._src.items()}
        # Phase-2 decouple: the live pose now re-anchors on RTK position alone, so
        # the shadow bridge mirrors that (denied = real position dropout, not a
        # heading flap). Keeps shadow div_from_live meaningful vs the live pose.
        gps_good = bool(self.position_fix_usable)

        if gps_good or not self._bridge['init']:
            # anchor the preview to the live fused pose; reset all references
            bx, by, byaw = self._odom_xyyaw(self.base_odom_msg)
            self._bridge.update({'x': bx, 'y': by, 'yaw': byaw, 'init': True})
            self._bridge_active = 'gps' if gps_good else 'init'
        else:
            # GPS denied -> dead-reckon with the best gated source
            # (lowest-covariance visual/lidar; wheel/IMU as last resort)
            cands = [k for k in ('vo', 'licp') if usable[k] and self._wheel_consistent(k)]
            active = min(cands, key=lambda k: self._src[k]['cov']) if cands else 'wheel'
            self._bridge_active = active
            s = self._src[active]
            ref = s['ref']
            if ref is not None:
                dx, dy, dyaw = s['x'] - ref[0], s['y'] - ref[1], self._wrap(s['yaw'] - ref[2])
                # Reject implausibly large single-cycle jumps. With auto-reset on,
                # an odometry source teleports its frame to a new origin when it
                # re-initialises; that shows up as a huge one-cycle delta. At 30 Hz
                # even fast driving is < ~0.1 m/cycle, so anything beyond the clamp
                # is a reset/glitch -> skip it (the reference is still refreshed
                # below, so normal integration resumes next cycle).
                if math.hypot(dx, dy) <= self._bridge_max_step and abs(dyaw) <= self._bridge_max_yaw:
                    c, sn = math.cos(-ref[2]), math.sin(-ref[2])
                    lx, ly = c * dx - sn * dy, sn * dx + c * dy
                    bc, bs = math.cos(self._bridge['yaw']), math.sin(self._bridge['yaw'])
                    self._bridge['x'] += bc * lx - bs * ly
                    self._bridge['y'] += bs * lx + bc * ly
                    self._bridge['yaw'] = self._wrap(self._bridge['yaw'] + dyaw)

        # advance every source's reference to current so source switching is seamless
        for k, s in self._src.items():
            s['ref'] = cur[k]

        self._publish_bridge(usable, gps_good)

    def _publish_bridge(self, usable, gps_good):
        out = Odometry()
        out.header.stamp = rospy.Time.now()
        out.header.frame_id = "odom"
        out.child_frame_id = "base_link_bridge"
        out.pose.pose.position.x = self._bridge['x']
        out.pose.pose.position.y = self._bridge['y']
        q = quaternion_from_euler(0, 0, self._bridge['yaw'])
        out.pose.pose.orientation.x, out.pose.pose.orientation.y = q[0], q[1]
        out.pose.pose.orientation.z, out.pose.pose.orientation.w = q[2], q[3]
        self.bridge_preview_pub.publish(out)
        try:
            lx, ly, _ = self._odom_xyyaw(self.base_odom_msg)
            div = math.hypot(self._bridge['x'] - lx, self._bridge['y'] - ly)
        except Exception:
            div = float('nan')
        live = (not gps_good) and self._bridge_live_enable and self._bridge.get('init') \
            and self._bridge_active in ('vo', 'licp')
        st = ("gps_good=%d live=%d active=%s div_from_live=%.3fm | vo[use=%d cov=%.3g] "
              "licp[use=%d cov=%.3g] wheel[use=%d]" % (
                  int(gps_good), int(live), self._bridge_active, div,
                  int(usable['vo']), self._src['vo']['cov'],
                  int(usable['licp']), self._src['licp']['cov'],
                  int(usable['wheel'])))
        self.bridge_status_pub.publish(String(data=st))

    def callback_bridge_live_enable(self, msg):
        self._bridge_live_enable = bool(msg.data)
        rospy.logwarn("[bridge] live bridging %s" % ("ENABLED" if msg.data else "DISABLED"))

    def set_bridge_live_pose(self):
        """Drive the live pose from the bridge during a GPS dropout. Position from
        the bridge dead-reckon (VO/lidar), orientation from the IMU-fused heading
        (continuous) — mirroring the RTK correction in set_wheel_base_nav_pose,
        just with the bridge position instead of RTK. Same EKF set_pose service."""
        try:
            pose_srv = SetPoseRequest()
            pose_srv.pose.pose.pose.position.x = self._bridge['x']
            pose_srv.pose.pose.pose.position.y = self._bridge['y']
            pose_srv.pose.pose.pose.position.z = 0.0
            pose_srv.pose.pose.pose.orientation.x = self.fused_msg.orientation.x
            pose_srv.pose.pose.pose.orientation.y = self.fused_msg.orientation.y
            pose_srv.pose.pose.pose.orientation.z = self.fused_msg.orientation.z
            pose_srv.pose.pose.pose.orientation.w = self.fused_msg.orientation.w
            pose_srv.pose.header.frame_id = 'odom'
            pose_srv.pose.header.stamp = rospy.Time.now()
            srv = rospy.ServiceProxy('/ekf_wheel_nav_odometry/set_pose', SetPose)
            srv(pose_srv)
        except rospy.ServiceException as e:
            rospy.logerr("set_bridge_live_pose set_pose failed: %s" % e)
    # ===== end shadow bridge preview =========================================


    def callback_gnss_fix(self, msg):
        usable = False
        position_usable = False
        if msg.position_covariance[8] <= 0.0001 \
                and msg.position_covariance[0] <= 0.000197 \
                and msg.position_covariance[4] <= 0.000197:
            if msg.status.status == 2:
                # RTK position is ~1.4 cm here regardless of heading quality.
                position_usable = True
                if self.launch_navsat is None:
                    if self._heading_ok():
                        usable = True
                else:
                    usable = True
                # self.set_nav_wheel_odom()
                # self.reset_wheel_odom()
                # self.set_wheel_base_pose()
        self.fix_usable = usable
        self.fix_usable_history.pop(0)
        self.fix_usable_history.append(usable)
        # Phase-2 decouple: track position usability separately from heading.
        # The dual-antenna RTK heading is unreliable while DRIVING (cov 0.02-0.16,
        # σ≈8-23°), which used to gate the whole fix and throw away the perfect
        # position too. The live correction (loop3sec -> set_wheel_base_nav_pose)
        # applies RTK position + the IMU-fused heading, so anchoring position on
        # this alone is safe and keeps the pose on RTK far more of the time.
        self.position_fix_usable = position_usable
        self.position_fix_usable_history.pop(0)
        self.position_fix_usable_history.append(position_usable)
        self._update_gps_probation(msg, position_usable)
        # GPS-acquisition hysteresis (shared by callback_map_coords AND the
        # loop3sec set_pose path): track how long the position has been
        # CONTINUOUSLY usable. Tracked here per fix message so it ticks even
        # when map_coords is quiet.
        now_t = rospy.get_time()
        if not position_usable:
            if self._gps_bad_since is None:
                self._gps_bad_since = now_t
            # Dropout GRACE: only a SUSTAINED outage resets the acquisition
            # window. RTK flapping (seconds-long dropouts, up to 46/2 min
            # measured) otherwise starved the corrections completely and the
            # pose drifted on odometry/bridge (drive 4: 'dost to ujizdelo').
            if now_t - self._gps_bad_since > self._gps_dropout_grace_s:
                if self._gps_good_since is not None:
                    # confirmed outage transition: splice the pose back to the
                    # last provably-good GPS anchor (T - rewind) + odometry
                    self._do_rewind_handoff(now_t)
                self._gps_good_since = None
                self._heading_good_after_acq = False
                # sustained outage also invalidates the probation proof —
                # GPS must prove itself in motion again after it returns
                self._gps_probe_anchor = None
                self._gps_proven = False
        else:
            self._gps_bad_since = None
            if self._gps_good_since is None:
                self._gps_good_since = now_t
        # print(self.fix_usable_history)
        # print("gnss_fix usable: ", usable)



    def _do_rewind_handoff(self, now_t):
        """REWIND handoff (POSE_DATUM_PLAN phase 2): quality metrics admit a
        GPS degradation late, so the pose at the moment an outage is
        CONFIRMED already carries a corrupted tail. Re-anchor:
            pose := rtk(T_a) + (wheel_now - wheel(T_a)),
        T_a = outage_start - rewind_s, taken from the correction-time buffer;
        the wheel EKF is never set_pose'd so its delta is correction-free.
        One ~10 Hz-slewed EKF target does the rest (set_wheel_base_nav_pose
        caps steps, so even this splice applies smoothly)."""
        if not self._rewind_enable or not self._pose_buffer:
            return
        if now_t - self._last_rewind_t < self._rewind_cooldown_s:
            rospy.loginfo('[rewind] suppressed (cooldown %.0fs — RTK flapping)',
                          self._rewind_cooldown_s)
            return
        t_anchor = (self._gps_bad_since or now_t) - self._rewind_s
        anchor = None
        for entry in self._pose_buffer:
            if entry[0] <= t_anchor:
                anchor = entry
            else:
                break
        if anchor is None:
            rospy.logwarn('[rewind] no buffered sample older than %.1fs before '
                          'the outage — skipping', self._rewind_s)
            return
        ta, (rx, ry), (wx, wy) = anchor
        o = self.ekf_wheel_odom_msg.pose.pose.position
        sx = rx + (o.x - wx)
        sy = ry + (o.y - wy)
        c = self.ekf_wheel_nav_odom_msg.pose.pose.position
        d = math.hypot(sx - c.x, sy - c.y)
        if d < 0.05:
            rospy.loginfo('[rewind] corrupted tail negligible (%.3f m) — '
                          'no splice needed', d)
            return
        if d > self._rewind_max_m:
            rospy.logwarn('[rewind] splice %.2f m exceeds max %.2f m — '
                          'refusing (kidnap-scale mismatch)', d,
                          self._rewind_max_m)
            return
        pose = Pose()
        pose.position.x = sx
        pose.position.y = sy
        pose.position.z = self.ekf_wheel_nav_odom_msg.pose.pose.position.z
        pose.orientation = self.fused_msg.orientation
        rospy.logwarn('[rewind] GPS outage confirmed — re-anchoring pose from '
                      'T-%.1fs (%.1fs old sample), correcting %.2f m of '
                      'corrupted tail', now_t - ta, self._rewind_s, d)
        self._last_rewind_t = now_t
        self.set_wheel_base_nav_pose(pose, frame='odom')

    def _update_gps_probation(self, fix_msg, position_usable):
        """GPS-first arbiter probation (POSE_DATUM_PLAN, 2026-07-06 user
        directive): GPS may TAKE pose ownership from a confident rtabmap only
        after it has PROVEN itself in motion — since the position became
        usable, the robot must travel >= ~1 m (wheel-odom) with the
        GPS-measured distance agreeing (straight-line, rotation/datum
        invariant). Blocks the known trap: confident multipath garbage near
        the roofed dock passing the covariance gates while parked (2.4 m
        yank, 2026-07-05) — parked garbage never proves itself.
        NOTE: a single unusable sample does NOT reset the probe — RTK flaps
        tens of times per 2 min in bad weather and a per-message reset
        would starve ownership completely; the probe resets only on a
        SUSTAINED outage (same grace branch that triggers the rewind)."""
        if not position_usable:
            return
        k = 111320.0
        gx = fix_msg.longitude * k * math.cos(math.radians(fix_msg.latitude))
        gy = fix_msg.latitude * k
        o = self.ekf_wheel_odom_msg.pose.pose.position
        if self._gps_probe_anchor is None:
            self._gps_probe_anchor = (gx, gy, o.x, o.y)
            return
        ax, ay, aox, aoy = self._gps_probe_anchor
        d_gps = math.hypot(gx - ax, gy - ay)
        d_odom = math.hypot(o.x - aox, o.y - aoy)
        if d_odom < self._gps_probation_travel_m:
            return
        if abs(d_gps - d_odom) <= 0.1 + 0.2 * d_odom:
            if not self._gps_proven:
                rospy.logwarn('[navi_transform] GPS PROVEN in motion '
                              '(odom %.2f m vs gps %.2f m) -> may take pose '
                              'ownership', d_odom, d_gps)
            self._gps_proven = True
        else:
            rospy.logwarn_throttle(10.0, '[navi_transform] GPS probation '
                                   'FAILED (odom %.2f m vs gps %.2f m) — '
                                   're-probing', d_odom, d_gps)
            self._gps_probe_anchor = (gx, gy, o.x, o.y)
            self._gps_proven = False

    def callback_gnss_heading_fix(self, msg):
        usable = False
        if msg.position_covariance[8] <= 0.00065 \
                and msg.position_covariance[0] <= 0.000256 \
                and msg.position_covariance[4] <= 0.000256:
            if msg.status.status == 2:
                usable = True
        self.heading_fix_usable = usable
        if usable:
            self._heading_last_good = time.time()
        # print("gnss_heading_fix usable: ", usable)

    def _heading_ok(self):
        """Heading usable now, or was within a short grace window — smooths the
        rapid RTK-heading flapping that otherwise dropped GPS acceptance
        (gps_good ~35% despite RTK ~71%). IMU heading + last offset cover the gap."""
        return self.heading_fix_usable or (time.time() - self._heading_last_good) < self._heading_grace_s

    def callback_navheading(self, msg):
        self.offset_navheading_imu(msg)
        self.navheading_msg = msg
        (roll, pitch, yaw) = euler_from_quaternion(
            [msg.orientation.x, msg.orientation.y, msg.orientation.z, msg.orientation.w])
        self.navheading_yaw = yaw


    def callback_imu(self, msg):
        self.imu_msg = msg
        (roll, pitch, yaw) = euler_from_quaternion(
            [msg.orientation.x, msg.orientation.y, msg.orientation.z, msg.orientation.w])
        self.imu_yaw = yaw
        self.publish_imu_baselink()
        self.publish_fused_navheading()

