        # OLD live correction wrote rtk(NOW) into the nav EKF (loop3sec). NEW:
        # the pose written at time t is GPS_pose(t-anchor_lag) composed with the
        # fused-odometry delta from (t-anchor_lag) to t, both paired at the SAME
        # instant so place AND orientation are self-consistent and the last
        # ~2 s of not-yet-degraded GPS is never trusted live. The delta is
        # carried by the CORRECTION-FREE wheel EKF (ekf_wheel_odom, never
        # set_pose'd), ROTATED into the map frame by theta = nav_yaw(Ta) -
        # wheel_yaw(Ta) — REUSING the rewind-v2 buffer + math (12ed9d3). The
        # nav-EKF delta was rejected as the source: over a 2 s window under
        # continuous anchoring it already contains OUR OWN slewed corrections
        # (self-referential), whereas the wheel-EKF delta is correction-free.
        # Each anchor update is MOTION-VERIFIED (|Dgps| ~ |Dwheel| over a
        # sub-window, probation tolerance); a non-verifying sample does NOT
        # advance the anchor -> a lying multipath tail freezes the last verified
        # anchor and the pose is immune to it. Covariance is NEVER trusted.
        # CONSEQUENCE: on outage nothing special happens — corrections just stop
        # (anchor was already <=lag fresh + verified), pose continues seamlessly
        # on the fused EKF. The old rewind splice is therefore OBSOLETE and gated
        # OFF by default (rewind_enable), kept intact only for rollback.
        self._anchor_lag_s = float(rospy.get_param('~anchor_lag_s', 2.0))
        # accumulated-error drift report, logged + exposed in loc_status on GPS
        # ownership RESUME after an outage (dx, dy, dyaw, distance, duration).
        self._drift_report = None
        # last MOTION-VERIFIED continuous anchor buffer entry (frozen when the
        # newest lag-old sample fails motion verification — protects the pose
        # from a lying multipath tail). None until the first verified anchor.
        self._anchor_verified = None
        # FIX3 (telemfix 2026-07-11): anchor observability. Wall time the
        # verified anchor last ADVANCED (a fresh lag-old sample verified) so
        # loc_status can expose its age; a warn fires (throttled) when it stays
        # frozen > _anchor_frozen_warn_s while GPS owns the pose — a frozen
        # anchor means the multipath tail is being rejected (correct) but the
        # pose is running open-loop on the wheel EKF and the operator must see it.
        self._anchor_last_advance_t = None
        self._anchor_frozen_warn_s = float(rospy.get_param('~anchor_frozen_warn_s', 5.0))
        # FIX1 (telemfix 2026-07-11): capture the live nav pose AND time-paired
        # RTK pose at the resume tick BEFORE the first new correction is applied,
        # so the drift report is measured against INDEPENDENT RTK truth (not the
        # self-referential frozen anchor, which cancelled the error to 0.082 m
        # against a true 0.27 m). Populated in loop3sec on the resume tick.
        self._resume_live_pose = None     # (x, y) live nav-EKF pose at resume, pre-correction
        self._resume_rtk_pose = None      # (x, y) time-paired RTK pose at resume
        self._resume_rtk_fresh = False    # was the RTK sample fresh at resume
        self._anchor_owned = False        # were we writing continuous anchors last tick
        self._anchor_lost_t = None        # wall time GPS ownership was lost
        self._anchor_lost_pose = None     # (map x, y, yaw) at the moment ownership was lost
        self._anchor_odom_at_loss = None  # wheel-EKF (x, y) at the moment ownership was lost
        # REWIND handoff (POSE_DATUM_PLAN phase 2, user requirement): the
        # quality metrics report GPS degradation LATE — the last ~1-2 s of
        # 'good' GPS are already corrupted. On a CONFIRMED outage the pose is
        # re-anchored from the buffered GPS pose at (outage_start - rewind_s)
        # plus the wheel-EKF odometry delta since (the wheel EKF is never
        # set_pose'd, so its deltas are correction-free).
        # rewind_enable DEFAULT -> FALSE: continuous same-time anchoring above
        # makes the splice obsolete (mode logged once at startup).
        self._rewind_enable = bool(rospy.get_param('~rewind_enable', False))
        self._rewind_s = float(rospy.get_param('~rewind_s', 2.0))
        self._rewind_max_m = float(rospy.get_param('~rewind_max_m', 2.0))
        # RTK flapping at the roof edge confirmed an "outage" every few
        # seconds and the un-slewed rewind splice THRASHED the pose (bag
        # 22-17-24: ten 0.35-0.62 m steps in 80 s). One splice per genuine
        # outage is the intent:
        self._rewind_cooldown_s = float(rospy.get_param('~rewind_cooldown_s', 20.0))
        self._last_rewind_t = -1e9
        # REWIND v2 (2026-07-11, user field diagnosis, verified on bag
        # mapfree_drive_2026-07-11_17-23-32): two defects in the v1 splice.
        # (A) The wheel-EKF (ekf_wheel_odom) free-runs from boot and is NEVER
        #     GPS-anchored — its position offset cancels in the delta, but its
        #     HEADING drift vs the map frame does NOT: the raw wheel delta is
        #     rotated by the accumulated wheel-EKF-frame-vs-map misalignment
        #     (bag: 9-14 deg over 1-4 m of motion -> 0.4-1.0 m splice error).
        #     FIX: rotate the wheel delta by theta = nav_yaw(Ta) - wheel_yaw(Ta)
        #     into the map frame before adding to the RTK anchor. Buffer now
        #     ALSO stores per tick the wheel-EKF yaw and the live nav-pose yaw.
        # (B) The fixed anchor (bad_since - rewind_s) trusts the GPS tail; but
        #     GPS quality CANNOT be judged from covariance (multipath keeps
        #     tight cov while position walks). Only odometry motion agreement
        #     is a valid referee. FIX: walk BACKWARDS from the outage and take
        #     the NEWEST buffer sample whose |Dgps| ~ |Dwheel| held over a
        #     trailing sub-window (probation tolerance) -> the corrupted tail is
        #     genuinely cut; if the tail was consistent, anchor ~ live -> ~no jump.
        self._rewind_verify_s = float(rospy.get_param('~rewind_verify_s', 5.0))
        self._rewind_verify_step_s = float(rospy.get_param('~rewind_verify_step_s', 0.5))
        # trailing sub-window (s) for the |Dgps| vs |Dwheel| agreement test
        self._rewind_verify_subwin_s = float(rospy.get_param('~rewind_verify_subwin_s', 1.5))
        # buffer tuple: (t, rtk_xy, wheel_xy, wheel_yaw, nav_yaw) @ ~10 Hz
        self._pose_buffer = deque(maxlen=200)
        # Georef (map->odom) slew: rate-limit corrections from the utm georef
        # path; only a kidnap-size mismatch snaps.
        self._georef_slew_mps = float(rospy.get_param('~georef_slew_mps', 0.10))
        self._georef_slew_dps = float(rospy.get_param('~georef_slew_dps', 1.0))
