    def callback_gnss_fix(self, msg):
        usable = False
        position_usable = False
        if msg.position_covariance[8] <= 0.0001 \
                and msg.position_covariance[0] <= 0.000197 \
                and msg.position_covariance[4] <= 0.000197:
            if msg.status.status == 2:
                # RTK position is ~1.4 cm here regardless of heading quality.
                position_usable = True
                if self.launch_navsat is None:
                    if self._heading_ok():
                        usable = True
                else:
                    usable = True
                # self.set_nav_wheel_odom()
                # self.reset_wheel_odom()
                # self.set_wheel_base_pose()
        self.fix_usable = usable
        self.fix_usable_history.pop(0)
        self.fix_usable_history.append(usable)
        # Phase-2 decouple: track position usability separately from heading.
        # The dual-antenna RTK heading is unreliable while DRIVING (cov 0.02-0.16,
        # σ≈8-23°), which used to gate the whole fix and throw away the perfect
        # position too. The live correction (loop3sec -> set_wheel_base_nav_pose)
        # applies RTK position + the IMU-fused heading, so anchoring position on
        # this alone is safe and keeps the pose on RTK far more of the time.
        self.position_fix_usable = position_usable
        self.position_fix_usable_history.pop(0)
        self.position_fix_usable_history.append(position_usable)
        self._update_gps_probation(msg, position_usable)
        # GPS-acquisition hysteresis (shared by callback_map_coords AND the
        # loop3sec set_pose path): track how long the position has been
        # CONTINUOUSLY usable. Tracked here per fix message so it ticks even
        # when map_coords is quiet.
        now_t = rospy.get_time()
        if not position_usable:
            if self._gps_bad_since is None:
                self._gps_bad_since = now_t
            # Dropout GRACE: only a SUSTAINED outage resets the acquisition
            # window. RTK flapping (seconds-long dropouts, up to 46/2 min
            # measured) otherwise starved the corrections completely and the
            # pose drifted on odometry/bridge (drive 4: 'dost to ujizdelo').
            if now_t - self._gps_bad_since > self._gps_dropout_grace_s:
                if self._gps_good_since is not None:
                    # confirmed outage transition: splice the pose back to the
                    # last provably-good GPS anchor (T - rewind) + odometry
                    self._do_rewind_handoff(now_t)
                self._gps_good_since = None
                self._heading_good_after_acq = False
                # sustained outage also invalidates the probation proof —
                # GPS must prove itself (in motion OR stationary) again after
                # it returns
                self._gps_probe_anchor = None
                self._gps_proven = False
                self._stationary_since = None
                self._stationary_rtk_samples.clear()
        else:
            self._gps_bad_since = None
            if self._gps_good_since is None:
                self._gps_good_since = now_t
        # print(self.fix_usable_history)
        # print("gnss_fix usable: ", usable)



    def _buffer_newest_before(self, t):
        """Newest buffered (t, rtk_xy, wheel_xy, wheel_yaw, nav_yaw) with
        entry time <= t, or None. Buffer is time-ordered (appended by loop3sec)."""
        found = None
        for entry in self._pose_buffer:
            if entry[0] <= t:
                found = entry
            else:
                break
        return found

    def _rewind_verify_anchor(self, t_out):
        """Motion-verified anchor (REWIND v2, defect B): the GPS tail's quality
        cannot be judged from covariance (multipath keeps tight cov while the
        position walks) — only odometry motion agreement is a valid referee.
        Walk BACKWARDS from the outage in ~rewind_verify_step_s steps over the
        last ~rewind_verify_s, and return the NEWEST buffered sample whose GPS
        motion |Dgps| agrees with wheel-EKF motion |Dwheel| over a trailing
        sub-window (reusing the probation tolerance abs+frac*d). Returns
        (anchor_entry, verified_bool):
          - agreement held right up to the outage -> anchor ~ last good sample
            -> splice ~ live pose (tiny/no jump);
          - the tail diverged (multipath) -> anchor lands where GPS was last
            motion-consistent -> the corrupted tail is genuinely cut;
          - NO sample verifies -> (fixed bad_since-rewind_s anchor, False)
            = fall back to v1 behavior (caller warns)."""
        n_steps = int(self._rewind_verify_s / max(self._rewind_verify_step_s, 1e-3)) + 1
        for i in range(n_steps):     # newest -> oldest: first agreeing = newest
            t_c = t_out - i * self._rewind_verify_step_s
            cand = self._buffer_newest_before(t_c)
            if cand is None:
                continue
            prev = self._buffer_newest_before(cand[0] - self._rewind_verify_subwin_s)
            if prev is None:
                continue
            d_gps = math.hypot(cand[1][0] - prev[1][0], cand[1][1] - prev[1][1])
            d_wheel = math.hypot(cand[2][0] - prev[2][0], cand[2][1] - prev[2][1])
            tol = self._probation_tol_abs_m + self._probation_tol_frac * d_wheel
            if abs(d_gps - d_wheel) <= tol:
                return cand, True
        # nothing verified -> fixed fallback anchor
        return self._buffer_newest_before(t_out - self._rewind_s), False

    def _do_rewind_handoff(self, now_t):
        """REWIND handoff (POSE_DATUM_PLAN phase 2 + v2, 2026-07-11): quality
        metrics admit a GPS degradation late, so the pose at the moment an
        outage is CONFIRMED already carries a corrupted tail. Re-anchor:
            pose := rtk(T_a) + R(theta) . (wheel_now - wheel(T_a)),
        where T_a is a MOTION-VERIFIED anchor (last sample where GPS motion
        still agreed with wheel motion; see _rewind_verify_anchor) instead of a
        blind bad_since-rewind_s, and theta = nav_yaw(T_a) - wheel_yaw(T_a)
        rotates the correction-free wheel delta into the map frame (the wheel
        EKF free-runs from boot: its position cancels in the delta but its
        heading drift vs map does not). The wheel EKF is never set_pose'd so its
        delta is correction-free. One ~10 Hz-slewed EKF target does the rest
        (set_wheel_base_nav_pose caps steps, so even this splice applies
        smoothly)."""
        if not self._rewind_enable or not self._pose_buffer:
            return
        if now_t - self._last_rewind_t < self._rewind_cooldown_s:
            rospy.loginfo('[rewind] suppressed (cooldown %.0fs — RTK flapping)',
                          self._rewind_cooldown_s)
            return
        t_out = self._gps_bad_since or now_t
        anchor, verified = self._rewind_verify_anchor(t_out)
        if anchor is None:
            rospy.logwarn('[rewind] no buffered sample to anchor from '
                          '(verify window %.1fs) — skipping', self._rewind_verify_s)
            return
        if not verified:
            rospy.logwarn('[rewind] NO motion-verified anchor in last %.1fs — '
                          'falling back to fixed T-%.1fs anchor',
                          self._rewind_verify_s, self._rewind_s)
        ta, (rx, ry), (wx, wy), wyaw, nyaw = anchor
        # Delta rotation into map frame (defect A): theta = nav_yaw - wheel_yaw.
        theta = math.atan2(math.sin(nyaw - wyaw), math.cos(nyaw - wyaw))
        o = self.ekf_wheel_odom_msg.pose.pose.position
        ddx = o.x - wx
        ddy = o.y - wy
        ct, st = math.cos(theta), math.sin(theta)
        sx = rx + (ct * ddx - st * ddy)
        sy = ry + (st * ddx + ct * ddy)
        c = self.ekf_wheel_nav_odom_msg.pose.pose.position
        d = math.hypot(sx - c.x, sy - c.y)
        rospy.logwarn('[rewind] GPS outage confirmed — anchor age %.1fs (%s), '
                      'theta %.1fdeg, splice %.2f m',
                      now_t - ta, 'verified' if verified else 'FALLBACK',
                      math.degrees(theta), d)
        if d < 0.05:
            rospy.loginfo('[rewind] corrupted tail negligible (%.3f m) — '
                          'no splice needed', d)
            return
        if d > self._rewind_max_m:
            rospy.logwarn('[rewind] splice %.2f m exceeds max %.2f m — '
                          'refusing (kidnap-scale mismatch)', d,
                          self._rewind_max_m)
            return
        pose = Pose()
        pose.position.x = sx
        pose.position.y = sy
        pose.position.z = self.ekf_wheel_nav_odom_msg.pose.pose.position.z
        pose.orientation = self.fused_msg.orientation
        self._last_rewind_t = now_t
        self.set_wheel_base_nav_pose(pose, frame='odom')

    def _entry_motion_verified(self, cand):
        """Motion-verification for a single buffer entry (REUSE of the rewind-v2
        referee, defect B): the GPS tail's quality CANNOT be judged from
        covariance (multipath keeps tight cov while position walks) — only
        odometry motion agreement is a valid referee. Return True iff the GPS
        motion |Dgps| over the trailing sub-window agrees with the correction-
        free wheel-EKF motion |Dwheel| within the probation tolerance."""
        prev = self._buffer_newest_before(cand[0] - self._rewind_verify_subwin_s)
        if prev is None:
            return False
        d_gps = math.hypot(cand[1][0] - prev[1][0], cand[1][1] - prev[1][1])
        d_wheel = math.hypot(cand[2][0] - prev[2][0], cand[2][1] - prev[2][1])
        tol = self._probation_tol_abs_m + self._probation_tol_frac * d_wheel
        return abs(d_gps - d_wheel) <= tol

    def _apply_continuous_anchor(self):
        """CONTINUOUS SAME-TIME ANCHOR (user-approved redesign): compute the
        live correction as GPS_pose(Ta) composed with the correction-free
        wheel-EKF delta (Ta -> now) ROTATED into the map frame, where
        Ta = now - anchor_lag_s. Place and orientation are paired at the SAME
        instant Ta so they are self-consistent, and the not-yet-degraded last
        ~lag seconds of GPS are never trusted live. Reuses the rewind-v2 buffer
        (t, rtk_xy, wheel_xy, wheel_yaw, nav_yaw) and delta-rotation math.

        Anchor updates are MOTION-VERIFIED: the newest buffer entry older than
        the lag advances the anchor ONLY if |Dgps| ~ |Dwheel| held over the
        trailing sub-window; otherwise the LAST verified anchor is kept frozen
        (a lying multipath tail cannot move the anchor -> pose immune to it).

        Returns True if a target was computed and written (caller then records
        the rewind buffer + skips the legacy rtk(NOW) path); False if the buffer
        is not yet lag-deep (bootstrap) -> caller falls back to the legacy path.
        The written target reuses set_wheel_base_nav_pose's slew (frame='odom')."""
        if not self._pose_buffer:
            return False
        now_t = rospy.get_time()
        cand = self._buffer_newest_before(now_t - self._anchor_lag_s)
        if cand is None:
            return False          # buffer not yet lag-deep -> bootstrap
        # Advance the verified anchor only when the candidate verifies; else
        # keep the frozen last-verified anchor (multipath-tail immunity).
        if self._entry_motion_verified(cand):
            self._anchor_verified = cand
            self._anchor_last_advance_t = now_t   # FIX3: anchor advanced
        elif self._anchor_verified is None:
            # nothing has ever verified yet -> cannot anchor safely; bootstrap
            return False
        anchor = self._anchor_verified
        ta, (rx, ry), (wx, wy), wyaw, nyaw = anchor
        # Delta rotation into the map frame: theta = nav_yaw(Ta) - wheel_yaw(Ta).
        theta = math.atan2(math.sin(nyaw - wyaw), math.cos(nyaw - wyaw))
        o = self.ekf_wheel_odom_msg.pose.pose.position
        ddx = o.x - wx
        ddy = o.y - wy
        ct, st = math.cos(theta), math.sin(theta)
        tx = rx + (ct * ddx - st * ddy)
        ty = ry + (st * ddx + ct * ddy)
        pose = Pose()
        pose.position.x = tx
        pose.position.y = ty
        pose.position.z = self.rtk_odom_msg.pose.pose.position.z
        pose.orientation = self.fused_msg.orientation
        # frame='map' target -> reuse the SAME slewed path as the legacy
        # correction (slew lives in the pose=None branch; here we pass an
        # explicit map-frame target and let set_wheel_base_nav_pose slew it).
        self._set_anchor_pose_slewed(tx, ty, pose.position.z)
        return True

    def _set_anchor_pose_slewed(self, tx, ty, tz):
        """Write a map/odom-frame position target into the nav EKF with the SAME
        per-call slew the legacy rtk(NOW) correction used (drive-6 forensics:
        snapping the EKF straight to a target was half the takeover jump). Small
        deltas apply directly; large ones converge at ~pos_slew_mps."""
        cx = self.ekf_wheel_nav_odom_msg.pose.pose.position.x
        cy = self.ekf_wheel_nav_odom_msg.pose.pose.position.y
        dx, dy = tx - cx, ty - cy
        dist = math.hypot(dx, dy)
        max_step = self._pos_slew_mps * 0.1   # per call at ~10 Hz
        if dist > max(max_step, 0.10):
            scale = max_step / dist
            tx, ty = cx + dx * scale, cy + dy * scale
        pose = Pose()
        pose.position.x = tx
        pose.position.y = ty
        pose.position.z = tz
        pose.orientation = self.fused_msg.orientation
        self.set_wheel_base_nav_pose(pose, frame='odom')

    def _note_ownership(self, wrote):
        """Track the GPS pose-ownership edge for the drift report. On the
        True->False edge (ownership just lost) snapshot the live map pose and
        the correction-free wheel-EKF pose so the next resume can compute the
        accumulated dead-reckoning error since GPS left."""
        if self._anchor_owned and not wrote:
            self._anchor_lost_t = rospy.get_time()
            c = self.ekf_wheel_nav_odom_msg.pose.pose
            self._anchor_lost_pose = (c.position.x, c.position.y, self.fused_yaw)
            ow = self.ekf_wheel_odom_msg.pose.pose.position
            self._anchor_odom_at_loss = (ow.x, ow.y)
        self._anchor_owned = wrote

    def _emit_drift_report(self):
        """FIX1 (telemfix 2026-07-11): drift report measured against INDEPENDENT
        RTK truth, not the self-referential frozen anchor.

        OLD design compared the live pose against the frozen verified anchor
        PROPAGATED BY THE SAME WHEEL ODOMETRY -> the dead-reckoning error
        cancelled itself (reported 0.082 m against a true 0.27 m at the t=610
        resume). NEW design: on the resume tick the caller snapshots the live
        nav-EKF pose AND the time-paired RTK pose BEFORE the first new GPS
        correction is applied (self._resume_live_pose / self._resume_rtk_pose).
        The report error is live_pose(resume) - RTK_pose(resume) — the actual
        discontinuity independent RTK would impose = the DR error accumulated
        while blind. dyaw = fused heading at resume vs heading at loss (omitted
        when heading was not healthy at resume); distance = wheel-EKF path
        driven blind; duration = outage length. Slewed in downstream, so no
        visible jump — this only REPORTS the accumulated error.
        Bag anchor_test_2026-07-11: reconstructs the t=610 resume at 0.236 m."""
        if self._anchor_lost_pose is None or self._anchor_lost_t is None:
            return
        if self._resume_live_pose is None or self._resume_rtk_pose is None:
            return
        now_t = rospy.get_time()
        lx, ly = self._resume_live_pose
        gx, gy = self._resume_rtk_pose
        dx = gx - lx
        dy = gy - ly
        dist = 0.0
        if self._anchor_odom_at_loss is not None:
            ow = self.ekf_wheel_odom_msg.pose.pose.position
            dist = math.hypot(ow.x - self._anchor_odom_at_loss[0],
                              ow.y - self._anchor_odom_at_loss[1])
        dur = now_t - self._anchor_lost_t
        report = {
            'dx': round(dx, 3), 'dy': round(dy, 3),
            'dist_m': round(math.hypot(dx, dy), 3),
            'driven_no_gps_m': round(dist, 2),
            'outage_s': round(dur, 1),
            'measured_vs': 'rtk_resume',
        }
        # dyaw only when the RTK heading was healthy at resume (else omit — a
        # stale/flapping heading would report a meaningless yaw error).
        if self._resume_rtk_fresh and self._heading_ok():
            dyaw = math.degrees(math.atan2(
                math.sin(self.fused_yaw - self._anchor_lost_pose[2]),
                math.cos(self.fused_yaw - self._anchor_lost_pose[2])))
            report['dyaw_deg'] = round(dyaw, 2)
        self._drift_report = report
        rospy.loginfo(
            "[drift_report] GPS ownership RESUMED after %.1fs / %.2f m driven "
            "blind — accumulated error dx=%.3f dy=%.3f (|%.3f m|)%s [vs rtk_resume]",
            dur, dist, dx, dy, math.hypot(dx, dy),
            (" dyaw=%.2fdeg" % report['dyaw_deg']) if 'dyaw_deg' in report else "")
        self._anchor_lost_pose = None
        self._anchor_lost_t = None
        self._anchor_odom_at_loss = None
        self._resume_live_pose = None
        self._resume_rtk_pose = None
        self._resume_rtk_fresh = False

    def _update_gps_probation(self, fix_msg, position_usable):
        """GPS-first arbiter probation (POSE_DATUM_PLAN, 2026-07-06 user
        directive): GPS may TAKE pose ownership from a confident rtabmap only
        after it has PROVEN itself in motion — since the position became
        usable, the robot must travel >= ~1 m (wheel-odom) with the
        GPS-measured distance agreeing (straight-line, rotation/datum
        invariant). Blocks the known trap: confident multipath garbage near
        the roofed dock passing the covariance gates while parked (2.4 m
        yank, 2026-07-05) — parked garbage never proves itself.
        NOTE: a single unusable sample does NOT reset the probe — RTK flaps
        tens of times per 2 min in bad weather and a per-message reset
        would starve ownership completely; the probe resets only on a
        SUSTAINED outage (same grace branch that triggers the rewind)."""
        if not position_usable:
            return
        k = 111320.0
        gx = fix_msg.longitude * k * math.cos(math.radians(fix_msg.latitude))
        gy = fix_msg.latitude * k
        # STATIONARY PROBATION (2026-07-12): a parked robot with a genuinely
        # FIXED RTK can prove GPS without the ~1 m motion the arbiter otherwise
        # requires. Gate: fix usable (already true here) + heading ok + wheels
        # stopped (twist ~0) + RTK scatter over a rolling window below threshold.
        # A moving robot or a wandering (multipath) fix clears the window and
        # falls through to the motion probe below.
        tw = self.wheel_odom_msg.twist.twist
        stationary = (abs(tw.linear.x) < self._stationary_v_eps and
                      abs(tw.linear.y) < self._stationary_v_eps and
                      abs(tw.angular.z) < self._stationary_w_eps)
        now_sp = rospy.get_time()
        if stationary and self._heading_ok():
            if self._stationary_since is None:
                self._stationary_since = now_sp
            self._stationary_rtk_samples.append((now_sp, gx, gy))
            # drop samples older than the probe window
            while (self._stationary_rtk_samples and
                   now_sp - self._stationary_rtk_samples[0][0] > self._stationary_probe_s):
                self._stationary_rtk_samples.popleft()
            if (not self._gps_proven and
                    now_sp - self._stationary_since >= self._stationary_probe_s and
                    len(self._stationary_rtk_samples) >= 3):
                xs = [s[1] for s in self._stationary_rtk_samples]
                ys = [s[2] for s in self._stationary_rtk_samples]
                # scatter = max radial spread from the window centroid
                cx = sum(xs) / len(xs)
                cy = sum(ys) / len(ys)
                scatter = max(math.hypot(x - cx, y - cy) for x, y in zip(xs, ys))
                if scatter <= self._stationary_probe_max_scatter_m:
                    rospy.logwarn('[navi_transform] GPS PROVEN stationary '
                                  '(RTK scatter %.3f m over %.0fs, %d samp) -> '
                                  'may take pose ownership', scatter,
                                  self._stationary_probe_s,
                                  len(self._stationary_rtk_samples))
                    self._gps_proven = True
                    # re-anchor the motion probe here so a subsequent drive-away
                    # continues verifying from the current spot, not a stale one
                    self._gps_probe_anchor = (
                        gx, gy, self.ekf_wheel_odom_msg.pose.pose.position.x,
                        self.ekf_wheel_odom_msg.pose.pose.position.y)
                    return
        else:
            # started moving (or heading dropped): abandon the rest window, let
            # the motion probe below take over
            self._stationary_since = None
            self._stationary_rtk_samples.clear()
        o = self.ekf_wheel_odom_msg.pose.pose.position
        if self._gps_probe_anchor is None:
            self._gps_probe_anchor = (gx, gy, o.x, o.y)
            return
        ax, ay, aox, aoy = self._gps_probe_anchor
        d_gps = math.hypot(gx - ax, gy - ay)
        d_odom = math.hypot(o.x - aox, o.y - aoy)
        if d_odom < self._gps_probation_travel_m:
            return
        if abs(d_gps - d_odom) <= self._probation_tol_abs_m + self._probation_tol_frac * d_odom:
            if not self._gps_proven:
                rospy.logwarn('[navi_transform] GPS PROVEN in motion '
                              '(odom %.2f m vs gps %.2f m) -> may take pose '
                              'ownership', d_odom, d_gps)
            self._gps_proven = True
        else:
            rospy.logwarn_throttle(10.0, '[navi_transform] GPS probation '
                                   'FAILED (odom %.2f m vs gps %.2f m) — '
                                   're-probing', d_odom, d_gps)
            self._gps_probe_anchor = (gx, gy, o.x, o.y)
            self._gps_proven = False

    def callback_gnss_heading_fix(self, msg):
        usable = False
        if msg.position_covariance[8] <= 0.00065 \
                and msg.position_covariance[0] <= 0.000256 \
                and msg.position_covariance[4] <= 0.000256:
            if msg.status.status == 2:
                usable = True
        self.heading_fix_usable = usable
        if usable:
            self._heading_last_good = time.time()
        # print("gnss_heading_fix usable: ", usable)

    def _heading_ok(self):
        """Heading usable now, or was within a short grace window — smooths the
        rapid RTK-heading flapping that otherwise dropped GPS acceptance
        (gps_good ~35% despite RTK ~71%). IMU heading + last offset cover the gap."""
        return self.heading_fix_usable or (time.time() - self._heading_last_good) < self._heading_grace_s

