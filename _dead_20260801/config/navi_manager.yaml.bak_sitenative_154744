### Navi manager init ###

# Name of the map to load (create new map if empty).
# Boot-in-dock: load the production outdoor map so the dock seed can place the
# robot in it immediately (no GPS needed). The map MUST contain the "docked"
# waypoint (be docked + localized, then publish "docked" to /navi_manager/save_waypoint
# and SAVE the map).
load_map_on_start: "GARDEN_2026***env*OUTDOOR"

# When loading a map (at boot AND from the UI), also start the rtabmap docker
# container in LOCALIZATION mode on it.
# Localization v2 (2026-07-11, user decision): rtabmap is OUT of map-making and
# out of the pose path. Localization is rtabmap-free (fusion EKF + GPS-RTK + dock
# seed); maps are served from the mapping_v3 octomap pipeline (map_source_on_start
# below). So RTABMAP_MAPPING must NOT be required at boot -> false.
# NOTE: RTABMAP_ODOM_SYNC + RTABMAP_OBSTACLES are started unconditionally in
# navi_man __init__ (they feed VO input + /obstacles_cloud,/ground_cloud) and are
# independent of this flag. RTABMAP_MAPPING is still started on demand by the
# UNDOCK new-indoor-map flow and by explicit UI map create/edit/save.
# true = legacy behavior (bring rtabmap up in localization mode on every map load).
rtabmap_on_start: false

# Map source that is DISPLAYED and SERVED on /navi_manager/map at boot (feeds the
# global costmap static layer, the planner and the UI). Localization v2: default to
# the mapping_v3 octomap raster (mapping_manager /mapping_manager/site_map), so
# rtabmap is not needed to have a map. Switchable live via /navi_manager/show_map.
#   "octomap" = mapping_v3 site raster (default, new normal)
#   "planner" = planner-edited grid (legacy default)
#   "rtabmap" = rtabmap grid_map (starts RTABMAP_MAPPING on demand)
map_source_on_start: "octomap"
