    def publish_map_coords(self):
        if not self.indoor:
            # Georef datum for map->odom (pickle datum by default; site datum.yaml
            # under site_native). navi_transform.callback_map_coords differences
            # utm->odom against this to build the live map->odom transform.
            gx, gy, gz, gox, goy, goz, gow = self._georef_datum_values()
            msg = PoseStamped()
            msg.header.stamp = rospy.Time.now()
            msg.header.frame_id = "map"
            msg.pose.position.x = gx
            msg.pose.position.y = gy
            msg.pose.position.z = gz
            msg.pose.orientation.x = gox
            msg.pose.orientation.y = goy
            msg.pose.orientation.z = goz
            msg.pose.orientation.w = gow
            self.map_coords.publish(msg)


    def set_map_utm_transform(self):
        # get world odom coords
        if not self.indoor:
            try:
                trans = self.tf2_Buffer.lookup_transform('utm', 'odom', rospy.Time(0))
                available = True
            except:
                available = False
                # self.map_status = "Loading"

            if available:
                m_x = 0
                m_y = 0
                m_z = 0
                if self.running_map_data.is_utm():
                    # Georef datum source: pickle datum by default, site datum.yaml
                    # under site_native (1b). NOTE: the sendTransform below is
                    # commented out (the live map->odom georef is published by
                    # navi_transform from /navi_manager/map_coords) — this stays
                    # datum-consistent for if/when the broadcast is re-enabled.
                    gx, gy, gz, gox, goy, goz, gow = self._georef_datum_values()
                    m_x = trans.transform.translation.x - gx
                    m_y = trans.transform.translation.y - gy
                    m_z = trans.transform.translation.z - gz
                    if not hasattr(self, 'running_map_data.utm_orientation_x'):
                        self.running_map_data.utm_orientation_x = 0
                        self.running_map_data.utm_orientation_y = 0
                    m_orientation_x = gox
                    m_orientation_y = goy
                    m_orientation_z = goz
                    m_orientation_w = gow
                else:
                    m_orientation_x = 0
                    m_orientation_y = 0
                    m_orientation_z = 0
                    m_orientation_w = 1

                static_transformStamped = TransformStamped()
                static_transformStamped.header.stamp = rospy.Time.now()
                static_transformStamped.header.frame_id = "map"
                static_transformStamped.child_frame_id = "odom"
                static_transformStamped.transform.translation.x = m_x
                static_transformStamped.transform.translation.y = m_y
                static_transformStamped.transform.translation.z = m_z
                static_transformStamped.transform.rotation.x = m_orientation_x
                static_transformStamped.transform.rotation.y = m_orientation_y
                static_transformStamped.transform.rotation.z = m_orientation_z
                static_transformStamped.transform.rotation.w = m_orientation_w
                # self.tf2_TransformBroadcaster.sendTransform(static_transformStamped)

    def save_running_map_data(self):
        with open('/home/vitulus/.ros/mapdata.pkl', 'wb') as output:
            pickle.dump(self.running_map_data, output, pickle.HIGHEST_PROTOCOL)
        # site-bundle dual-write (WP-B): mirror waypoints/paths to the linked site
        # bundle in canonical UTM. NEVER let a bundle failure break the legacy save.
        self._export_bundle()

    def load_running_map_data(self):
        with open('/home/vitulus/.ros/mapdata.pkl', 'rb') as input:
            self.running_map_data = pickle.load(input)
        # site-bundle import-if-newer (WP-B): if the linked site bundle is newer
        # than the map's own saved pickle, rebuild points/paths from it (UTM->MAP).
        # Any failure keeps the pickle contents (never brick a map load).
        self._import_bundle_if_newer()
        self.set_map_utm_transform()

    # ----------------------------------------------------------------------
    # site-bundle sync (WP-B). Legacy pickle stays the runtime cache; the site
    # bundle (~/.vitulus/mapping_v3/<site>/) is the canonical UTM store.
    # ----------------------------------------------------------------------
    def _active_map_pickle_path(self):
        return "/home/vitulus/.vitulus/saves/maps_data/" + self.active_map + ".pkl"

    def _bundle_site_for_active_map(self):
        """Resolve the site whose manifest.navi_map == self.active_map. ~param
        ~bundle_site overrides (empty=autodetect). Cached per active_map; logs
        the resolution once per map. Returns site name or None (features off)."""
        if not _BUNDLE_OK:
            return None
        am = self.active_map
        if am == self._bundle_site_for:
            return self._bundle_site
        site = None
        try:
            override = rospy.get_param('~bundle_site', '')
        except Exception:
            override = ''
        if override:
            if _bundle.site_exists(override):
                site = override
            else:
                rospy.logwarn("navi_man bundle: ~bundle_site='%s' set but no site "
                              "dir under %s — bundle features off.",
                              override, _bundle.SITES_ROOT)
        else:
            try:
                for cand in _bundle.list_sites():
                    m = _bundle.load_manifest(cand)
                    if m and m.get('navi_map') == am:
                        site = cand
                        break
            except Exception as e:
                rospy.logwarn("navi_man bundle: site autodetect failed: %s", e)
                site = None
        self._bundle_site = site
        self._bundle_site_for = am
        if site:
            rospy.loginfo("navi_man bundle: map '%s' linked to site '%s' (%s).",
                          am, site, _bundle.site_dir(site))
        else:
            rospy.loginfo("navi_man bundle: no site linked to map '%s' — "
                          "bundle export/import off for this map.", am)
        return site

    def _republish_map_lists(self):
        # After a bundle import/export republish the waypoint/path name lists the
        # UI reads (same publishers the slow loop uses).
        try:
            self.publish_map_point_list()
            self.publish_map_point_str_list()
            self.publish_map_path_list()
        except Exception as e:
            rospy.logwarn("navi_man bundle: republish map lists failed: %s", e)

    def _export_bundle(self):
        if not _BUNDLE_OK:
            return
        site = self._bundle_site_for_active_map()
        if not site:
            return
        rmd = self.running_map_data
        try:
            if not rmd.is_utm():
                rospy.logwarn_throttle(60.0, "navi_man bundle: active map has no UTM "
                                       "datum yet — skipping bundle export.")
                return
            datum = _geo.from_pickle_datum(rmd)
            wps = _bsync.map_points_to_waypoints(rmd.points, datum)
            paths = _bsync.map_paths_to_paths(rmd.paths, datum)
            _bundle.save_waypoints(site, wps)
            _bundle.save_paths(site, paths)
            rospy.loginfo_throttle(10.0, "navi_man bundle: exported %d waypoints + "
                                   "%d paths to site '%s'.",
                                   len(wps), len(paths), site)
            self._republish_map_lists()
        except Exception as e:
            rospy.logwarn("navi_man bundle: export to site '%s' failed (legacy "
                          "pickle still saved): %s", site, e)

    def _bundle_datum_guard(self, site, pickle_datum):
        # Informational (plan §3): if the site datum.yaml disagrees with the map's
        # pickle datum beyond 0.05 m / 2 mrad, WARN. We never SILENTLY switch datum
        # — for bundle geometry conversion the pickle datum drives it; for the
        # site-native georef the caller decides, and this guard supplies the delta.
        # Returns (site_datum_canonical, (dE, dN, dAlt, dYaw)) or (None, None) when
        # no usable datum.yaml exists. Existing callers may ignore the return.
        try:
            dp = os.path.join(_bundle.site_dir(site), 'datum.yaml')
            if not os.path.exists(dp):
                return None, None
            with open(dp) as f:
                sd = yaml.safe_load(f)
            if not sd:
                return None, None
            site_datum = _geo.from_datum_yaml(sd)
            exceeded, (de, dn, dalt, dyaw) = _bsync.datum_exceeds(pickle_datum,
                                                                  site_datum)
            if exceeded:
                rospy.logwarn("navi_man bundle: DATUM MISMATCH site '%s' vs map "
                              "pickle — dE=%.3fm dN=%.3fm dYaw=%.4frad "
                              "(thr 0.05m/2mrad).", site, de, dn, dyaw)
            return site_datum, (de, dn, dalt, dyaw)
        except Exception as e:
            rospy.logwarn("navi_man bundle: datum guard check failed: %s", e)
            return None, None

    def _georef_datum_values(self):
        # Datum used for the map->odom GEOREF that navi_man feeds downstream:
        # published on /navi_manager/map_coords (consumed by navi_transform's
        # callback_map_coords — THE live map->odom source) and used by the
        # (currently broadcast-disabled) set_map_utm_transform. Returns
        # (utm_x, utm_y, utm_z, ox, oy, oz, ow).
        #
        # DEFAULT / flag-off: the map's PICKLE datum (running_map_data.utm_*) —
        # byte-identical to legacy. site_native (1b): the SERVED site's
        # datum.yaml when it resolves, with a one-time delta WARN + a one-time
        # loginfo naming the source (loc-relevant visibility); it PROCEEDS on any
        # delta (today mm/mrad). No site datum under site_native -> pickle datum +
        # one-time warn. Cached per active_map so the 30 Hz caller costs nothing
        # and the logs fire once per map.
        rmd = self.running_map_data
        pickle_vals = (rmd.utm_x, rmd.utm_y, rmd.utm_z,
                       rmd.utm_orientation_x, rmd.utm_orientation_y,
                       rmd.utm_orientation_z, rmd.utm_orientation_w)
        if not self._site_native:
            return pickle_vals
        if self.active_map == self._georef_vals_for:
            return self._georef_vals_cache if self._georef_vals_cache is not None \
                else pickle_vals
        # (re)resolve for this active_map; on any miss fall back to pickle and
        # do not re-log (the cache key is set so this branch runs once per map).
        self._georef_vals_for = self.active_map
        self._georef_vals_cache = None
        if not _BUNDLE_OK or not rmd.is_utm():
            rospy.logwarn("navi_man site_native: bundle libs unavailable or map "
                          "'%s' has no UTM datum — georef uses the pickle datum.",
                          self.active_map)
            return pickle_vals
        site = self._bundle_site_for_active_map()
        if not site:
            rospy.logwarn("navi_man site_native: no site linked to map '%s' — "
                          "georef uses the pickle datum.", self.active_map)
            return pickle_vals
        pickle_datum = _geo.from_pickle_datum(rmd)
        site_datum, delta = self._bundle_datum_guard(site, pickle_datum)
        if site_datum is None:
            rospy.logwarn("navi_man site_native: site '%s' has no datum.yaml — "
                          "georef uses the pickle datum.", site)
            return pickle_vals
        de, dn, dalt, dyaw = delta
        q = _geo.yaw_to_quat(site_datum['yaw_rad'])   # (x, y, z, w) pure yaw
        z = site_datum['alt'] if 'alt' in site_datum else rmd.utm_z
        vals = (site_datum['utm_e'], site_datum['utm_n'], z,
                q[0], q[1], q[2], q[3])
        self._georef_vals_cache = vals
        rospy.loginfo("navi_man site_native: georef datum: site '%s' (delta vs "
                      "pickle dE=%.3fm dN=%.3fm dYaw=%.4frad dAlt=%s) — map->odom "
                      "uses the SITE datum.", site, de, dn, dyaw,
                      ("%.3fm" % dalt) if dalt is not None else "n/a")
        return vals

    def _build_map_point_from_spec(self, spec):
        q = _geo.yaw_to_quat(spec['yaw'])   # (x, y, z, w) pure yaw
        pose = Pose(Point(spec['x'], spec['y'], spec['z']),
                    Quaternion(0.0, 0.0, q[2], q[3]))
        return MapPoint(spec['name'], pose, 'map')

    def _build_map_path_from_spec(self, spec):
        path = MapPath(spec['name'], 'map')
        for ps in spec['poses']:
            q = _geo.yaw_to_quat(ps['yaw'])
            pose = Pose(Point(ps['x'], ps['y'], ps['z']),
                        Quaternion(0.0, 0.0, q[2], q[3]))
            path.add_pose(pose)
        return path

    def _import_bundle_if_newer(self):
        if not _BUNDLE_OK:
            return
        site = self._bundle_site_for_active_map()
        if not site:
            return
        try:
            pkl_path = self._active_map_pickle_path()
            pkl_mtime = os.path.getmtime(pkl_path) if os.path.exists(pkl_path) else 0.0
            times = [t for t in (_bundle.file_mtime(site, 'waypoints'),
                                 _bundle.file_mtime(site, 'paths')) if t is not None]
            newest = max(times) if times else None
            if newest is None or newest <= pkl_mtime:
                return  # bundle absent or not newer -> keep pickle contents
            rmd = self.running_map_data
            if not rmd.is_utm():
                rospy.logwarn("navi_man bundle: bundle newer than pickle for site "
                              "'%s' but map has no UTM datum — cannot import; "
                              "keeping pickle.", site)
                return
            datum = _geo.from_pickle_datum(rmd)
            self._bundle_datum_guard(site, datum)
            pt_specs = _bsync.waypoints_to_point_specs(
                _bundle.load_waypoints(site), datum)
            pa_specs = _bsync.paths_to_path_specs(
                _bundle.load_paths(site), datum)
            new_points = [self._build_map_point_from_spec(s) for s in pt_specs]
            new_paths = [self._build_map_path_from_spec(s) for s in pa_specs]
            rmd.points = new_points
            rmd.paths = new_paths
            rospy.loginfo("navi_man bundle: imported %d waypoints + %d paths from "
                          "site '%s' (bundle newer than pickle by %.0fs); "
                          "points: %s", len(new_points), len(new_paths), site,
                          newest - pkl_mtime,
                          ', '.join(p.name for p in new_points) or '-')
            self._republish_map_lists()
        except Exception as e:
            rospy.logwarn("navi_man bundle: import from site '%s' failed — keeping "
                          "pickle contents: %s", site, e)

    def save_map_utm_pose(self):
        if not self.running_map_data.is_utm():
            # trans = tf2_Buffer.lookup_transform('utm', 'odom', rospy.Time(0))
            trans = self.tf2_Buffer.lookup_transform('utm', 'map', rospy.Time(0))
            self.running_map_data.utm_x = trans.transform.translation.x
            self.running_map_data.utm_y = trans.transform.translation.y
            self.running_map_data.utm_z = trans.transform.translation.z
            self.running_map_data.utm_orientation_x = trans.transform.rotation.x
            self.running_map_data.utm_orientation_y = trans.transform.rotation.y
            self.running_map_data.utm_orientation_z = trans.transform.rotation.z
            self.running_map_data.utm_orientation_w = trans.transform.rotation.w
            self.save_running_map_data()
            rospy.loginfo("Data saved.")
            return True
        else:
            return False

    def start_navi_launch(self, args=[]):
        self.status_msg_pub.publish("Starting navi module...")
