<launch>
  <!-- vitulus_ui / Phase 1: Lidar odometry from the 2D laser (ICP).
       SHADOW SOURCE ONLY: publishes /licp/odom + /licp/odom_info, with
       publish_tf=FALSE so it does NOT touch the live odom->base_link TF.
       Meant to be consumed by navi_transform as a gated bridge source during
       GPS-denied stretches. Lidar works well at night / in shade and degrades
       in direct sun (returns vanish) - that is handled by the consumer's
       confidence gate (ICP fitness / covariance), not here.

       laser_scan_matcher/rf2o are not installed on host; rtabmap_odom's
       icp_odometry covers the same role and is available.

       Run standalone for validation:
         roslaunch vitulus_navi lidar_icp_odometry.launch
       then inspect /licp/odom and /licp/odom_info. -->

  <arg name="scan"       default="/scan"/>
  <arg name="frame_id"   default="base_link"/>

  <node pkg="rtabmap_odom" type="icp_odometry" name="lidar_icp_odometry" output="screen" respawn="true" respawn_delay="3">
    <remap from="scan"        to="$(arg scan)"/>
    <remap from="odom"        to="/licp/odom"/>
    <remap from="odom_info"   to="/licp/odom_info"/>

    <param name="frame_id"          type="string" value="$(arg frame_id)"/>
    <param name="odom_frame_id"     type="string" value="licp_odom"/>
    <param name="publish_tf"        type="bool"   value="false"/>
    <param name="wait_for_transform_duration" type="double" value="0.2"/>

    <!-- Auto-reset after losing tracking so icp_odometry ALWAYS recovers when
         structure/returns come back. With 0 it got permanently stuck lost
         (corr=0) after an open/sun patch and never re-registered even with a
         good 600-point scan. The bridge consumer absorbs the reset jump. -->
    <param name="Odom/ResetCountdown"     type="string" value="1"/>
    <param name="Odom/Holonomic"          type="string" value="false"/>
    <param name="Reg/Strategy"            type="string" value="1"/>   <!-- ICP (Icp/* used) -->
    <param name="Reg/Force3DoF"           type="string" value="true"/>

    <!-- ============================================================
         QUALITY TUNING 2026-07-11 (LOCALIZATION_V2_PLAN "Vyšetřování
         driftu pod střechou", finding 3). Verified against the INSTALLED
         rtabmap_odom 0.21.10 binary (icp_odometry with the params flag).

         Measured baseline (120 s standstill bag, 2026-07-11):
           - at-REST yaw-rate noise  std = 1.408 deg/s   (2sigma=2.8 -> yaw
             currently NOT fused by EKF)
           - at-REST vx noise        std = 28.5 mm/s      (vs published twist
             cov claiming 8.4 mm/s -> cov underestimates reality ~3-10x)
           - vx mean 0.065 mm/s -> NO rest bias, it is pure match noise.

         Goal: reduce per-match angle noise (~0.14 deg/match @10 Hz) and
         improve yaw observability so the EKF can eventually fuse licp yaw
         for heading stabilisation under-roof (no GPS).

         RE-MEASURE after restart (same 120 s standstill + a drive pass):
           - at-rest yaw std   TARGET < 0.5 deg/s   (from 1.408)
           - at-rest vx  std   should drop toward the published ~8-9 mm/s
           - in-motion: smoother /licp/odom twist, fewer EKF gate rejections
             (see ekf gate fix ekf_base_outdoor.yaml:139,151, done in parallel)
         ============================================================ -->

    <!-- Deskew the 10 Hz spinning-scan (100 ms smear) using the constant-
         velocity guess. Scan has time_increment populated so per-point
         timestamps exist. NOTE: this is ON by default in 0.21.10, set
         explicitly for clarity / to survive default changes. -->
    <param name="Odom/Deskewing"          type="string" value="true"/>

    <!-- 2D scan ICP tuning (libpointmatcher, Icp/Strategy=1 default) -->
    <param name="Icp/VoxelSize"                 type="string" value="0.05"/>
    <!-- 0.1 was too tight: inter-scan displacement at 0.66 m/s + smear can
         approach 0.1 m; widen to 0.2 (>= 2x VoxelSize) for stable matching. -->
    <param name="Icp/MaxCorrespondenceDistance" type="string" value="0.2"/>
    <!-- Point-to-plane (normals from Icp/PointToPlaneK 2D neighbours) gives
         much better yaw observability on structured scenes than point-to-
         point. Was explicitly disabled here; default is true. -->
    <param name="Icp/PointToPlane"              type="string" value="true"/>
    <param name="Icp/PointToPlaneK"             type="string" value="5"/>
    <!-- Was 10; 30 is cheap at ~860 pts/rev and lets ICP fully converge. -->
    <param name="Icp/Iterations"                type="string" value="30"/>
    <!-- Was 0.001; tighten so convergence is decided by residual, not by a
         loose early-stop that leaves per-match jitter. 0=only iters/dist. -->
    <param name="Icp/Epsilon"                   type="string" value="0.0001"/>
    <!-- Trimmed-outlier ratio for libpointmatcher; 0.85 = binary default,
         set explicitly (rejects the worst 15% correspondences). -->
    <param name="Icp/OutlierRatio"              type="string" value="0.85"/>
    <param name="Icp/MaxTranslation"            type="string" value="0.5"/>

    <!-- COVARIANCE HONESTY: icp_odometry 0.21.10 exposes NO twist-covariance
         scaling/multiplier param (Odom/Kalman* only apply when
         Odom/FilteringStrategy>0, which we leave at 0). The published twist
         cov underestimates reality ~3-10x (vx 8.4 vs 28.5 mm/s measured).
         There is no launch-side knob to inflate it. Compensated on the
         CONSUMER side by the odom_cov_fix relay below (2026-07-11), which
         floors the vx/vyaw twist cov at measured reality before the EKF. -->
  </node>

  <!-- Covariance-honesty relay (2026-07-11, LOCALIZATION_V2_PLAN drift finding
       3). icp_odometry's published twist cov is ~3-10x too optimistic (vx std
       8.5 vs measured 16.7 mm/s; vyaw std 0.15 vs measured 0.70 deg/s), so the
       EKF Mahalanobis gate (thr 2.45) rejected licp constantly (offline eval
       2026-07-11: wheel_licp was BIT-IDENTICAL to wheel; licp contributed
       nothing). This node republishes /licp/odom -> /licp/odom_cov with the
       vx/vyaw twist-cov diagonal FLOORED at measured variance. FLOOR not
       overwrite: rtabmap's tracking-loss inflation (9999) is preserved so loss
       still signals to the EKF. It lives/dies with icp_odometry (same launch),
       and the EKF (ekf_base_outdoor.yaml) consumes /licp/odom_cov. -->
  <node pkg="vitulus_navi" type="odom_cov_fix" name="licp_odom_cov_fix" output="screen" respawn="true" respawn_delay="3">
    <param name="in_topic"       type="string" value="/licp/odom"/>
    <param name="out_topic"      type="string" value="/licp/odom_cov"/>
    <!-- measured at-rest: vx std 16.7 mm/s -> var 2.8e-4; vyaw std 0.70 deg/s
         -> var 1.5e-4 rad^2/s^2. -->
    <param name="vx_var_floor"   type="double" value="0.00028"/>
    <param name="vyaw_var_floor" type="double" value="0.00015"/>
  </node>
</launch>
