#
# rosconsole config for the rtabmap odometry nodes (vo_rgbd_odometry,
# lidar_icp_odometry), set per node via <env name="ROSCONSOLE_CONFIG_FILE">.
#
# rtabmap_odom prints "Odom: quality=... / Odom: ratio=..." at INFO for EVERY
# frame (~2 Hz each, ~13 000 lines/h together = most of the stack's stdout and
# a large part of rosout.log). That is pure progress info: the values are on the
# odometry topics (/vo/odom, /licp/odom) anyway. WARN/ERROR (lost odometry,
# registration failures, missing data) stay visible.
#
# Same as the default /opt/ros/noetic/share/ros/config/rosconsole.config plus
# the one line for rtabmap_odom. Revert: delete the <env> line in the launch.
#
log4j.logger.ros=INFO
log4j.logger.ros.roscpp.superdebug=WARN
log4j.logger.ros.rtabmap_odom=WARN
