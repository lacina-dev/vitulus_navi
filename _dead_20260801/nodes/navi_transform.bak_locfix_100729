        self._set_map_pose_max_wz = float(rospy.get_param('~set_map_pose_max_wz', 0.3))
        # smooth takeover: slew rates for large corrections after GPS acquisition
        self._heading_slew_dps = float(rospy.get_param('~heading_slew_dps', 5.0))
