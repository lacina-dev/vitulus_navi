    def _gps_stable(self):
        """GPS corrections allowed: position continuously usable for the
        acquisition-hysteresis window AND at least one good RTK heading seen
        since acquisition (the fused heading / navsat datum is heading-dependent
        — position-only stability still produced a brief jump, drive 3).
        NEVER while DOCKED: the dock bay is a known multipath trap — RTK there
        occasionally passes the covariance gates with confident garbage and
        yanked the pose 2.4 m (2026-07-05 night); the dock anchor + rtabmap own
        the pose at the dock.
        GPS-FIRST ARBITER (2026-07-06, user directive — REVERSES the
        2026-07-05 ownership pivot): GPS with quality is the MAIN pose
        authority; rtabmap/odometry substitute only while GPS lacks quality
        (typical cycle here: open lawn <-> roofed area with no GPS). A
        confident rtabmap may hold the pose ONLY until GPS has PROVEN
        itself in motion (_update_gps_probation: >= ~1 m wheel-odom travel
        with agreeing GPS distance) — parked multipath garbage near the
        roofed dock never proves itself, which keeps the 2026-07-05 trap
        covered without demoting GPS everywhere."""
        if self._docked:
            return False
        # UNIVERSAL probation (2026-07-06 evening, bag 21-36-30): GPS may
        # take pose ownership ONLY after proving itself in motion — a
        # PARKED robot near the roofed area got its pose grabbed by a
        # partially-fixed GPS (the rtabmap-only probation gate did not
        # cover it). Standing still never proves; ownership engages within
        # the first metre of driving on usable fix.
        if not self._gps_proven:
            return False
        return self._gps_good_since is not None and \
            (rospy.get_time() - self._gps_good_since) >= self._map_coords_hysteresis_s and \
            self._heading_good_after_acq

    def callback_set_map_pose(self, msg, source='legacy'):
        """Drive the live map->odom from an external map-frame robot pose (rtabmap lidar
        localization when GPS is denied), FULL 2D pose incl. yaw:

            map->base = R(map_odom_yaw) . odom->base + t
            map_odom_yaw = wanted.yaw - odom->base.yaw
            t = wanted.xy - R(map_odom_yaw) . odom->base.xy

        We do NOT touch the odom-frame EKF (unlike the old set_pose bridge), so odom->base —
        rtabmap's own odometry input — is left alone and there is no feedback loop; the yaw
        correction lives purely in map->odom (drive-away heading fix without GPS). No-GPS
        gating lives in the caller (the dock seed bridge publishes only when gps_good==0),
        so this never fights callback_map_coords / the GNSS heading anchor (both reset
        map_odom_yaw to 0 when they take over).

        WP2 (localization v2): source-tagged arbitration. `source` is one of
        dock > tracker > rtabmap > legacy (priority order). A correction from a
        lower-priority source is REJECTED while a strictly higher-priority source
        was accepted within the last ~map_pose_hold_s — so the dock anchor no
        longer loses to the tracker (the old two-writer last-writer-wins race).
        All existing gates (rotation guard etc.) still apply below."""
        # --- priority arbitration (WP2) -----------------------------------------
        # Reject if a strictly-higher-priority source is still fresh.
        try:
            now_p = rospy.get_time()
            my_rank = self._map_pose_priority.index(source)
        except ValueError:
            my_rank = len(self._map_pose_priority) - 1   # unknown -> lowest
        for higher in self._map_pose_priority[:my_rank]:
            if now_p - self._map_pose_last_accept.get(higher, 0.0) < self._map_pose_hold_s:
                rospy.loginfo_throttle(
                    5.0, "[set_map_pose] source '%s' rejected — higher-priority "
                    "'%s' fresh within %.1fs", source, higher, self._map_pose_hold_s)
                return
        odom_base = self.get_base_link_transform()   # odom->base_link
        if odom_base is None:
            rospy.logwarn_throttle(5.0, "[set_map_pose] no odom->base_link TF yet — skipping")
            return
        # Rotation guard: the external pose (rtabmap localization) is measured
        # slightly in the past; applying it while spinning smears the pose.
        # Skip and let the next (post-rotation) correction land instead.
        wz = abs(self.ekf_wheel_nav_odom_msg.twist.twist.angular.z)
        if wz > self._set_map_pose_max_wz:
            rospy.loginfo_throttle(5.0, "[set_map_pose] rotating (%.2f rad/s) — deferring "
                                        "external correction", wz)
            return
        # Full 2D correction: map->base = R(map_odom_yaw) * odom->base + t.
        # Yaw first (t depends on it): map yaw = map_odom_yaw + odom->base yaw.
        wanted_yaw = euler_from_quaternion([msg.pose.orientation.x, msg.pose.orientation.y,
                                            msg.pose.orientation.z, msg.pose.orientation.w])[2]
        ob_q = odom_base.transform.rotation
        odom_yaw = euler_from_quaternion([ob_q.x, ob_q.y, ob_q.z, ob_q.w])[2]
        m = math.atan2(math.sin(wanted_yaw - odom_yaw), math.cos(wanted_yaw - odom_yaw))
        ob_x = odom_base.transform.translation.x
        ob_y = odom_base.transform.translation.y
        tx = msg.pose.position.x - (math.cos(m) * ob_x - math.sin(m) * ob_y)
        ty = msg.pose.position.y - (math.sin(m) * ob_x + math.cos(m) * ob_y)
        # SMOOTH (2026-07-12): a slewed source records the TARGET; slew_map_pose()
        # in the 30 Hz loop walks the live map->odom toward it at bounded speed so
        # the pose no longer snaps to each 1 Hz tracker minimum. A big mismatch
        # (kidnap / relocalisation) snaps to avoid crawling. Non-slew sources
        # (dock: one-shot precise anchor) apply instantly and clear any target.
        if source in self._map_pose_slew_sources:
            cur = self.map_odom_transform.transform.translation
            dist = math.hypot(tx - cur.x, ty - cur.y)
            dyaw = abs(math.atan2(math.sin(m - self.map_odom_yaw),
                                  math.cos(m - self.map_odom_yaw)))
            if (dist > self._map_pose_slew_snap_m or
                    dyaw > math.radians(self._map_pose_slew_snap_deg)):
                self.map_odom_yaw = m
                cur.x = tx
                cur.y = ty
                self._map_pose_target = None
                rospy.logwarn("[set_map_pose] '%s' mismatch %.2f m / %.1f deg > "
                              "snap — snapping (relocalisation)",
                              source, dist, math.degrees(dyaw))
            else:
                # TWO-SPEED SLEW: small, routine corrections (the common tracker
                # case, <= ~map_pose_gentle_below_m) crawl in gently so they don't
                # visibly jerk the pose; anything bigger (still under the snap
                # threshold above) keeps the fast recovery rate.
                if dist <= self._map_pose_gentle_below_m:
                    self._map_pose_slew_active_mps = self._map_pose_slew_gentle_mps
                    self._map_pose_slew_active_dps = self._map_pose_slew_gentle_dps
                else:
                    self._map_pose_slew_active_mps = self._map_pose_slew_mps
                    self._map_pose_slew_active_dps = self._map_pose_slew_dps
                self._map_pose_target = (tx, ty, m)
        else:
            self.map_odom_yaw = m
            self.map_odom_transform.transform.translation.x = tx
            self.map_odom_transform.transform.translation.y = ty
            self._map_pose_target = None   # instant source wins; drop pending slew
        # WP2: correction ACCEPTED and applied — stamp this source for arbitration.
        if source in self._map_pose_last_accept:
            self._map_pose_last_accept[source] = rospy.get_time()
        rospy.loginfo_throttle(5.0,
            "[set_map_pose] map->odom target from external map pose (%.2f, %.2f, %.1fdeg) -> "
            "t=(%.2f, %.2f) yaw=%.2fdeg src=%s%s",
            msg.pose.position.x, msg.pose.position.y, math.degrees(wanted_yaw),
            tx, ty, math.degrees(m), source,
            " [slew]" if source in self._map_pose_slew_sources else " [instant]")

    def callback_navi_indoor(self, msg):
        was_indoor = self.is_indoor
        self.is_indoor = msg.data
        rospy.loginfo_throttle(10, f"[navi_transform] is_indoor={self.is_indoor}")
        if was_indoor and not self.is_indoor:
            # Transitioning indoor→outdoor: restart navsat_transform_node so it
            # re-initialises with the current (accurate, post-stabilisation) GPS.
            # Without this, navsat could have been initialised near the dock where
            # GPS multipath causes a systematic ~1 m bias in the utm→odom TF.
            rospy.logwarn("[navi_transform] Indoor→outdoor transition detected: "
                          "restarting navsat_transform for fresh GPS datum away from dock.")
            if self.launch_navsat is not None:
                try:
                    self.launch_navsat.shutdown()
                    rospy.loginfo("[navi_transform] navsat_transform stopped — will relaunch on next init_navsat() call")
                except Exception as e:
                    rospy.logwarn(f"[navi_transform] Error stopping navsat: {e}")
                self.launch_navsat = None
            else:
                rospy.loginfo("[navi_transform] navsat_transform was not running — will launch fresh on GPS ready")

    # ---- persistent site georeference (POSE_DATUM_PLAN phase 1b) ------------
    def _load_site_datum(self):
        """(Re)load the site datum captured by mapping v3 into a synthetic
        map_coords PoseStamped. Returns silently when absent/unchanged."""
        try:
            path = os.path.realpath(self._site_datum_file)
            mtime = os.path.getmtime(path)
        except OSError:
            return
        if mtime == self._site_datum_mtime:
            return
        try:
            with open(path) as f:
                d = yaml.safe_load(f)
            ps = PoseStamped()
            ps.header.frame_id = 'utm'
            ps.pose.position.x = float(d['utm_e'])
            ps.pose.position.y = float(d['utm_n'])
            ps.pose.position.z = float(d.get('alt', 0.0))
            q = quaternion_from_euler(0, 0, float(d.get('yaw_rad', 0.0)))
            ps.pose.orientation.x = q[0]
            ps.pose.orientation.y = q[1]
            ps.pose.orientation.z = q[2]
            ps.pose.orientation.w = q[3]
            self._site_datum = ps
            self._site_datum_mtime = mtime
            rospy.logwarn('[navi_transform] site datum loaded from %s: '
                          'utm=(%.2f, %.2f) alt=%.2f yaw=%.2fdeg',
                          path, ps.pose.position.x, ps.pose.position.y,
                          ps.pose.position.z,
                          math.degrees(float(d.get('yaw_rad', 0.0))))
        except Exception as e:
            rospy.logwarn('[navi_transform] site datum load failed: %s', e)

    def maybe_apply_site_datum(self):
        """Called at 1 Hz (loop1hz): when no LIVE nonzero map_coords georef
        exists but a site datum does, feed the datum through the normal
        georef path so GPS can own map->odom without a loaded navi map."""
        self._load_site_datum()
        if self._site_datum is None:
            return
        if rospy.get_time() - self._map_coords_rx_t < self._datum_live_window_s:
            return                    # live navi-map georef owns it
        self.callback_map_coords(self._site_datum, from_datum=True)

    def callback_map_coords(self, msg, from_datum=False):
        # GPS georef may own map->odom ONLY while the GPS position is USABLE and
        # has been stable for a few seconds. Without this gate, once navsat has
        # ever established utm->odom, every map_coords message re-pinned map->odom
        # from a possibly bad/multipath datum even with gps_good=0 — overwriting
        # the GPS-denied external corrections (rtabmap bridge /nav_tf/set_map_pose)
        # — and RTK flapping (observed 38 flips/2 min in rain) toggled ownership
        # and yanked the pose around ("caught one GPS -> thrown elsewhere").
        zero = (msg.pose.position.x + msg.pose.position.y
                + msg.pose.position.z) == 0
        if not from_datum and not zero:
            self._map_coords_rx_t = rospy.get_time()
        if zero:
            # Never derive a georef from a zero/null message (its yaw comes
            # from a null quaternion). Pose stays with dock/odometry until a
            # real georef or the site datum takes over.
            self.map_coords_msg = msg
            return
        if not self._gps_stable():
            self.map_coords_msg = msg
            return
        # ENGAGE-FAST ARBITRATION (2026-07-12, correctness-first): the EDT tracker
        # now activates the moment the RAW fix is unusable (fix_usable==0), i.e.
        # during the ~8 s outage grace where _gps_stable() is still TRUE. If the
        # georef kept re-pinning map->odom here on the STALE/frozen datum during
        # that window, it would fight the tracker's set_map_pose_tracker slew (both
        # write self.map_odom_transform + map_odom_yaw). Yield the georef the
        # instant the fix goes unusable — GPS owns map->odom ONLY with a live fix,
        # the tracker owns the grace window. Symmetric with the tracker's gate;
        # this is what makes "GPS set_pose owns when stable" literally true.
        if not self.position_fix_usable:
            self.map_coords_msg = msg
            return
        trans = None
        try:
            trans = self.tf2_Buffer.lookup_transform('utm', 'odom', rospy.Time(0))
        except:
            trans = None

        if trans is not None:
            map_roll, map_pitch, map_yaw = euler_from_quaternion(
                [msg.pose.orientation.x, msg.pose.orientation.y, msg.pose.orientation.z, msg.pose.orientation.w])
            odom_roll, odom_pitch, odom_yaw = euler_from_quaternion([trans.transform.rotation.x,
                                                                     trans.transform.rotation.y,
                                                                     trans.transform.rotation.z,
                                                                     trans.transform.rotation.w])
            yaw_offset = odom_yaw - map_yaw
            quaternion = quaternion_from_euler(map_roll, map_pitch, yaw_offset)

            p_x = 0
            p_y = 0
            p_z = 0

            if (msg.pose.position.x + msg.pose.position.y + msg.pose.position.z) != 0:
                p_x = trans.transform.translation.x - msg.pose.position.x
                p_y = trans.transform.translation.y - msg.pose.position.y
                p_z = trans.transform.translation.z - msg.pose.position.z

            rospy.loginfo_throttle(5,
                f"[map->odom] utm_odom=({trans.transform.translation.x:.3f}, {trans.transform.translation.y:.3f}) "
                f"utm_map=({msg.pose.position.x:.3f}, {msg.pose.position.y:.3f}) "
                f"map_odom=({p_x:.3f}, {p_y:.3f}) "
                f"yaw_diff={math.degrees(yaw_offset):.2f}deg "
                f"navsat_running={self.launch_navsat is not None}")

            # SLEW toward the georef target instead of snapping (POSE_DATUM_PLAN
            # phase 3): with the site-datum path this callback runs at ~1 Hz,
            # so a snap here re-pinned map->odom visibly. Rate-limit the
            # translation approach; only a kidnap-size mismatch snaps.
            now_g = rospy.get_time()
            cur = self.map_odom_transform.transform.translation
            d_x, d_y, d_z = p_x - cur.x, p_y - cur.y, p_z - cur.z
            dist_g = math.hypot(d_x, d_y)
            first = self._georef_last_t is None
            if not first and dist_g <= self._georef_kidnap_m:
                dt_g = min(now_g - self._georef_last_t, 3.0)
                max_step = self._georef_slew_mps * max(dt_g, 0.1)
                if dist_g > max_step:
                    s = max_step / dist_g
                    p_x, p_y, p_z = cur.x + d_x * s, cur.y + d_y * s, cur.z + d_z * s
            elif not first:
                rospy.logwarn('[map->odom] georef mismatch %.2f m > kidnap '
                              '%.2f m — snapping', dist_g, self._georef_kidnap_m)
            self._georef_last_t = now_g

            map_odom_transform = TransformStamped()
            map_odom_transform.header.stamp = rospy.Time.now()
            map_odom_transform.header.frame_id = "map"
            map_odom_transform.child_frame_id = "odom"
            map_odom_transform.transform.translation.x = p_x
            map_odom_transform.transform.translation.y = p_y
            map_odom_transform.transform.translation.z = p_z
            map_odom_transform.transform.rotation.x = quaternion[0]
            map_odom_transform.transform.rotation.y = quaternion[1]
            map_odom_transform.transform.rotation.z = quaternion[2]
            map_odom_transform.transform.rotation.w = quaternion[3]

            self.map_odom_transform = map_odom_transform
            # GPS georef owns map->odom again -> drop the GPS-denied yaw correction
            # (its translation math above assumes the identity-rotation broadcast).
            self.map_odom_yaw = 0.0
        self.map_coords_msg = msg

    def callback_base_odom(self, msg):
        self.base_odom_msg = msg

    def callback_ekf_wheel_odom(self, msg):
        self.ekf_wheel_odom_msg = msg

    def callback_ekf_wheel_nav_odom(self, msg):
        self.ekf_wheel_nav_odom_msg = msg


    def callback_wheel_odom(self, msg):
        self.wheel_odom_msg = msg

    def callback_rtk_odom(self, msg):
        self.rtk_odom_msg = msg
        self._rtk_odom_rx_t = rospy.get_time()
        self.rtk_odom_heading_msg = copy.deepcopy(msg)
        self.rtk_odom_heading_msg.pose.pose.orientation = self.fused_msg.orientation


    # ===== vitulus_ui Phase 1: shadow bridge preview (Step A) =================
    # Purpose: validate, WITHOUT touching the live pose, whether visual odometry
    # (/vo/odom) and/or lidar ICP odometry (/licp/odom) can bridge GPS-denied
    # stretches better than wheel/IMU alone. Each source is confidence-gated
    # (covariance + freshness + hysteresis, mirroring the GPS fix_usable logic).
    # While GPS is usable the preview pose is anchored to the live fused pose;
    # while GPS is denied it dead-reckons using the best available gated source.
    # Output: /nav_tf/odom_bridge_preview (Odometry) and /nav_tf/bridge_status.
    def bridge_init_state(self):
        self._src = {
            'vo':    {'x': 0.0, 'y': 0.0, 'yaw': 0.0, 'cov': 1e9, 't': 0.0, 'have': False, 'ref': None, 'good': 0},
            'licp':  {'x': 0.0, 'y': 0.0, 'yaw': 0.0, 'cov': 1e9, 't': 0.0, 'have': False, 'ref': None, 'good': 0},
            'wheel': {'x': 0.0, 'y': 0.0, 'yaw': 0.0, 'cov': 0.0, 't': 0.0, 'have': False, 'ref': None, 'good': 0},
        }
        self._bridge = {'x': 0.0, 'y': 0.0, 'yaw': 0.0, 'init': False}
        self._bridge_active = 'none'
        # WP2 (localization v2): bridge gates -> ~params, defaults UNCHANGED.
        self._bridge_cov_thresh = float(rospy.get_param('~bridge/cov_thresh', 1.0))  # m^2; rtabmap inflates pose cov when tracking is lost
        self._bridge_fresh_s = float(rospy.get_param('~bridge/fresh_s', 0.5))        # a source older than this is considered stale
        self._bridge_hyst = int(rospy.get_param('~bridge/hyst', 3))                  # consecutive good samples before a source is trusted
        # Per-cycle deltas above these are reset/glitch jumps -> rejected. The
        # bridge integrates at 30 Hz and the robot tops out ~0.5 m/s (~0.017
        # m/cycle), so 0.08 m leaves a generous margin yet caps a stuck-glitch
        # accumulation at ~0.08*30*3s ≈ 7 m instead of the 0.3 m clamp's ~27 m
        # (the observed 26.7 m spike). 0.3 m allowed an absurd 9 m/s.
        self._bridge_max_step = float(rospy.get_param('~bridge/max_step_m', 0.08))  # m; reject larger single-cycle deltas (reset/glitch jumps)
        self._bridge_max_yaw = float(rospy.get_param('~bridge/max_yaw_rad', 0.3))   # rad; same, for rotation
        # Wheel cross-check (Step B layer 1): a VO/lidar source is only trusted
        # if its per-cycle motion is not WILDLY more than the wheels'. Asymmetric
        # and generous (mult=3 + 5cm) so normal wheel slip is tolerated but gross
        # runaway glitches (e.g. the observed 7 m jump) are rejected.
        self._bridge_xcheck_mult = float(rospy.get_param('~bridge/wheel_xcheck_mult', 3.0))
        self._bridge_xcheck_abs = float(rospy.get_param('~bridge/wheel_xcheck_abs_m', 0.05))  # m
        # FIX2 (telemfix 2026-07-11): creeping-yaw / frame-reset containment.
        # (a) Accumulated-divergence guard: track |bridge - wheel-EKF-delta pose|
        #     over the dropout; when it exceeds ~bridge/max_accum_div_m the bridge
        #     has drifted (source yaw crept, e.g. licp -152deg->+30deg while parked)
        #     -> RESET the bridge to the wheel-EKF-based estimate. Validated on the
        #     t=586-611 window: unguarded div 2.64 m -> capped 1.00 m.
        # (b) Frame-reset blackout: a source msg whose pose jumps >2 m or lands ~at
        #     origin after a nonzero pose is a frame RESET (VO@586.6, licp@605-611
        #     flipped origin<->pose every ~0.3 s) -> force that source unusable for
        #     ~bridge/reset_blackout_s so a teleport delta cannot enter the bridge.
        self._bridge_max_accum_div = float(rospy.get_param('~bridge/max_accum_div_m', 1.0))  # m
        self._bridge_reset_blackout_s = float(rospy.get_param('~bridge/reset_blackout_s', 3.0))
        self._bridge_reset_jump_m = float(rospy.get_param('~bridge/reset_jump_m', 2.0))  # m
        # BLACKOUT CAP (2026-07-11, review finding): the original blackout
        # RE-TRIGGERED on every reset-signature message, so a licp episode with
        # repeated resets renewed the blackout indefinitely (bag: licp blacked
        # out 17% of runtime, longest contiguous 25.9 s at t=605-628) —
        # degrading the bridge to wheel-DR, its primary source (licp = 80% of
        # denied time) gone. Make the blackout EDGE-TRIGGERED with a cap: a
        # reset signature starts/extends the blackout only up to
        # ~bridge/reset_blackout_max_s within a rolling episode; past the cap the
        # source becomes usable again (its per-cycle clamps + the accum-div guard
        # still contain it), and a NEW blackout may only start after the source
        # has been reset-free for ~bridge/reset_clear_s.
        self._bridge_reset_blackout_max_s = float(rospy.get_param('~bridge/reset_blackout_max_s', 6.0))
        self._bridge_reset_clear_s = float(rospy.get_param('~bridge/reset_clear_s', 5.0))
        # per-source frame-reset blackout expiry (wall time); anchor at the moment
        # the bridge last (re)anchored, for the accumulated-divergence measure.
        self._src_reset_until = {'vo': 0.0, 'licp': 0.0}
        # BLACKOUT-CAP episode state (per source): _ep_start = wall time the
        # current reset episode began (None between episodes); _ep_capped = the
        # cap has already been hit this episode (blackout no longer extends);
        # _last_reset_t = wall time of the last reset signature (episode ends,
        # and a fresh one may start, once this is >_bridge_reset_clear_s old).
        self._src_reset_ep_start = {'vo': None, 'licp': None}
        self._src_reset_ep_capped = {'vo': False, 'licp': False}
        self._src_last_reset_t = {'vo': 0.0, 'licp': 0.0}
        self._bridge_wheel_anchor = None   # (bx,by,byaw, wheel_x,wheel_y, theta) at (re)anchor
        # Phase 1 go-live: when True and GPS is denied, drive the LIVE pose from
        # the bridge (VO/lidar dead-reckon) instead of letting the EKF drift on
        # wheels. Default OFF for safety (dock/undock + startup run on known-good
        # wheel odom); enable per-drive via param or /nav_tf/bridge_live_enable.
        self._bridge_live_enable = rospy.get_param('~bridge/live_enable', False)

    @staticmethod
    def _odom_xyyaw(msg):
        q = msg.pose.pose.orientation
        (_, _, yaw) = euler_from_quaternion([q.x, q.y, q.z, q.w])
        return msg.pose.pose.position.x, msg.pose.pose.position.y, yaw

    @staticmethod
    def _wrap(a):
        while a > math.pi:
            a -= 2 * math.pi
        while a < -math.pi:
            a += 2 * math.pi
        return a

    def _store_src(self, key, msg):
        try:
            x, y, yaw = self._odom_xyyaw(msg)
            if not (math.isfinite(x) and math.isfinite(y) and math.isfinite(yaw)):
                return
            s = self._src[key]
            # FIX2 (telemfix): frame-RESET signature on this source message —
            # a pose jump > reset_jump_m, or landing ~at origin after a nonzero
            # pose (VO/licp teleport their odom frame origin on re-init). Force
            # the source unusable for ~reset_blackout_s so the teleport delta
            # never enters the bridge integration.
            # BLACKOUT CAP (2026-07-11): edge-triggered episode. Each reset
            # signature extends the blackout only while the episode's total span
            # is under ~reset_blackout_max_s; once capped the source becomes
            # usable again (clamps + accum-div guard contain it). A reset-free
            # gap of ~reset_clear_s ends the episode so a genuinely NEW reset
            # burst can arm a fresh blackout.
            if key in self._src_reset_until and s.get('have'):
                jump = math.hypot(x - s['x'], y - s['y'])
                near_origin = (math.hypot(x, y) < 0.05
                               and math.hypot(s['x'], s['y']) > 0.5)
                if jump > self._bridge_reset_jump_m or near_origin:
                    now_r = rospy.Time.now().to_sec()
                    # end a stale episode: reset-free for longer than clear_s
                    if (self._src_reset_ep_start[key] is None
                            or now_r - self._src_last_reset_t[key]
                            > self._bridge_reset_clear_s):
                        self._src_reset_ep_start[key] = now_r
                        self._src_reset_ep_capped[key] = False
                    self._src_last_reset_t[key] = now_r
                    ep_span = now_r - self._src_reset_ep_start[key]
                    if ep_span < self._bridge_reset_blackout_max_s:
                        # still within the cap — (re)arm/extend the blackout, but
                        # never let it push the source unusable past the cap end.
                        cap_end = (self._src_reset_ep_start[key]
                                   + self._bridge_reset_blackout_max_s)
                        self._src_reset_until[key] = min(
                            now_r + self._bridge_reset_blackout_s, cap_end)
                        rospy.logwarn_throttle(
                            3.0, "[bridge] source '%s' frame-reset (jump=%.2fm%s) — "
                            "blackout (episode %.1f/%.1fs cap)", key, jump,
                            ", origin" if near_origin else "",
                            ep_span, self._bridge_reset_blackout_max_s)
                    elif not self._src_reset_ep_capped[key]:
                        self._src_reset_ep_capped[key] = True
                        rospy.logwarn_throttle(
                            3.0, "[bridge] source '%s' frame-reset blackout CAP "
                            "%.1fs reached (episode still resetting) — source "
                            "usable again, accum-div guard now containing",
                            key, self._bridge_reset_blackout_max_s)
            s['x'], s['y'], s['yaw'] = x, y, yaw
            s['cov'] = msg.pose.covariance[0]
            s['t'] = rospy.Time.now().to_sec()
            s['have'] = True
        except Exception:
            pass

    def callback_vo_odom(self, msg):
        self._store_src('vo', msg)

    def callback_licp_odom(self, msg):
        self._store_src('licp', msg)

    def _src_usable(self, key, now):
        s = self._src[key]
        fresh = s['have'] and (now - s['t']) < self._bridge_fresh_s
        quality = True if key == 'wheel' else (s['cov'] < self._bridge_cov_thresh)
        # FIX2 (telemfix): a source under a frame-reset blackout is unusable.
        if key in self._src_reset_until and now < self._src_reset_until[key]:
            quality = False
        if fresh and quality:
            s['good'] = min(s['good'] + 1, self._bridge_hyst)
        else:
            s['good'] = 0
        return s['good'] >= self._bridge_hyst

    def _step_dist(self, key):
        """Per-cycle translation distance of a source (since last reference)."""
        s = self._src[key]
        if s['ref'] is None:
            return None
        return math.hypot(s['x'] - s['ref'][0], s['y'] - s['ref'][1])

    def _wheel_consistent(self, key):
        """Reject a source whose per-cycle motion runs away far beyond the wheels'
        (glitch protection). Asymmetric: a source moving LESS than wheels is fine."""
        wd = self._step_dist('wheel')
        sd = self._step_dist(key)
        if sd is None:
            return True            # source just (re)initialised; nothing to check yet
        if wd is None:
            # No wheel reference to compare against (e.g. right after an anchor
            # reset) — exactly when odometry-frame teleports/glitches strike. Fail
            # SAFE: trust only tiny motion instead of bypassing the check (the old
            # `return True` here let the 26.7 m glitch through).
            return sd <= self._bridge_xcheck_abs
        return sd <= self._bridge_xcheck_mult * wd + self._bridge_xcheck_abs

    def _bridge_reanchor_wheel(self, bx, by, byaw):
        """FIX2 (telemfix): capture the accumulated-divergence anchor — the
        bridge pose and the correction-free wheel-EKF pose (+ the map<-wheel yaw
        offset) at the instant the bridge is (re)anchored. The guard rotates the
        wheel-EKF delta since this anchor into the map frame and compares."""
        wp = self.ekf_wheel_odom_msg.pose.pose
        wq = wp.orientation
        wyaw = euler_from_quaternion([wq.x, wq.y, wq.z, wq.w])[2]
        theta = math.atan2(math.sin(byaw - wyaw), math.cos(byaw - wyaw))
        self._bridge_wheel_anchor = (bx, by, wp.position.x, wp.position.y, theta)

    def _bridge_accum_guard(self):
        """FIX2 (telemfix): if the bridge has diverged from the wheel-EKF-delta
        estimate by more than ~bridge/max_accum_div_m, reset it to that estimate.
        The wheel EKF is never set_pose'd (correction-free) and its heading drift
        over a short dropout is small, so it is a valid referee for a source whose
        yaw is creeping (licp). Silent no-op when there is no anchor yet."""
        a = self._bridge_wheel_anchor
        if a is None:
            return
        bx0, by0, wx0, wy0, theta = a
        wp = self.ekf_wheel_odom_msg.pose.pose.position
        ct, st = math.cos(theta), math.sin(theta)
        ex = bx0 + (ct * (wp.x - wx0) - st * (wp.y - wy0))
        ey = by0 + (st * (wp.x - wx0) + ct * (wp.y - wy0))
        div = math.hypot(self._bridge['x'] - ex, self._bridge['y'] - ey)
        if div > self._bridge_max_accum_div:
            rospy.logwarn_throttle(
                3.0, "[bridge] accumulated divergence %.2fm > %.2fm — resetting "
                "to wheel-EKF estimate (source yaw crept)",
                div, self._bridge_max_accum_div)
            self._bridge['x'], self._bridge['y'] = ex, ey
            # keep the current bridge yaw; the wheel-EKF heading is the reference
            # only for position runaway. Re-anchor so divergence restarts from 0.
            self._bridge_reanchor_wheel(ex, ey, self._bridge['yaw'])

    def update_bridge_preview(self):
        now = rospy.Time.now().to_sec()
        # keep the wheel source fresh from the live wheel odom message
        if self.wheel_odom_msg is not None and self.wheel_odom_msg.header.stamp.to_sec() > 0:
            self._store_src('wheel', self.wheel_odom_msg)

        usable = {k: self._src_usable(k, now) for k in self._src}
        cur = {k: (s['x'], s['y'], s['yaw']) for k, s in self._src.items()}
        # Phase-2 decouple: the live pose now re-anchors on RTK position alone, so
        # the shadow bridge mirrors that (denied = real position dropout, not a
        # heading flap). Keeps shadow div_from_live meaningful vs the live pose.
        gps_good = bool(self.position_fix_usable)

        if gps_good or not self._bridge['init']:
            # anchor the preview to the live fused pose; reset all references
            bx, by, byaw = self._odom_xyyaw(self.base_odom_msg)
            self._bridge.update({'x': bx, 'y': by, 'yaw': byaw, 'init': True})
            self._bridge_active = 'gps' if gps_good else 'init'
            self._bridge_reanchor_wheel(bx, by, byaw)   # FIX2 divergence anchor
        else:
            # GPS denied -> dead-reckon with the best gated source
            # (lowest-covariance visual/lidar; wheel/IMU as last resort)
            cands = [k for k in ('vo', 'licp') if usable[k] and self._wheel_consistent(k)]
            active = min(cands, key=lambda k: self._src[k]['cov']) if cands else 'wheel'
            self._bridge_active = active
            s = self._src[active]
            ref = s['ref']
            if ref is not None:
                dx, dy, dyaw = s['x'] - ref[0], s['y'] - ref[1], self._wrap(s['yaw'] - ref[2])
                # Reject implausibly large single-cycle jumps. With auto-reset on,
                # an odometry source teleports its frame to a new origin when it
                # re-initialises; that shows up as a huge one-cycle delta. At 30 Hz
                # even fast driving is < ~0.1 m/cycle, so anything beyond the clamp
                # is a reset/glitch -> skip it (the reference is still refreshed
                # below, so normal integration resumes next cycle).
                if math.hypot(dx, dy) <= self._bridge_max_step and abs(dyaw) <= self._bridge_max_yaw:
                    c, sn = math.cos(-ref[2]), math.sin(-ref[2])
                    lx, ly = c * dx - sn * dy, sn * dx + c * dy
                    bc, bs = math.cos(self._bridge['yaw']), math.sin(self._bridge['yaw'])
                    self._bridge['x'] += bc * lx - bs * ly
                    self._bridge['y'] += bs * lx + bc * ly
                    self._bridge['yaw'] = self._wrap(self._bridge['yaw'] + dyaw)
            # FIX2 (telemfix): accumulated-divergence guard. A creeping source
            # yaw (licp -152deg->+30deg while parked) walks the bridge away with
            # no single-cycle jump the clamp above can catch. Compare the bridge
            # to the correction-free wheel-EKF delta (rotated into the map frame
            # at re-anchor); when the accumulated divergence exceeds
            # ~bridge/max_accum_div_m, RESET the bridge to that wheel-based
            # estimate. Validated on t=586-611: unguarded 2.64 m -> capped 1.00 m.
            self._bridge_accum_guard()

        # advance every source's reference to current so source switching is seamless
        for k, s in self._src.items():
            s['ref'] = cur[k]

        self._publish_bridge(usable, gps_good)

    def _publish_bridge(self, usable, gps_good):
        out = Odometry()
        out.header.stamp = rospy.Time.now()
        out.header.frame_id = "odom"
        out.child_frame_id = "base_link_bridge"
        out.pose.pose.position.x = self._bridge['x']
        out.pose.pose.position.y = self._bridge['y']
        q = quaternion_from_euler(0, 0, self._bridge['yaw'])
        out.pose.pose.orientation.x, out.pose.pose.orientation.y = q[0], q[1]
        out.pose.pose.orientation.z, out.pose.pose.orientation.w = q[2], q[3]
        self.bridge_preview_pub.publish(out)
        try:
            lx, ly, _ = self._odom_xyyaw(self.base_odom_msg)
            div = math.hypot(self._bridge['x'] - lx, self._bridge['y'] - ly)
        except Exception:
            div = float('nan')
        live = (not gps_good) and self._bridge_live_enable and self._bridge.get('init') \
            and self._bridge_active in ('vo', 'licp')
        # WP2 (localization v2): the PUBLISHED gps_good is now the actual
        # pose-ownership predicate _gps_stable() (docked/probation/hysteresis/
        # heading), NOT the raw position_fix_usable that anchors the shadow
        # bridge internally. Downstream (dock bridge, gloc tracker) gate on
        # 'gps_good=1' and must follow ownership, not raw fix usability — so
        # they correctly run during GPS probation and at the dock. The raw fix
        # usability is exposed as fix_usable=0/1 for observability. The rest of
        # the string format (incl. live/active/div/vo/licp/wheel) is unchanged.
        gps_stable = self._gps_stable()
        st = ("gps_good=%d fix_usable=%d live=%d active=%s div_from_live=%.3fm | vo[use=%d cov=%.3g] "
              "licp[use=%d cov=%.3g] wheel[use=%d]" % (
                  int(gps_stable), int(gps_good), int(live), self._bridge_active, div,
                  int(usable['vo']), self._src['vo']['cov'],
                  int(usable['licp']), self._src['licp']['cov'],
                  int(usable['wheel'])))
        self.bridge_status_pub.publish(String(data=st))

    def publish_loc_status(self):
        """WP2 (localization v2): typed pose-ownership status (JSON, latched, 1 Hz).
        Replaces string-parsing /nav_tf/bridge_status for downstream consumers.
        owner: 'gps' when _gps_stable(); else 'dock' when docked; else the
        highest-priority set_map_pose source heard within ~map_pose_hold_s; else
        'dr' (dead-reckoning). rtabmap_confident is OBSERVABILITY only (no
        behavioral coupling)."""
        try:
            gps_stable = self._gps_stable()
            now_s = rospy.get_time()
            # recently-heard set_map_pose sources (age within the hold window)
            sources = {}
            fresh_src = None
            for s in self._map_pose_priority:   # already in priority order
                age = now_s - self._map_pose_last_accept.get(s, 0.0)
                if age < self._map_pose_hold_s:
                    sources[s] = {'age_s': round(age, 2)}
                    if fresh_src is None:
                        fresh_src = s
            if gps_stable:
                owner = 'gps'
            elif self._docked:
                owner = 'dock'
            elif fresh_src is not None:
                owner = fresh_src
            else:
                owner = 'dr'
            # FIX3 (telemfix): anchor observability. anchor_age_s = seconds since
            # the verified anchor last advanced (None until the first advance);
            # anchor_frozen = it has been frozen past ~anchor_frozen_warn_s while
            # GPS owns the pose (pose running open-loop on the wheel EKF).
            anchor_age = None
            anchor_frozen = False
            if self._anchor_last_advance_t is not None:
                anchor_age = round(now_s - self._anchor_last_advance_t, 2)
                anchor_frozen = bool(gps_stable
                                     and anchor_age > self._anchor_frozen_warn_s)
            status = {
                'owner': owner,
                'gps_good': bool(gps_stable),
                'fix_usable': bool(self.position_fix_usable),
                'heading_ok': bool(self._heading_ok()),
                'docked': bool(self._docked),
                'probation_proven': bool(self._gps_proven),
                'rtabmap_confident': bool(self._rtabmap_confident),
                'anchor_age_s': anchor_age,
                'anchor_frozen': anchor_frozen,
                'map_pose_sources': sources,
                'drift_report': self._drift_report,
            }
            self._last_published_owner = owner    # FIX4: keep edge detector in sync
            self.loc_status_pub.publish(String(data=json.dumps(status)))
        except Exception as e:
            rospy.logwarn_throttle(10.0, "[loc_status] %s" % e)

    def _current_owner(self):
        """FIX4 (telemfix): owner predicate for edge detection — identical logic
        to publish_loc_status (gps > dock > freshest map_pose source > dr)."""
        if self._gps_stable():
            return 'gps'
        if self._docked:
            return 'dock'
        now_s = rospy.get_time()
        for s in self._map_pose_priority:   # priority order
            if now_s - self._map_pose_last_accept.get(s, 0.0) < self._map_pose_hold_s:
                return s
        return 'dr'

    def maybe_publish_owner_edge(self):
        """FIX4 (telemfix): publish loc_status IMMEDIATELY on an owner-change edge
        (baseline 1 Hz stays; called every loop3sec tick where ownership settles).
        A transition is thus visible at once instead of up to ~1 s late."""
        try:
            if self._current_owner() != self._last_published_owner:
                self.publish_loc_status()
        except Exception as e:
            rospy.logwarn_throttle(10.0, "[loc_status_edge] %s" % e)

    def callback_bridge_live_enable(self, msg):
        self._bridge_live_enable = bool(msg.data)
        rospy.logwarn("[bridge] live bridging %s" % ("ENABLED" if msg.data else "DISABLED"))

    def set_bridge_live_pose(self):
        """Drive the live pose from the bridge during a GPS dropout. Position from
        the bridge dead-reckon (VO/lidar), orientation from the IMU-fused heading
        (continuous) — mirroring the RTK correction in set_wheel_base_nav_pose,
        just with the bridge position instead of RTK. Same EKF set_pose service."""
        try:
            pose_srv = SetPoseRequest()
            pose_srv.pose.pose.pose.position.x = self._bridge['x']
            pose_srv.pose.pose.pose.position.y = self._bridge['y']
            pose_srv.pose.pose.pose.position.z = 0.0
            pose_srv.pose.pose.pose.orientation.x = self.fused_msg.orientation.x
            pose_srv.pose.pose.pose.orientation.y = self.fused_msg.orientation.y
            pose_srv.pose.pose.pose.orientation.z = self.fused_msg.orientation.z
            pose_srv.pose.pose.pose.orientation.w = self.fused_msg.orientation.w
            pose_srv.pose.header.frame_id = 'odom'
            pose_srv.pose.header.stamp = rospy.Time.now()
            srv = rospy.ServiceProxy('/ekf_wheel_nav_odometry/set_pose', SetPose)
            srv(pose_srv)
        except rospy.ServiceException as e:
            rospy.logerr("set_bridge_live_pose set_pose failed: %s" % e)
